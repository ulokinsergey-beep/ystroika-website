# Нормализуем переводы строк для всего репозитория
* text=auto

# Astro и web-файлы — LF
*.astro text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.svg text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Бинарные файлы — без обработки
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.zip binary
