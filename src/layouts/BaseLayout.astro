---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormSuccessToast from '../components/FormSuccessToast.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = 'Кровельные и фасадные материалы в Москве и МО. Широкий ассортимент, гарантия лучшей цены, бесплатная доставка.',
  image = '/og-image.jpg',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <!-- Google Fonts: Inter (основной) + Montserrat (заголовки) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Montserrat:wght@600;700;900&display=swap" rel="stylesheet" />

    <!-- SEO -->
    <title>{title} | У-Стройка</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={`${title} | У-Стройка`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:locale" content="ru_RU" />

    <!-- Yandex -->
    <meta name="yandex-verification" content="" />

    <!-- JSON-LD и доп. теги конкретной страницы -->
    <slot name="head" />
  </head>
  <body class="bg-white text-slate-900 antialiased overflow-x-clip">
    <!-- Figma-canvas auto-scale: 1920px design canvas scales to actual viewport on desktop -->
    <div id="figma-canvas" class="flex flex-col min-h-screen">
      <Header />
      <main class="flex-1">
        <slot />
      </main>
      <Footer />
    </div>
    <FormSuccessToast />

    <script is:inline>
      (function () {
        var DESIGN_W = 1920;
        var BREAKPOINT = 1024;
        var canvas = document.getElementById('figma-canvas');
        if (!canvas) return;

        function fit() {
          var vw = document.documentElement.clientWidth || window.innerWidth;
          if (vw >= BREAKPOINT) {
            // Reset for measurement
            canvas.style.transform = '';
            canvas.style.width = DESIGN_W + 'px';
            // Measure natural height while at 1920px width
            var naturalH = canvas.offsetHeight;
            // Apply scale
            var s = vw / DESIGN_W;
            canvas.style.transformOrigin = 'top left';
            canvas.style.transform = 'scale(' + s + ')';
            // Compensate body height so scrollbar is correct
            document.body.style.height = (naturalH * s) + 'px';
            document.body.style.width = vw + 'px';
          } else {
            // Mobile: no transform, normal flow
            canvas.style.transform = '';
            canvas.style.width = '';
            document.body.style.height = '';
            document.body.style.width = '';
          }
        }

        var raf = null;
        function scheduleFit() {
          if (raf) cancelAnimationFrame(raf);
          raf = requestAnimationFrame(fit);
        }

        // Initial fit
        fit();

        // Re-fit on resize, load, font-load, image-load
        window.addEventListener('resize', scheduleFit, { passive: true });
        window.addEventListener('load', fit);
        if (document.fonts && document.fonts.ready) {
          document.fonts.ready.then(fit);
        }

        // Re-fit when canvas content changes (images loading, etc.)
        if (window.ResizeObserver) {
          var ro = new ResizeObserver(function () {
            // Only re-measure if at desktop
            var vw = document.documentElement.clientWidth || window.innerWidth;
            if (vw >= BREAKPOINT) scheduleFit();
          });
          ro.observe(canvas);
        }

        // Re-fit after all images load
        var imgs = canvas.querySelectorAll('img');
        imgs.forEach(function (img) {
          if (!img.complete) {
            img.addEventListener('load', scheduleFit, { once: true });
            img.addEventListener('error', scheduleFit, { once: true });
          }
        });
      })();
    </script>
  </body>
</html>
