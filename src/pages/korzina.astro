---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Корзина" description="Ваша корзина — У-Стройка. Оформите заказ кровельных и фасадных материалов с доставкой за 1 день.">
  <!-- Заголовок -->
  <section class="bg-white px-4 sm:px-8 lg:px-[60px]" style="padding-top:60px;padding-bottom:30px;">
    <nav class="text-[14px] text-[#898989] mb-[20px]">
      <a href="/" class="hover:text-[#FFAE01]">Главная</a> <span class="mx-[8px]">/</span>
      <span class="text-[#333333]">Корзина</span>
    </nav>
    <div class="flex items-end gap-[25px]">
      <h1 class="font-[Montserrat] font-semibold text-[28px] lg:text-[42px] text-[#333333] leading-[1.22] flex-shrink-0">Корзина</h1>
      <div class="flex-1 bg-[#E9E9E9]" style="height:1.5px;margin-bottom:14px;"></div>
    </div>
  </section>

  <!-- Пустая корзина -->
  <section id="cart-empty" class="bg-white px-4 sm:px-8 lg:px-[60px]" style="padding-bottom:80px;">
    <div class="flex flex-col items-center justify-center text-center gap-5 bg-[#F5F5F5] rounded-[5px]" style="padding:80px 24px;">
      <svg class="w-16 h-16 text-[#d0d0d0]" fill="none" stroke="currentColor" stroke-width="1.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
      <h2 class="font-[Montserrat] font-semibold text-[#333333] text-[22px]">Корзина пуста</h2>
      <p class="text-[#898989] text-[16px] leading-[1.5]" style="max-width:480px;">Добавляйте товары кнопкой «В&nbsp;корзину» в&nbsp;каталоге — здесь появится список заказа и&nbsp;итоговая сумма.</p>
      <a href="/catalog" class="inline-flex items-center justify-center bg-[#FFAE01] hover:bg-[#e09d00] text-[#333333] font-semibold text-[16px] rounded-[5px] transition-colors" style="height:50px;padding:0 40px;">Перейти в&nbsp;каталог</a>
    </div>
  </section>

  <!-- Корзина с товарами -->
  <section id="cart-full" class="hidden bg-white px-4 sm:px-8 lg:px-[60px]" style="padding-bottom:80px;">
    <div class="flex flex-col lg:flex-row gap-[20px] items-start">
      <!-- Список товаров -->
      <div class="flex-1 w-full">
        <div id="cart-items" class="flex flex-col gap-[12px]"></div>
        <div class="flex flex-wrap items-center gap-5 mt-5">
          <button id="cart-clear" class="text-[#898989] text-sm hover:text-[#C51212] transition-colors flex items-center gap-1.5">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
            Очистить корзину
          </button>
          <a href="/catalog" class="text-[#FFAE01] text-sm font-semibold hover:opacity-80 transition-opacity">← Вернуться в каталог</a>
        </div>
      </div>

      <!-- Сумма заказов -->
      <div class="lg:w-[360px] flex-shrink-0 w-full bg-[#F5F5F5] rounded-[5px]" style="padding:30px;">
        <h2 class="font-[Montserrat] font-semibold text-[#333333] text-[20px] mb-5">Сумма заказов</h2>
        <div class="flex items-center justify-between py-2 border-b border-[#E9E9E9] text-[15px]">
          <span class="text-[#898989]">Всего товаров</span><span id="cart-count" class="text-[#333333] font-semibold">0</span>
        </div>
        <div class="flex items-center justify-between py-3 text-[16px]">
          <span class="text-[#898989]">Общая стоимость</span><span id="cart-total" class="text-[#333333] font-bold text-[22px]">—</span>
        </div>
        <p id="cart-price-note" class="text-[#898989] text-[12px] mb-4 hidden">Часть цен уточняется — менеджер пришлёт точную сумму.</p>
        <form class="flex flex-col gap-3">
          <input type="tel" name="phone" required placeholder="Ваш телефон *" class="h-[50px] px-4 bg-white rounded-[5px] text-[16px] text-[#333333] border border-[#E9E9E9] focus:outline-none focus:ring-2 focus:ring-[#FFAE01]" />
          <button type="submit" class="bg-[#FFAE01] hover:bg-[#e09d00] text-[#333333] font-semibold text-[16px] rounded-[5px] transition-colors" style="height:50px;">Оформить заказ</button>
        </form>
        <a href="tel:88003339495" class="block text-center text-[#898989] text-sm mt-4 hover:text-[#333333] transition-colors">или позвоните 8-800-333-94-95</a>
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      var KEY = 'ystroika-cart';
      function read() { try { return JSON.parse(localStorage.getItem(KEY) || '[]'); } catch (e) { return []; } }
      function write(items) { try { localStorage.setItem(KEY, JSON.stringify(items)); } catch (e) {} }

      var empty = document.getElementById('cart-empty');
      var full = document.getElementById('cart-full');
      var list = document.getElementById('cart-items');
      var countEl = document.getElementById('cart-count');
      var totalEl = document.getElementById('cart-total');
      var noteEl = document.getElementById('cart-price-note');
      var prices = {};

      function fmt(n) { return n.toLocaleString('ru-RU') + ' ₽'; }

      function recalc() {
        var items = read();
        var count = 0, total = 0, missing = false;
        items.forEach(function (it) {
          count += it.qty || 1;
          var p = prices[it.kod];
          if (p && p > 0) total += p * (it.qty || 1); else missing = true;
        });
        if (countEl) countEl.textContent = String(count);
        if (totalEl) totalEl.textContent = total > 0 ? fmt(total) : 'по запросу';
        if (noteEl) noteEl.classList.toggle('hidden', !(missing && total > 0));
      }

      function render() {
        var items = read();
        if (!items.length) { if (empty) empty.classList.remove('hidden'); if (full) full.classList.add('hidden'); return; }
        if (empty) empty.classList.add('hidden');
        if (full) full.classList.remove('hidden');
        list.innerHTML = items.map(function (it, i) {
          var pr = prices[it.kod];
          var priceTxt = pr && pr > 0 ? fmt(pr) + (it.unit ? '/' + it.unit : '') : 'Цена по запросу';
          return '<div class="flex items-center gap-4 bg-white border border-[#E9E9E9] rounded-[5px] p-4" data-i="' + i + '">' +
            '<div class="w-[80px] h-[80px] bg-[#F5F5F5] rounded-[3px] flex items-center justify-center flex-shrink-0"><svg class="w-8 h-8 text-[#d0d0d0]" fill="none" stroke="currentColor" stroke-width="1" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg></div>' +
            '<div class="flex-1 min-w-0"><a href="' + (it.url || '#') + '" class="text-[14px] text-[#333333] font-medium hover:text-[#FFAE01] line-clamp-2 block">' + (it.name || it.kod) + '</a>' +
            '<div class="text-[13px] text-[#898989] mt-1">' + priceTxt + '</div></div>' +
            '<div class="flex items-center border border-[#E9E9E9] rounded-[3px] overflow-hidden flex-shrink-0">' +
            '<button class="cart-minus w-8 h-8 text-[#333333] hover:bg-[#F5F5F5]">−</button>' +
            '<span class="cart-qty w-9 h-8 flex items-center justify-center text-sm">' + (it.qty || 1) + '</span>' +
            '<button class="cart-plus w-8 h-8 text-[#333333] hover:bg-[#F5F5F5]">+</button></div>' +
            '<button class="cart-remove w-8 h-8 flex items-center justify-center text-[#898989] hover:text-[#C51212] flex-shrink-0" aria-label="Удалить">×</button>' +
            '</div>';
        }).join('');
        bind();
        recalc();
      }

      function bind() {
        list.querySelectorAll('[data-i]').forEach(function (row) {
          var i = +row.getAttribute('data-i');
          row.querySelector('.cart-minus').addEventListener('click', function () { var it = read(); it[i].qty = Math.max(1, (it[i].qty || 1) - 1); write(it); render(); });
          row.querySelector('.cart-plus').addEventListener('click', function () { var it = read(); it[i].qty = (it[i].qty || 1) + 1; write(it); render(); });
          row.querySelector('.cart-remove').addEventListener('click', function () { var it = read(); it.splice(i, 1); write(it); render(); });
        });
      }

      document.getElementById('cart-clear')?.addEventListener('click', function () { write([]); render(); });

      // Подгрузка цен
      var items = read();
      var kods = items.map(function (i) { return i.kod; }).filter(Boolean);
      if (kods.length) {
        fetch('/api/catalog/prices', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ kods: kods }) })
          .then(function (r) { return r.ok ? r.json() : { prices: {} }; })
          .then(function (d) { prices = d.prices || {}; recalc(); render(); })
          .catch(function () {});
      }
      render();
    })();
  </script>
</BaseLayout>
