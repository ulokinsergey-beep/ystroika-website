---
import BaseLayout from '../layouts/BaseLayout.astro';
import CategoryCard from '../components/catalog/CategoryCard.astro';
import { categories } from '../data/categories';
---

<BaseLayout
  title="Кровельные и фасадные материалы"
  description="Широкий выбор кровельных и фасадных материалов в Москве и МО. Металлочерепица, гибкая черепица, сайдинг, водосток. Гарантия лучшей цены."
>
  <!-- Hero -->
  <section class="bg-slate-900 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
      <div class="max-w-3xl">
        <h1 class="text-4xl lg:text-5xl font-bold leading-tight">
          Кровельные и фасадные<br />
          <span class="text-orange-500">материалы в Москве</span>
        </h1>
        <p class="mt-5 text-lg text-slate-300 leading-relaxed">
          Широкий ассортимент от ведущих производителей. Быстрая доставка по Москве и МО.
          Гарантия лучшей цены — вернём разницу, если найдёте дешевле.
        </p>
        <div class="mt-8 flex flex-col sm:flex-row gap-4">
          <a
            href="/catalog"
            class="inline-flex items-center justify-center bg-orange-500 hover:bg-orange-600 text-white font-semibold px-6 py-3 rounded-lg transition-colors"
          >
            Перейти в каталог
          </a>
          <a
            href="tel:+74951234567"
            class="inline-flex items-center justify-center border border-slate-600 hover:border-slate-400 text-white font-semibold px-6 py-3 rounded-lg transition-colors"
          >
            +7 (495) 123-45-67
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- USPs -->
  <section class="border-b border-slate-200 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 text-center">
        {[
          { value: 'Гарантия лучшей цены', label: 'Вернём разницу если найдёте дешевле' },
          { value: 'Доставка за 1 день', label: 'По Москве и МО' },
          { value: '10+ лет', label: 'На рынке строительных материалов' },
          { value: 'Бесплатный замер', label: 'Рассчитаем количество материала' },
        ].map(item => (
          <div class="py-2">
            <p class="text-base font-bold text-slate-900">{item.value}</p>
            <p class="mt-1 text-sm text-slate-500">{item.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Catalog categories -->
  <section class="py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl lg:text-3xl font-bold text-slate-900">Каталог материалов</h2>
      <p class="mt-2 text-slate-500">Выберите раздел для просмотра ассортимента</p>

      <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {categories.map(cat => (
          <CategoryCard
            slug={cat.slug}
            title={cat.title}
            description={cat.description}
            icon={cat.icon}
            subcategoriesCount={cat.subcategories?.length ?? 0}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Brands -->
  <section class="py-14 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-slate-900 text-center">Работаем с ведущими брендами</h2>
      <div class="mt-8 flex flex-wrap justify-center gap-6 text-slate-500 font-medium text-lg">
        {['GrandLine', 'DÖCKE', 'Металл Профиль', 'ТЕХНОНИКОЛЬ', 'АльтаПрофиль', 'Stynergy', 'Katepal', 'Metrotile'].map(brand => (
          <span class="px-4 py-2 border border-slate-200 rounded-lg text-base text-slate-600">
            {brand}
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-orange-500 text-white py-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl lg:text-3xl font-bold">Нужна помощь с выбором?</h2>
      <p class="mt-3 text-orange-100 text-lg">
        Наши специалисты помогут подобрать материал под ваш проект и бюджет
      </p>
      <a
        href="tel:+74951234567"
        class="mt-6 inline-flex items-center bg-white text-orange-600 font-bold px-8 py-3 rounded-lg hover:bg-orange-50 transition-colors"
      >
        Позвонить: +7 (495) 123-45-67
      </a>
    </div>
  </section>
</BaseLayout>
