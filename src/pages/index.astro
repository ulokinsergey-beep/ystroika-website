---
// TODO: сверить все секции с Figma «Главная страница» когда сбросится rate limit
import BaseLayout from '../layouts/BaseLayout.astro';
import CategoryCard from '../components/catalog/CategoryCard.astro';
import { categories } from '../data/categories';

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["Organization", "LocalBusiness", "HomeGoodsStore"],
      "@id": "https://ystroika.ru/#organization",
      "name": "У-Стройка",
      "url": "https://ystroika.ru",
      "telephone": "+78003339495",
      "description": "Розничная продажа кровельных, фасадных материалов и комплектующих в Москве и МО. ~9 лет на рынке.",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Москва",
        "addressRegion": "Московская область",
        "addressCountry": "RU"
      },
      "areaServed": {
        "@type": "AdministrativeArea",
        "name": "Москва и Московская область"
      },
      "openingHoursSpecification": {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"],
        "opens": "09:00",
        "closes": "20:00"
      },
      "priceRange": "₽₽",
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Кровельные и фасадные материалы"
      }
    },
    {
      "@type": "WebSite",
      "@id": "https://ystroika.ru/#website",
      "url": "https://ystroika.ru",
      "name": "У-Стройка",
      "publisher": { "@id": "https://ystroika.ru/#organization" },
      "inLanguage": "ru-RU"
    }
  ]
};

const advantages = [
  {
    icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>`,
    title: 'Гарантия лучшей цены',
    text: 'Если найдёте дешевле у конкурента — вернём разницу. Работаем с лучшими поставщиками напрямую.',
  },
  {
    icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>`,
    title: 'Широкий ассортимент',
    text: 'Металлочерепица, гибкая черепица, сайдинг, водостоки, утеплители — всё в наличии со склада в Москве.',
  },
  {
    icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>`,
    title: 'Доставка за 1 день',
    text: 'Доставляем по Москве и МО. Собственный автопарк — без посредников и задержек.',
  },
  {
    icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>`,
    title: 'Опытные специалисты',
    text: '9 лет на рынке. Поможем с расчётом, подбором и монтажом. Бесплатный выезд замерщика.',
  },
];

const services = [
  {
    num: '01',
    title: 'Рассчитаем материал',
    text: 'Бесплатный расчёт по вашим замерам или выезд специалиста. Точный расход без переплат.',
  },
  {
    num: '02',
    title: 'Доставим на объект',
    text: 'Доставка по Москве и МО — на следующий день. Разгрузка механизированная.',
  },
  {
    num: '03',
    title: 'Выполним монтаж',
    text: 'Собственная бригада монтажников. Гарантия на работы 3 года. Договор и чек.',
  },
];

const brands = ['GrandLine', 'DÖCKE', 'Металл Профиль', 'ТЕХНОНИКОЛЬ', 'АльтаПрофиль', 'Stynergy', 'Katepal', 'Metrotile'];

const reviews = [
  {
    name: 'Алексей К.',
    city: 'Москва',
    text: 'Заменил кровлю на металлочерепицу GrandLine. Всё привезли в срок, качество отличное. Менеджер помог с расчётом — не пришлось переплачивать за лишний материал.',
    rating: 5,
  },
  {
    name: 'Игорь Н.',
    city: 'Подольск',
    text: 'Брал сайдинг DÖCKE для обшивки дома. Цены ниже, чем в строительных магазинах, доставили на следующий день. Рекомендую.',
    rating: 5,
  },
  {
    name: 'Светлана М.',
    city: 'Красногорск',
    text: 'Обратились за расчётом водосточной системы. Специалист приехал, обмерил, подобрал всё с учётом конфигурации крыши. Остались довольны.',
    rating: 5,
  },
];
---

<BaseLayout
  title="Кровельные и фасадные материалы в Москве"
  description="Купить кровельные и фасадные материалы в Москве и МО. Металлочерепица, гибкая черепица, сайдинг, водосток. Доставка 1 день. Гарантия лучшей цены. Звоните: 8-800-333-94-95."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <!-- ========== HERO ========== -->
  <section class="relative bg-slate-900 text-white overflow-hidden">
    <!-- Фоновый паттерн -->
    <div class="absolute inset-0 opacity-5">
      <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
            <path d="M 40 0 L 0 0 0 40" fill="none" stroke="white" stroke-width="1"/>
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#grid)" />
      </svg>
    </div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
      <div class="max-w-2xl">
        <!-- Бейдж -->
        <div class="inline-flex items-center gap-2 bg-orange-500/20 border border-orange-500/30 text-orange-400 text-sm font-medium px-3 py-1.5 rounded-full mb-6">
          <span class="w-1.5 h-1.5 bg-orange-400 rounded-full"></span>
          9 лет на рынке · Москва и МО
        </div>

        <h1 class="text-4xl lg:text-5xl xl:text-6xl font-bold leading-tight tracking-tight">
          Кровельные<br class="hidden sm:block" /> и фасадные<br />
          <span class="text-orange-500">материалы</span>
        </h1>

        <p class="mt-5 text-lg text-slate-300 leading-relaxed max-w-xl">
          Полный ассортимент от ведущих производителей со склада в Москве.
          Доставка за 1 день. Гарантия лучшей цены.
        </p>

        <div class="mt-8 flex flex-col sm:flex-row gap-3">
          <a
            href="/catalog"
            class="inline-flex items-center justify-center gap-2 bg-orange-500 hover:bg-orange-600 active:bg-orange-700 text-white font-semibold px-7 py-3.5 rounded-xl transition-colors text-base"
          >
            Перейти в каталог
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </a>
          <a
            href="tel:88003339495"
            class="inline-flex items-center justify-center gap-2 border border-slate-600 hover:border-orange-500 hover:text-orange-400 text-white font-semibold px-7 py-3.5 rounded-xl transition-colors text-base"
          >
            <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            8-800-333-94-95
          </a>
        </div>

        <!-- Социальные доказательства -->
        <div class="mt-10 flex flex-wrap gap-6 text-sm text-slate-400">
          <div class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-orange-500" fill="currentColor" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
            </svg>
            <span>4.9 из 5 по отзывам</span>
          </div>
          <div class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
            </svg>
            <span>1 000+ довольных клиентов</span>
          </div>
          <div class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <span>Ответим за 15 минут</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== TRUST BAR ========== -->
  <section class="bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-5">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 lg:gap-8">
        {[
          { value: 'Гарантия', label: 'лучшей цены' },
          { value: 'Доставка', label: 'за 1 день по МО' },
          { value: '9 лет', label: 'на рынке' },
          { value: 'Бесплатно', label: 'расчёт и замер' },
        ].map(item => (
          <div class="flex items-center gap-3 py-2">
            <div class="w-2 h-2 bg-orange-500 rounded-full shrink-0"></div>
            <div>
              <p class="text-sm font-bold text-slate-900 leading-tight">{item.value}</p>
              <p class="text-xs text-slate-500 leading-tight">{item.label}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ========== CATALOG ========== -->
  <section class="py-16 bg-slate-50" id="catalog">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8">
        <div>
          <h2 class="text-2xl lg:text-3xl font-bold text-slate-900">Каталог материалов</h2>
          <p class="mt-1.5 text-slate-500">8 разделов · Металл, пластик, мягкая кровля</p>
        </div>
        <a
          href="/catalog"
          class="shrink-0 text-sm font-semibold text-orange-500 hover:text-orange-600 flex items-center gap-1 transition-colors"
        >
          Весь каталог
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {categories.map(cat => (
          <CategoryCard
            slug={cat.slug}
            title={cat.title}
            description={cat.description}
            icon={cat.icon}
            subcategoriesCount={cat.subcategories?.length ?? 0}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- ========== КАК МЫ РАБОТАЕМ ========== -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-2xl lg:text-3xl font-bold text-slate-900">Как мы работаем</h2>
        <p class="mt-2 text-slate-500 max-w-xl mx-auto">
          От звонка до готовой кровли — берём весь процесс на себя
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
        {services.map((s, i) => (
          <div class="relative bg-slate-50 rounded-2xl p-6 lg:p-8">
            <div class="text-6xl font-black text-slate-100 absolute top-4 right-6 select-none leading-none">
              {s.num}
            </div>
            <div class="relative">
              <div class="w-10 h-10 bg-orange-500 rounded-xl flex items-center justify-center text-white font-bold mb-4">
                {i + 1}
              </div>
              <h3 class="text-lg font-semibold text-slate-900">{s.title}</h3>
              <p class="mt-2 text-sm text-slate-500 leading-relaxed">{s.text}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="mt-8 text-center">
        <a
          href="tel:88003339495"
          class="inline-flex items-center gap-2 bg-orange-500 hover:bg-orange-600 text-white font-semibold px-7 py-3 rounded-xl transition-colors"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          Заказать расчёт бесплатно
        </a>
        <p class="mt-2 text-xs text-slate-400">Звонок бесплатный по России</p>
      </div>
    </div>
  </section>

  <!-- ========== ПРЕИМУЩЕСТВА ========== -->
  <section class="py-16 bg-slate-900 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-2xl lg:text-3xl font-bold">Почему выбирают У-Стройку</h2>
        <p class="mt-2 text-slate-400">4 причины работать с нами</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {advantages.map(adv => (
          <div class="group p-6 rounded-2xl border border-slate-800 hover:border-orange-500/50 hover:bg-slate-800/50 transition-all duration-200">
            <div class="text-orange-500 mb-4" set:html={adv.icon} />
            <h3 class="font-semibold text-white">{adv.title}</h3>
            <p class="mt-2 text-sm text-slate-400 leading-relaxed">{adv.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ========== БРЕНДЫ ========== -->
  <section class="py-14 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-xl font-bold text-slate-900 text-center mb-8">
        Официальные дистрибьюторы ведущих производителей
      </h2>
      <div class="flex flex-wrap justify-center gap-3">
        {brands.map(brand => (
          <a
            href={`/catalog?brand=${brand.toLowerCase().replace(' ', '-')}`}
            class="px-5 py-2.5 border border-slate-200 rounded-xl text-sm font-medium text-slate-600 hover:border-orange-400 hover:text-orange-500 hover:bg-orange-50 transition-all duration-150"
          >
            {brand}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ========== ОТЗЫВЫ ========== -->
  <section class="py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-10">
        <div>
          <h2 class="text-2xl lg:text-3xl font-bold text-slate-900">Отзывы клиентов</h2>
          <p class="mt-1.5 text-slate-500">Более 100 отзывов за 9 лет работы</p>
        </div>
        <a href="/otzyvy" class="shrink-0 text-sm font-semibold text-orange-500 hover:text-orange-600 flex items-center gap-1">
          Все отзывы
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {reviews.map(r => (
          <div class="bg-white rounded-2xl p-6 border border-slate-100 shadow-sm">
            <!-- Звёзды -->
            <div class="flex gap-0.5 mb-4">
              {Array.from({length: r.rating}).map(() => (
                <svg class="w-4 h-4 text-orange-400" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
              ))}
            </div>
            <p class="text-sm text-slate-700 leading-relaxed">"{r.text}"</p>
            <div class="mt-4 flex items-center gap-2">
              <div class="w-8 h-8 bg-slate-200 rounded-full flex items-center justify-center text-xs font-bold text-slate-600">
                {r.name.charAt(0)}
              </div>
              <div>
                <p class="text-sm font-semibold text-slate-900">{r.name}</p>
                <p class="text-xs text-slate-400">{r.city}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ========== CTA ========== -->
  <section class="bg-orange-500 text-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col lg:flex-row items-center justify-between gap-8">
        <div class="text-center lg:text-left">
          <h2 class="text-2xl lg:text-3xl font-bold">Нужна помощь с выбором?</h2>
          <p class="mt-2 text-orange-100 text-lg max-w-lg">
            Позвоните или напишите — специалист подберёт материал под ваш проект и бюджет.
            Звонок бесплатный.
          </p>
        </div>
        <div class="flex flex-col sm:flex-row gap-3 shrink-0">
          <a
            href="tel:88003339495"
            class="inline-flex items-center justify-center gap-2 bg-white text-orange-600 font-bold px-8 py-3.5 rounded-xl hover:bg-orange-50 transition-colors text-base"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            8-800-333-94-95
          </a>
          <a
            href="/catalog"
            class="inline-flex items-center justify-center bg-orange-600 hover:bg-orange-700 border border-white/20 text-white font-semibold px-8 py-3.5 rounded-xl transition-colors text-base"
          >
            Перейти в каталог
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
