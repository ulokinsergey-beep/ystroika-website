---
import BaseLayout from '../layouts/BaseLayout.astro';
import CategoryCard from '../components/catalog/CategoryCard.astro';
import Quiz from '../components/Quiz.astro';
import { categories } from '../data/categories';

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["Organization", "LocalBusiness", "HomeGoodsStore"],
      "@id": "https://y-stroika.ru/#organization",
      "name": "У-Стройка",
      "url": "https://y-stroika.ru",
      "telephone": "+78003339495",
      "description": "Розничная продажа кровельных, фасадных материалов и комплектующих в Москве и МО. ~9 лет на рынке.",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Москва",
        "addressRegion": "Московская область",
        "addressCountry": "RU"
      },
      "areaServed": {
        "@type": "AdministrativeArea",
        "name": "Москва и Московская область"
      },
      "openingHoursSpecification": {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"],
        "opens": "09:00",
        "closes": "20:00"
      },
      "priceRange": "₽₽",
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Кровельные и фасадные материалы"
      }
    },
    {
      "@type": "WebSite",
      "@id": "https://y-stroika.ru/#website",
      "url": "https://y-stroika.ru",
      "name": "У-Стройка",
      "publisher": { "@id": "https://y-stroika.ru/#organization" },
      "inLanguage": "ru-RU"
    }
  ]
};

// Placeholder data arrays removed — replaced by inline Figma-accurate sections below
---

<BaseLayout
  title="Кровельные и фасадные материалы в Москве"
  description="Купить кровельные и фасадные материалы в Москве и МО. Металлочерепица, гибкая черепица, сайдинг, водосток. Доставка 1 день. Гарантия лучшей цены. Звоните: 8-800-333-94-95."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <!-- ========== 1 ЭКРАН: HERO + ФОРМА (Figma 136:671) ========== -->
  <!-- Figma 136:671: 1920×903px, bg White. Banner 136:672: 1177×620 at x:59,y:283 bg #464646. Form 136:692: 564×620 at x:1295,y:283 bg #F5F5F5. Gap=60px. -->
  <section class="bg-white px-4 sm:px-8 lg:px-[60px]" style="padding-top:60px;">
    <div class="flex flex-col lg:flex-row gap-[60px] items-stretch">

      <!-- HERO CARD: Figma 136:672, bg #464646, radius 5px, 1177×620 -->
      <div class="flex-1 relative bg-[#464646] rounded-[5px] overflow-hidden" style="min-height:420px;" id="hero-card">
        <!-- Desktop: explicit 620px height -->
        <style>@media (min-width:1024px){#hero-card{height:620px;}}</style>

        <!-- Ellipse 64: Figma Orange circle at x:880,y:156, size 397×389 -->
        <div class="absolute rounded-full bg-[#FFAE01] pointer-events-none hidden lg:block"
             style="width:397px;height:389px;left:880px;top:156px;"></div>

        <!-- Building image: Figma 136:683 at x:429,y:176, size 871×581 -->
        <img src="/images/hero-building.png" alt="" class="absolute pointer-events-none object-cover hidden lg:block"
             style="left:429px;top:176px;width:871px;height:581px;" />

        <!-- Info block: Figma 136:673, column gap:20px, at x:91,y:71 -->
        <div class="lg:absolute flex flex-col gap-[20px] z-10 p-6 lg:p-0 relative top-0 left-0"
             style="max-width:676px;"
             id="hero-info-block">
        <style>@media (min-width:1024px){#hero-info-block{position:absolute;left:91px;top:71px;}}</style>

          <!-- H1: Figma style H1 = Montserrat 600 52px lh 1.3, fills White, width:676px -->
          <p class="text-white font-[Montserrat] font-semibold text-[26px] lg:text-[52px] leading-[1.3]">
            За 2022 год сэкономили нашим клиентам
          </p>

          <!-- "более 7 млн ₽": Figma 136:675, Orange rect (418×71) + Inter 600 52px White -->
          <div class="relative inline-block">
            <div class="absolute inset-0 bg-[#FFAE01] rounded-[5px]"></div>
            <span class="relative text-white text-[26px] lg:text-[52px] font-semibold leading-[1.3] px-2 block">
              более 7 млн ₽
            </span>
          </div>

          <!-- Sub-text: Figma style_9CPIVH = Inter 500 16px lh 1.3, fills BG gray, w:486 -->
          <p class="text-[#F5F5F5] text-[16px] font-medium leading-[1.3]" style="max-width:486px;">
            Оптимизировали смету в каждом проекте в среднем на 19%
          </p>

          <!-- Button: Figma 136:679, row, 252×50, border White 1px, radius 5px, Inter 600 18px White -->
          <a href="/o-kompanii"
             class="inline-flex items-center justify-center gap-5 text-white text-[18px] font-semibold border border-white rounded-[5px] hover:bg-white/10 transition-colors"
             style="width:252px;height:50px;">
            Узнать подробнее
            <svg width="11" height="11" fill="none" stroke="white" stroke-width="1.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
            </svg>
          </a>
        </div>

        <!-- Slider dots: Figma 136:684, 5 dots row gap:8, at x:91,y:557. Active=3rd orange -->
        <div class="absolute hidden lg:flex items-center gap-[8px]" style="left:91px;top:557px;">
          <div class="w-[10px] h-[10px] rounded-full bg-white/40"></div>
          <div class="w-[10px] h-[10px] rounded-full bg-white/40"></div>
          <div class="w-[10px] h-[10px] rounded-full bg-[#FFAE01]"></div>
          <div class="w-[10px] h-[10px] rounded-full bg-white/40"></div>
          <div class="w-[10px] h-[10px] rounded-full bg-white/40"></div>
        </div>
      </div>

      <!-- FORM CARD: Figma 136:692, bg #F5F5F5, radius 5px, 564×620 -->
      <!-- layout: column, justifyContent:center, alignItems:center, gap:35px -->
      <div class="lg:w-[564px] lg:flex-shrink-0 bg-[#F5F5F5] rounded-[5px] flex flex-col justify-center"
           style="padding:0 41px;gap:35px;min-height:320px;"
           id="form-card">
        <style>@media (min-width:1024px){#form-card{height:620px;}}</style>

        <!-- Heading: Figma 136:694, column gap:20px -->
        <div class="flex flex-col gap-[20px]">
          <!-- H3: Montserrat 600 24px lh 1.3, Black, w:482×62 -->
          <h2 class="font-[Montserrat] font-semibold text-[20px] lg:text-[24px] leading-[1.3] text-[#333333]"
              style="max-width:482px;">
            Быстрый предварительный расчет стоимости материалов
          </h2>
          <!-- Body text: Inter 400 16px lh 1.3, Black, w:482 -->
          <p class="text-[#333333] text-[16px] leading-[1.3]" style="max-width:482px;">
            Получите предварительный расчет стоимости кровли под ваш объект с точностью 99%
          </p>
        </div>

        <!-- Inputs: Figma 136:697 — площадь (+ calc icon) / материал (select) / производитель (select) -->
        <form id="hero-calc-form" class="flex flex-col gap-[15px]">

          <!-- "Введите площадь" + orange circle calc icon (Figma: input with icon at right) -->
          <div class="relative">
            <input type="text" name="area" placeholder="Введите площадь"
                   class="h-[58px] pl-[20px] pr-[68px] w-full bg-white rounded-[5px] text-[16px] text-[#333333] placeholder:text-[#898989] border-0 focus:outline-none focus:ring-2 focus:ring-[#FFAE01]" />
            <!-- Orange circle button with % icon -->
            <button type="button" aria-label="Калькулятор"
                    class="absolute right-[10px] top-1/2 -translate-y-1/2 w-[38px] h-[38px] rounded-full bg-[#FFAE01] flex items-center justify-center flex-shrink-0 hover:bg-[#E09800] transition-colors">
              <span class="text-[#333333] font-bold text-[16px] leading-none">%</span>
            </button>
          </div>

          <!-- "Выберите материал" dropdown -->
          <div class="relative">
            <select name="material"
                    class="h-[58px] px-[20px] w-full bg-white rounded-[5px] text-[16px] text-[#898989] border-0 focus:outline-none focus:ring-2 focus:ring-[#FFAE01] appearance-none cursor-pointer">
              <option value="" disabled selected>Выберите материал</option>
              <option value="metallocherepitsa">Металлочерепица</option>
              <option value="gibkaya-cherepitsa">Гибкая черепица</option>
              <option value="profnastil">Профнастил</option>
              <option value="faltsevaya">Фальцевая кровля</option>
              <option value="sayding">Сайдинг</option>
            </select>
            <svg class="absolute right-[18px] top-1/2 -translate-y-1/2 pointer-events-none" width="14" height="8" fill="none" viewBox="0 0 14 8">
              <path d="M1 1l6 6 6-6" stroke="#898989" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>

          <!-- "Выберите производителя" dropdown -->
          <div class="relative">
            <select name="manufacturer"
                    class="h-[58px] px-[20px] w-full bg-white rounded-[5px] text-[16px] text-[#898989] border-0 focus:outline-none focus:ring-2 focus:ring-[#FFAE01] appearance-none cursor-pointer">
              <option value="" disabled selected>Выберите производителя</option>
              <option value="grandline">GrandLine</option>
              <option value="docke">DÖCKE</option>
              <option value="texnonikolb">ТЕХНОНИКОЛЬ</option>
              <option value="metalloprofil">Металл Профиль</option>
              <option value="stynergy">Stynergy</option>
            </select>
            <svg class="absolute right-[18px] top-1/2 -translate-y-1/2 pointer-events-none" width="14" height="8" fill="none" viewBox="0 0 14 8">
              <path d="M1 1l6 6 6-6" stroke="#898989" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>

          <!-- Button: Figma 136:713, 482×50, bg Orange, radius 5px, Inter 600 18px Black -->
          <button type="submit"
                  class="h-[50px] bg-[#FFAE01] hover:bg-[#e09d00] text-[#333333] font-semibold text-[18px] rounded-[5px] transition-colors"
                  style="width:100%;">
            Получить расчет
          </button>
        </form>
      </div>
    </div>
  </section>

  <!-- ========== АКЦИИ (Figma 136:659) ========== -->
  <!-- Figma: frame 1950×140 at x:60,y:1013 on page. SIDE-BY-SIDE: heading (x:0 w:1053) + banner (x:1113 w:837). Gap=60px. -->
  <section class="bg-white px-4 sm:px-8 lg:px-[60px] pt-[60px] pb-[60px]">
    <div class="flex flex-col lg:flex-row lg:items-center gap-[30px] lg:gap-[60px]">

      <!-- Heading: Figma 136:660, Montserrat 600 52px lh 1.3, Black, w:1053 -->
      <h1 class="flex-1 font-[Montserrat] font-semibold text-[26px] sm:text-[36px] lg:text-[52px] text-[#333333] leading-[1.3]">
        Интернет-магазин кровельных и&nbsp;фасадных материалов в&nbsp;Москве
      </h1>

      <!-- Banner: Figma 136:661, bg #333333, radius 5px, 837×140, overflow hidden -->
      <div class="relative bg-[#333333] rounded-[5px] overflow-hidden flex-shrink-0 w-full h-[120px] lg:w-[837px] lg:h-[140px]"
           id="aktsii-banner">

        <!-- % decoration: Figma 136:662, Montserrat 900 300px, Orange, at x:561 y:-95 (overflows top) -->
        <span class="absolute font-[Montserrat] font-black text-[#FFAE01] leading-none select-none pointer-events-none hidden lg:block"
              style="font-size:300px;left:561px;top:-95px;line-height:1.22;">%</span>

        <!-- House image: Figma 136:670, at x:324 y:-35, 286×293 (overflows top) -->
        <img src="/images/aktsii-house.png" alt="" class="absolute pointer-events-none hidden lg:block"
             style="left:324px;top:-35px;width:286px;height:293px;object-fit:contain;" />

        <!-- Info: Figma 136:663, column gap:8, at x:32,y:23 -->
        <div class="absolute flex flex-col gap-[8px] p-4 lg:p-0" style="left:32px;top:23px;">
          <!-- "У нас весна...": Montserrat 600 24px lh 1.3, fills BG gray, w:356 -->
          <p class="font-[Montserrat] font-semibold text-[16px] lg:text-[24px] text-[#F5F5F5] leading-[1.3]"
             style="max-width:356px;">
            У нас весна и открытие строительного сезона
          </p>
          <!-- Row: "Бери по выгодной цене!" (Inter 400 14px) + arrow button (30×30, Orange) -->
          <div class="flex items-center justify-between" style="width:222px;">
            <p class="text-[#F5F5F5] text-[14px] leading-[1.3]">Бери по выгодной цене!</p>
            <a href="/spetspredlozheniya"
               class="flex items-center justify-center bg-[#FFAE01] rounded-[5px] hover:opacity-80 transition-opacity"
               style="width:30px;height:30px;">
              <svg width="8" height="12" fill="none" stroke="#333333" stroke-width="2.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== 2 ЭКРАН: КАТЕГОРИИ (Figma 136:601) ========== -->
  <!-- Figma: column gap:50, Заголовок (row gap:25, "Категории" H2 42px + Line) + 3 ряда карточек -->
  <!-- Row 1: 587×250 ×3, Row 2: 680/600/482×250, Row 3: 890×250 ×2 (1 highlighted) -->
  <section class="bg-white px-4 sm:px-8 lg:px-[60px] pt-[40px] pb-[80px]">

    <!-- Заголовок: Figma 136:602, row align flex-end gap:25 -->
    <div class="flex items-end gap-[25px] mb-[50px]">
      <h2 class="font-[Montserrat] font-semibold text-[28px] lg:text-[42px] text-[#333333] leading-[1.22] flex-shrink-0">
        Категории
      </h2>
      <!-- Figma: Line 1537×1.5px, Light gray #E9E9E9 -->
      <div class="flex-1 h-px bg-[#E9E9E9]" style="margin-bottom:8px;"></div>
    </div>

    <!-- 3 ряда категорий: Figma 136:605, column gap:20 -->
    <div class="flex flex-col gap-[20px]">

      <!-- РЯД 1: Фасад / Кровля / Профнастил — каждая 587×250 (на 1920) -->
      <div class="flex flex-col lg:flex-row gap-[20px]">
        <!-- Card 1: Фасад -->
        <a href="/catalog/fasad" class="group relative block bg-[#333333] rounded-[5px] overflow-hidden flex-1 lg:flex-[587]"
           style="height:250px;">
          <img src="/images/categories/fasad.png" alt="" class="absolute inset-0 w-full h-full object-cover" />
          <div class="absolute bg-white rounded-[5px] flex items-center justify-between"
               style="left:29px;top:168px;width:300px;height:50px;padding:0 20px;">
            <span class="text-[#333333] font-semibold text-[18px]">Фасад</span>
            <span class="flex items-center justify-center w-[30px] h-[30px] border border-[#333333] rounded-[5px] group-hover:bg-[#333333] transition-colors">
              <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" class="text-[#333333] group-hover:text-white"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
            </span>
          </div>
        </a>
        <!-- Card 2: Кровля -->
        <a href="/catalog/krovlya" class="group relative block bg-[#333333] rounded-[5px] overflow-hidden flex-1 lg:flex-[587]"
           style="height:250px;">
          <img src="/images/categories/krovlya.png" alt="" class="absolute inset-0 w-full h-full object-cover" />
          <div class="absolute bg-white rounded-[5px] flex items-center justify-between"
               style="left:29px;top:168px;width:300px;height:50px;padding:0 20px;">
            <span class="text-[#333333] font-semibold text-[18px]">Кровля</span>
            <span class="flex items-center justify-center w-[30px] h-[30px] border border-[#333333] rounded-[5px] group-hover:bg-[#333333] transition-colors">
              <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" class="text-[#333333] group-hover:text-white"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
            </span>
          </div>
        </a>
        <!-- Card 3: Профнастил -->
        <a href="/catalog/profnastil" class="group relative block bg-[#333333] rounded-[5px] overflow-hidden flex-1 lg:flex-[587]"
           style="height:250px;">
          <img src="/images/categories/profnastil.png" alt="" class="absolute inset-0 w-full h-full object-cover" />
          <div class="absolute bg-white rounded-[5px] flex items-center justify-between"
               style="left:29px;top:168px;width:300px;height:50px;padding:0 20px;">
            <span class="text-[#333333] font-semibold text-[18px]">Профнастил</span>
            <span class="flex items-center justify-center w-[30px] h-[30px] border border-[#333333] rounded-[5px] group-hover:bg-[#333333] transition-colors">
              <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" class="text-[#333333] group-hover:text-white"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
            </span>
          </div>
        </a>
      </div>

      <!-- РЯД 2: Заборы (680) / Доборные (600) / Водосточные (482) -->
      <div class="flex flex-col lg:flex-row gap-[20px]">
        <a href="/catalog/zabory-ograzhdeniya" class="group relative block bg-[#333333] rounded-[5px] overflow-hidden flex-1 lg:flex-[680]"
           style="height:250px;">
          <img src="/images/categories/zabory.png" alt="" class="absolute inset-0 w-full h-full object-cover" />
          <div class="absolute bg-white rounded-[5px] flex items-center justify-between"
               style="left:29px;top:168px;width:300px;height:50px;padding:0 20px;">
            <span class="text-[#333333] font-semibold text-[18px]">Заборы и&nbsp;ограждения</span>
            <span class="flex items-center justify-center w-[30px] h-[30px] border border-[#333333] rounded-[5px] group-hover:bg-[#333333] transition-colors">
              <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" class="text-[#333333] group-hover:text-white"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
            </span>
          </div>
        </a>
        <a href="/catalog/dobornye-elementy" class="group relative block bg-[#333333] rounded-[5px] overflow-hidden flex-1 lg:flex-[600]"
           style="height:250px;">
          <img src="/images/categories/dobornye.png" alt="" class="absolute inset-0 w-full h-full object-cover" />
          <div class="absolute bg-white rounded-[5px] flex items-center justify-between"
               style="left:29px;top:168px;width:300px;height:50px;padding:0 20px;">
            <span class="text-[#333333] font-semibold text-[18px]">Доборные элементы</span>
            <span class="flex items-center justify-center w-[30px] h-[30px] border border-[#333333] rounded-[5px] group-hover:bg-[#333333] transition-colors">
              <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" class="text-[#333333] group-hover:text-white"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
            </span>
          </div>
        </a>
        <a href="/catalog/vodostochnye-sistemy" class="group relative block bg-[#333333] rounded-[5px] overflow-hidden flex-1 lg:flex-[482]"
           style="height:250px;">
          <img src="/images/categories/vodostok.png" alt="" class="absolute inset-0 w-full h-full object-cover" />
          <div class="absolute bg-white rounded-[5px] flex items-center justify-between"
               style="left:29px;top:168px;width:300px;height:50px;padding:0 20px;">
            <span class="text-[#333333] font-semibold text-[18px]">Водосточные системы</span>
            <span class="flex items-center justify-center w-[30px] h-[30px] border border-[#333333] rounded-[5px] group-hover:bg-[#333333] transition-colors">
              <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" class="text-[#333333] group-hover:text-white"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
            </span>
          </div>
        </a>
      </div>

      <!-- РЯД 3: Мансардные окна (890, ПОДСВЕЧЕНА Orange) / Другое (890) -->
      <div class="flex flex-col lg:flex-row gap-[20px]">
        <a href="/catalog/mansardnye-okna" class="group relative block bg-[#333333] rounded-[5px] overflow-hidden flex-1 lg:flex-[890]"
           style="height:250px;">
          <img src="/images/categories/mansardnye.png" alt="" class="absolute inset-0 w-full h-full object-cover" />
          <!-- ПОДСВЕЧЕННАЯ карточка: bg Black на name bar, текст Orange -->
          <div class="absolute bg-[#333333] rounded-[5px] flex items-center justify-between"
               style="left:29px;top:168px;width:300px;height:50px;padding:0 20px;">
            <span class="text-[#FFAE01] font-semibold text-[18px]">Мансардные окна</span>
            <span class="flex items-center justify-center w-[30px] h-[30px] border border-[#FFAE01] rounded-[5px] group-hover:bg-[#FFAE01] transition-colors">
              <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" class="text-[#FFAE01] group-hover:text-[#333333]"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
            </span>
          </div>
        </a>
        <a href="/catalog/drugoe" class="group relative block bg-[#333333] rounded-[5px] overflow-hidden flex-1 lg:flex-[890]"
           style="height:250px;">
          <img src="/images/categories/drugoe.png" alt="" class="absolute inset-0 w-full h-full object-cover" />
          <div class="absolute bg-white rounded-[5px] flex items-center justify-between"
               style="left:29px;top:168px;width:300px;height:50px;padding:0 20px;">
            <span class="text-[#333333] font-semibold text-[18px]">Другое</span>
            <span class="flex items-center justify-center w-[30px] h-[30px] border border-[#333333] rounded-[5px] group-hover:bg-[#333333] transition-colors">
              <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" class="text-[#333333] group-hover:text-white"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
            </span>
          </div>
        </a>
      </div>

