---
/**
 * Страница «Наши проекты» — /proekty
 * Контент: src/content/projects/ (из Bitrix IBLOCK 10)
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects', ({ data }) => data.published !== false);
const projects = allProjects.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
---

<BaseLayout
  title="Реализованные проекты — У-Стройка"
  description="Примеры выполненных работ по монтажу кровли, фасадов и водосточных систем в Москве и МО. Смотрите фотоотчёты наших проектов."
>
  <div class="bg-[#f5f5f5] min-h-screen">

    <!-- Шапка -->
    <div class="bg-white border-b border-[#e5e5e5]">
      <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-[60px] py-6">
        <nav class="flex flex-wrap items-center gap-1 text-sm text-[#898989] mb-4">
          <a href="/" class="hover:text-[#FFAE01] transition-colors">Главная</a>
          <svg class="w-3.5 h-3.5 text-[#d0d0d0]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          <span class="text-slate-900 font-medium">Проекты</span>
        </nav>
        <h1 class="text-2xl lg:text-[32px] font-bold text-slate-900">Наши проекты</h1>
        <p class="mt-2 text-[#898989]">{projects.length} реализованных объекта · Москва и МО</p>
      </div>
    </div>

    <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-[60px] py-8">

      <!-- Сетка проектов -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 mb-10">
        {projects.map((project) => (
          <a
            href={`/proekty/${project.id.replace(/\.mdx?$/, '')}`}
            class="group bg-white rounded-[10px] border border-[#e5e5e5] hover:border-[#FFAE01] hover:shadow-sm transition-all overflow-hidden"
          >
            <div class="h-44 bg-gradient-to-br from-[#f5f5f5] to-[#e0e0e0] flex items-center justify-center">
              <svg class="w-14 h-14 text-[#d0d0d0]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="0.75" d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/>
                <polyline points="9 22 9 12 15 12 15 22" stroke-width="0.75"/>
              </svg>
            </div>

            <div class="p-5">
              <h2 class="font-bold text-slate-900 group-hover:text-[#FFAE01] transition-colors leading-snug mb-2">
                {project.data.title}
              </h2>

              {project.data.description && (
                <p class="text-sm text-[#898989] line-clamp-2 leading-relaxed mb-3">{project.data.description}</p>
              )}

              <div class="flex flex-wrap gap-3 text-xs text-[#898989]">
                {project.data.location && (
                  <span class="flex items-center gap-1">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                    </svg>
                    {project.data.location}
                  </span>
                )}
                {project.data.completionDate && (
                  <span>{new Date(project.data.completionDate).getFullYear()} г.</span>
                )}
              </div>
            </div>
          </a>
        ))}
      </div>

      <!-- CTA -->
      <div class="bg-[#333333] text-white rounded-[10px] p-8 flex flex-col sm:flex-row items-center justify-between gap-6">
        <div>
          <h2 class="font-bold text-xl mb-2">Хотите также?</h2>
          <p class="text-[#898989] text-sm">Рассчитаем стоимость вашего проекта бесплатно</p>
        </div>
        <a
          href="/raschet"
          class="shrink-0 bg-[#FFAE01] hover:bg-[#e09d00] text-black font-semibold px-8 py-3 rounded-[5px] transition-colors whitespace-nowrap"
        >
          Получить расчёт
        </a>
      </div>

    </div>
  </div>
</BaseLayout>
