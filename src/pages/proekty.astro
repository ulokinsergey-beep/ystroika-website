---
/**
 * Страница «Наши проекты» — /proekty
 * Контент: src/content/projects/ (из Bitrix IBLOCK 10)
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects', ({ data }) => data.published !== false);
const projects = allProjects.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

const canonicalURL = 'https://ystroika.ru/proekty/';
---

<BaseLayout
  title="Реализованные проекты — У-Стройка"
  description="Примеры выполненных работ по монтажу кровли, фасадов и водосточных систем в Москве и МО. Смотрите фотоотчёты наших проектов."
>
  <div class="bg-slate-50 min-h-screen">

    <!-- Шапка -->
    <div class="bg-white border-b border-slate-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <nav class="flex flex-wrap items-center gap-1.5 text-sm text-slate-500 mb-4">
          <a href="/" class="hover:text-brand transition-colors">Главная</a>
          <svg class="w-3.5 h-3.5 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
          <span class="text-slate-900 font-medium">Проекты</span>
        </nav>
        <h1 class="text-3xl font-bold text-slate-900">Наши проекты</h1>
        <p class="mt-2 text-slate-500">{projects.length} реализованных объекта · Москва и МО</p>
      </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">

      <!-- Сетка проектов -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {projects.map((project) => (
          <a
            href={`/proekty/${project.id.replace(/\.mdx?$/, '')}`}
            class="group bg-white rounded-2xl border border-slate-200 hover:border-brand hover:shadow-md transition-all overflow-hidden"
          >
            <!-- Фото-заглушка -->
            <div class="aspect-video bg-slate-100 flex items-center justify-center">
              <svg class="w-16 h-16 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="0.75" d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/>
                <polyline points="9 22 9 12 15 12 15 22"/>
              </svg>
            </div>

            <div class="p-5">
              <h2 class="text-base font-semibold text-slate-900 group-hover:text-brand transition-colors leading-snug">
                {project.data.title}
              </h2>

              {project.data.description && (
                <p class="mt-2 text-sm text-slate-500 line-clamp-2">{project.data.description}</p>
              )}

              <div class="mt-3 flex flex-wrap gap-3 text-xs text-slate-400">
                {project.data.location && (
                  <span class="flex items-center gap-1">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                    </svg>
                    {project.data.location}
                  </span>
                )}
                {project.data.completionDate && (
                  <span>{new Date(project.data.completionDate).getFullYear()} г.</span>
                )}
              </div>
            </div>
          </a>
        ))}
      </div>

      <!-- CTA -->
      <div class="mt-12 bg-slate-900 text-white rounded-2xl p-8 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          <p class="font-bold text-xl">Хотите также?</p>
          <p class="text-slate-400 mt-1">Рассчитаем стоимость вашего проекта бесплатно</p>
        </div>
        <a href="/raschet" class="shrink-0 bg-brand hover:bg-brand-hover text-white font-semibold px-8 py-3 rounded-xl transition-colors">
          Получить расчёт
        </a>
      </div>

    </div>
  </div>
</BaseLayout>
