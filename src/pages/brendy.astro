    products: ['Гибкая черепица'],
    catalogUrl: '/catalog/krovlya/gibkaya-cherepitsa',
  },
  {
    name: 'АльтаПрофиль',
    slug: 'alta-profil',
    category: 'Фасад',
    description: 'Российский производитель виниловых фасадных систем. Широкий выбор сайдинга, софита и доборных элементов для облицовки фасадов.',
    products: ['Виниловый сайдинг', 'Фасадные панели'],
    catalogUrl: '/catalog/fasad/vinilovyy-sayding',
  },
  {
    name: 'Metrotile',
    slug: 'metrotile',
    category: 'Кровля',
    description: 'Новозеландский производитель лёгкой металлической черепицы. Имитация различных кровельных материалов при весе в 5 раз меньше традиционных.',
    products: ['Композитная черепица'],
    catalogUrl: '/catalog/krovlya/kompozitnaya-cherepitsa',
  },
  {
    name: 'Braas',
    slug: 'braas',
    category: 'Кровля',
