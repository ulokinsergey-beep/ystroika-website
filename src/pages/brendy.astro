---
/**
 * Страница «Бренды» — /brendy
 * Figma node: 415:9829
 */
import BaseLayout from '../layouts/BaseLayout.astro';

const brands = [
  {
    name: 'GrandLine',
    slug: 'grandline',
    category: 'Кровля и фасад',
    description: 'Ведущий российский производитель кровельных материалов, профнастила, металлочерепицы, фасадных систем и водосточных систем. Официальный дилер.',
    products: ['Металлочерепица', 'Профнастил', 'Фальцевая кровля', 'Виниловый сайдинг', 'Металлический сайдинг', 'Водосток'],
    catalogUrl: '/catalog/krovlya/metallocherepitsa',
  },
  {
    name: 'DÖCKE',
    slug: 'docke',
    category: 'Кровля и фасад',
    description: 'Немецкое качество, российское производство. Широкий ассортимент гибкой черепицы, виниловых и металлических фасадных систем, водостоков.',
    products: ['Гибкая черепица', 'Виниловый сайдинг', 'Фасадные панели', 'Водосток'],
    catalogUrl: '/catalog/krovlya/gibkaya-cherepitsa',
  },
  {
    name: 'Металл Профиль',
    slug: 'metall-profil',
    category: 'Кровля',
    description: 'Крупнейший производитель металлических строительных материалов в России. Металлочерепица, профнастил, фасадные системы с гарантией до 50 лет.',
    products: ['Металлочерепица', 'Профнастил', 'Металлический сайдинг'],
    catalogUrl: '/catalog/krovlya/metallocherepitsa',
  },
  {
    name: 'Stynergy',
    slug: 'stynergy',
    category: 'Кровля',
    description: 'Современные кровельные решения с инновационными покрытиями. Металлочерепица и профнастил с расширенной гарантией.',
    products: ['Металлочерепица', 'Профнастил'],
    catalogUrl: '/catalog/krovlya/metallocherepitsa',
  },
  {
    name: 'ТЕХНОНИКОЛЬ',
    slug: 'tehnonikol',
    category: 'Кровля',
    description: 'Международная группа компаний, мировой лидер по производству надёжных и эффективных строительных материалов. Рулонные кровельные материалы.',
    products: ['Гибкая черепица', 'Рулонные материалы'],
    catalogUrl: '/catalog/krovlya/gibkaya-cherepitsa',
  },
  {
    name: 'Katepal',
    slug: 'katepal',
    category: 'Кровля',
    description: 'Финский производитель высококачественной гибкой черепицы с 75-летней историей. Натуральный базальт в посыпке гарантирует долговечность.',
    products: ['Гибкая черепица'],
    catalogUrl: '/catalog/krovlya/gibkaya-cherepitsa',
  },
  {
    name: 'Tegola',
    slug: 'tegola',
    category: 'Кровля',
