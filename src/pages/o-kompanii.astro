---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdvantagesBlock from '../components/AdvantagesBlock.astro';
import aboutData from '../data/about-company.json';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  '@id': 'https://ystroika.ru/o-kompanii#aboutpage',
  url: 'https://ystroika.ru/o-kompanii',
  name: 'О компании У-Стройка',
  description: aboutData.firstBlock.text.slice(0, 160),
  mainEntity: {
    '@type': 'Organization',
    name: 'У-Стройка',
    foundingDate: '2014',
    description: aboutData.firstBlock.text,
  },
};
---

<BaseLayout
  title="О компании"
  description="У-Стройка — поставщик кровельных и фасадных материалов с 2014 года. Более 30 000 позиций в наличии, 3000+ специалистов, 98 офисов, 16 региональных складов."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <!-- HERO: page title + breadcrumb -->
  <section class="bg-white px-4 sm:px-8 lg:px-[60px]" style="padding-top:60px;padding-bottom:30px;">
    <nav class="text-[14px] text-[#898989] mb-[20px]">
      <a href="/" class="hover:text-[#FFAE01]">Главная</a> <span class="mx-[8px]">/</span> <span class="text-[#333333]">О компании</span>
    </nav>
    <div class="flex items-end gap-[25px]">
      <h1 class="font-[Montserrat] font-semibold text-[28px] lg:text-[42px] text-[#333333] leading-[1.22] flex-shrink-0">
        О компании
      </h1>
      <div class="flex-1 bg-[#E9E9E9]" style="height:1.5px;margin-bottom:14px;"></div>
    </div>
  </section>

  <!-- FIRST BLOCK: text + banner (стиль 8 экрана главной) -->
  <section class="bg-white px-4 sm:px-8 lg:px-[60px]" style="padding-top:30px;padding-bottom:60px;">
    <div class="flex flex-col lg:flex-row gap-[40px] items-start">
      <p class="text-[#333333] text-[16px] leading-[1.5] whitespace-pre-line" style="max-width:651px;">
        {aboutData.firstBlock.text}
      </p>

      <!-- Banner -->
      <div class="relative bg-[#464646] rounded-[5px] overflow-hidden flex-shrink-0"
           style="width:100%;max-width:1045px;height:360px;">
        <img src="/images/about/pngwing.png" alt=""
             class="absolute pointer-events-none"
             style="right:0;top:-200px;width:823px;height:1122px;object-fit:cover;opacity:0.85;" />
        <div class="absolute inset-0 bg-gradient-to-r from-[#464646] via-[#464646]/80 to-transparent pointer-events-none"></div>
        <div class="absolute flex items-center" style="left:40px;top:50px;width:273px;height:47px;background:#FFAE01;border-radius:5px;">
          <span class="text-[#333333] font-bold text-[24px] px-3">{aboutData.firstBlock.subtitle}</span>
        </div>
        <p class="absolute font-[Montserrat] font-semibold text-white leading-[1.3] z-10"
           style="left:40px;top:120px;width:334px;font-size:28px;">
          {aboutData.firstBlock.title}
        </p>
      </div>
    </div>
  </section>

  <!-- FIGURES BLOCK: 4 цифры -->
  <section class="bg-[#F5F5F5] px-4 sm:px-8 lg:px-[60px]" style="padding-top:60px;padding-bottom:60px;">
    <div class="flex items-end gap-[25px] mb-[50px]">
      <h2 class="font-[Montserrat] font-semibold text-[28px] lg:text-[42px] text-[#333333] leading-[1.22] flex-shrink-0">
        Цифры о&nbsp;нас
      </h2>
      <div class="flex-1 bg-[#E9E9E9]" style="height:1.5px;margin-bottom:14px;"></div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-[20px]">
      {aboutData.figures.map((f) => (
        <div class="bg-white rounded-[5px] flex flex-col gap-[15px]" style="padding:30px;min-height:200px;">
          <div class="font-[Montserrat] font-bold text-[#FFAE01] text-[48px] leading-none">{f.number}</div>
          <div class="font-[Montserrat] font-semibold text-[#333333] text-[20px] leading-[1.2]">{f.label}</div>
          <p class="text-[#333333] text-[14px] leading-[1.4]">{f.description}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ADVANTAGES (Figma P3) -->
  <section class="bg-white px-4 sm:px-8 lg:px-[60px]">
    <AdvantagesBlock />
  </section>

  <!-- SECOND BLOCK: цель и девиз -->
  <section class="bg-white px-4 sm:px-8 lg:px-[60px]" style="padding-top:60px;padding-bottom:60px;">
    <div class="flex items-end gap-[25px] mb-[40px]">
      <h2 class="font-[Montserrat] font-semibold text-[28px] lg:text-[42px] text-[#333333] leading-[1.22] flex-shrink-0">
        {aboutData.secondBlock.title}
      </h2>
      <div class="flex-1 bg-[#E9E9E9]" style="height:1.5px;margin-bottom:14px;"></div>
    </div>
    <p class="text-[#333333] text-[16px] leading-[1.5] whitespace-pre-line" style="max-width:1200px;">
      {aboutData.secondBlock.text}
    </p>
  </section>

  <!-- HISTORY: timeline -->
  <section class="bg-[#F5F5F5] px-4 sm:px-8 lg:px-[60px]" style="padding-top:60px;padding-bottom:60px;">
    <div class="flex items-end gap-[25px] mb-[50px]">
      <h2 class="font-[Montserrat] font-semibold text-[28px] lg:text-[42px] text-[#333333] leading-[1.22] flex-shrink-0">
        История компании
      </h2>
      <div class="flex-1 bg-[#E9E9E9]" style="height:1.5px;margin-bottom:14px;"></div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-[20px]">
      {aboutData.history.map((h) => (
        <div class="bg-white rounded-[5px] flex flex-col gap-[15px] relative overflow-hidden" style="padding:25px;min-height:180px;">
          <div class="font-[Montserrat] font-bold text-[#FFAE01] text-[32px] leading-none">{h.year}</div>
          <p class="text-[#333333] text-[15px] leading-[1.4]">{h.description}</p>
          <div class="absolute right-[-20px] bottom-[-20px] w-[80px] h-[80px] rounded-full bg-[#FFAE01]/10 pointer-events-none"></div>
        </div>
      ))}
    </div>
  </section>

  <!-- DIRECTIONS -->
  <section class="bg-white px-4 sm:px-8 lg:px-[60px]" style="padding-top:60px;padding-bottom:80px;">
    <div class="flex items-end gap-[25px] mb-[40px]">
      <h2 class="font-[Montserrat] font-semibold text-[28px] lg:text-[42px] text-[#333333] leading-[1.22] flex-shrink-0">
        Наши направления
      </h2>
      <div class="flex-1 bg-[#E9E9E9]" style="height:1.5px;margin-bottom:14px;"></div>
    </div>

    <div class="flex flex-wrap gap-[10px]">
      {aboutData.directions.map((url) => {
        const label = url.replace(/^\/catalog\//, '').replace(/\/$/, '').replace(/-/g, ' ');
        const displayLabel = label.charAt(0).toUpperCase() + label.slice(1);
        return (
          <a href={url}
             class="inline-flex items-center bg-[#F5F5F5] hover:bg-[#FFAE01] rounded-[5px] text-[#333333] text-[15px] font-medium transition-colors"
             style="height:44px;padding:0 20px;">
            {displayLabel}
          </a>
        );
      })}
    </div>
  </section>

  <!-- SPECIALISTS (Figma P3) -->
  <section class="bg-[#F5F5F5] px-4 sm:px-8 lg:px-[60px]" style="padding-top:60px;padding-bottom:60px;">
    <div class="flex flex-col gap-[40px]">
      <div class="flex flex-col gap-[15px]">
        <h2 class="font-[Montserrat] font-semibold text-[28px] lg:text-[42px] text-[#333333] leading-[1.22]">
          У&nbsp;нас работают только сертифицированные специалисты с&nbsp;опытом более 8&nbsp;лет
        </h2>
        <p class="text-[#333333] text-[18px] leading-[1.3]" style="max-width:714px;">
          Ежегодно проходят обучение от&nbsp;заводов-производителей, понимают весь технический процесс, прошли аттестацию на&nbsp;знание данной продукции
        </p>
      </div>
      <div class="flex flex-col lg:flex-row gap-[20px]" style="min-height:550px;">
        <div class="relative rounded-[5px] overflow-hidden bg-[#E9E9E9]" style="flex:1042 1 0%;min-height:300px;">
          <img src="/images/home/s10-team-main.png" alt="Специалисты компании" class="absolute inset-0 w-full h-full object-cover object-top" />
        </div>
        <div class="flex flex-col gap-[20px]" style="flex:738 1 0%;">
          <div class="relative rounded-[5px] overflow-hidden bg-[#E9E9E9] flex-1" style="min-height:140px;">
            <img src="/images/home/s10-team-2.png" alt="Команда специалистов" class="absolute inset-0 w-full h-full object-cover" />
          </div>
          <div class="relative rounded-[5px] overflow-hidden bg-[#E9E9E9] flex-1" style="min-height:140px;">
            <img src="/images/home/s10-team-3.png" alt="Сертифицированные мастера" class="absolute inset-0 w-full h-full object-cover" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- REVIEWS (Figma P3) -->
  <section class="bg-white px-4 sm:px-8 lg:px-[60px]" style="padding-top:60px;padding-bottom:60px;">
    <div class="flex flex-col gap-[40px]">
      <div class="flex items-end gap-[25px]">
        <h2 class="font-[Montserrat] font-semibold text-[28px] lg:text-[42px] text-[#333333] leading-[1.22] flex-shrink-0" style="max-width:892px;">
          Посмотрите что говорят наши клиенты
        </h2>
        <div class="flex-1 bg-[#E9E9E9]" style="height:1.5px;margin-bottom:14px;"></div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-[20px]">
        {[
          { name: 'Вадим',   text: 'Огромное спасибо Александру за грамотное и профессиональное отношение к клиентам. Очень приятное общение, своевременная доставка. Итоговая цена очень порадовала.' },
          { name: 'Валерий', text: 'Выражаем огромную благодарность вашей компании за грамотную и профессиональную работу! Чёткие ответы, доставка в назначенное время оставили самое приятное впечатление.' },
          { name: 'Ольга',   text: 'Хочу выразить благодарность Светлане за грамотную и профессиональную работу с клиентом. Хотелось, чтобы таких специалистов было больше. Спасибо за индивидуальный подход!' },
        ].map((r) => (
          <div class="bg-[#F5F5F5] rounded-[5px] flex flex-col gap-[15px]" style="padding:25px;min-height:240px;">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-[12px]">
                <div class="w-[50px] h-[50px] rounded-full bg-[#E9E9E9] flex items-center justify-center text-[#898989] text-[20px] font-semibold flex-shrink-0">{r.name.charAt(0)}</div>
                <span class="text-[#333333] text-[16px] font-semibold">{r.name}</span>
              </div>
              <div class="flex items-center gap-[2px]">
                {[1,2,3,4,5].map(() => (<svg width="18" height="18" viewBox="0 0 20 20" fill="#FFAE01"><polygon points="10,1 12.5,7.5 19,7.5 14,12 16,18.5 10,15 4,18.5 6,12 1,7.5 7.5,7.5"/></svg>))}
              </div>
            </div>
            <p class="text-[#333333] text-[14px] leading-[1.4] flex-1">{r.text}</p>
            <a href="/otzyvy" class="text-[#333333] text-[13px] underline hover:text-[#FFAE01] transition-colors self-start">Читать весь отзыв</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CERTIFICATES (Figma P3) -->
  <section class="bg-[#F5F5F5] px-4 sm:px-8 lg:px-[60px]" style="padding-top:60px;padding-bottom:60px;">
    <div class="flex flex-col gap-[40px]">
      <div class="flex items-end gap-[25px]">
        <h2 class="font-[Montserrat] font-semibold text-[28px] lg:text-[42px] text-[#333333] leading-[1.22] flex-shrink-0">Сертификаты</h2>
        <div class="flex-1 bg-[#E9E9E9]" style="height:1.5px;margin-bottom:14px;"></div>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-[20px]">
        {['Сертификат соответствия', 'Сертификат качества', 'Декларация о соответствии', 'Гарантийный сертификат'].map((t) => (
          <div class="bg-white rounded-[5px] border border-[#E9E9E9] flex flex-col items-center justify-center gap-[15px] p-6" style="aspect-ratio:3/4;">
            <svg class="w-12 h-12 text-[#FFAE01]" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            <span class="text-[#333333] text-[13px] text-center leading-snug">{t}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CONTACTS + MAP (Figma P3) -->
  <section class="bg-white px-4 sm:px-8 lg:px-[60px]" style="padding-top:60px;padding-bottom:80px;">
    <div class="flex flex-col gap-[40px]">
      <div class="flex items-end gap-[25px]">
        <h2 class="font-[Montserrat] font-semibold text-[28px] lg:text-[42px] text-[#333333] leading-[1.22] flex-shrink-0">Контактная информация</h2>
        <div class="flex-1 bg-[#E9E9E9]" style="height:1.5px;margin-bottom:14px;"></div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-[20px]">
        <div class="bg-[#F5F5F5] rounded-[5px] p-6 flex flex-col gap-2">
          <span class="text-[#898989] text-[14px]">Телефон</span>
          <a href="tel:88003339495" class="text-[#333333] text-[20px] font-bold hover:text-[#FFAE01] transition-colors">8-800-333-94-95</a>
          <span class="text-[#898989] text-[13px]">Бесплатно по&nbsp;России</span>
        </div>
        <div class="bg-[#F5F5F5] rounded-[5px] p-6 flex flex-col gap-2">
          <span class="text-[#898989] text-[14px]">Email</span>
          <a href="mailto:office@y-stroika.ru" class="text-[#333333] text-[18px] font-semibold hover:text-[#FFAE01] transition-colors break-words">office@y-stroika.ru</a>
          <span class="text-[#898989] text-[13px]">Отвечаем в&nbsp;течение часа</span>
        </div>
        <div class="bg-[#F5F5F5] rounded-[5px] p-6 flex flex-col gap-2">
          <span class="text-[#898989] text-[14px]">Офис</span>
          <span class="text-[#333333] text-[16px] font-semibold leading-snug">ул.&nbsp;Советская 1А, Куровское</span>
          <a href="/kontakty" class="text-[#FFAE01] text-[13px] font-semibold hover:underline">Схема проезда →</a>
        </div>
      </div>
      <a href="/kontakty" class="relative block rounded-[5px] overflow-hidden bg-[#333333] group" style="height:320px;">
        <div class="absolute inset-0 flex flex-col items-center justify-center gap-3 text-center px-4">
          <svg class="w-12 h-12 text-[#FFAE01]" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          <span class="text-white text-[16px] font-semibold">Москва и&nbsp;Московская область</span>
          <span class="inline-flex items-center justify-center bg-[#FFAE01] text-[#333333] font-semibold text-sm rounded-[5px] px-6 h-11 group-hover:bg-[#e09d00] transition-colors">Открыть карту</span>
        </div>
      </a>
    </div>
  </section>
</BaseLayout>
