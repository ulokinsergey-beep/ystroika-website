---
/**
 * Страница «Гарантии» — /garantii
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Гарантии на товары и монтаж — У-Стройка"
  description="Гарантия на строительные материалы от 5 до 50 лет. Гарантия на монтажные работы — 5 лет. Возврат и обмен товара. У-Стройка, Москва."
>
  <div class="bg-[#f5f5f5] min-h-screen">

    <!-- Шапка -->
    <div class="bg-white border-b border-[#e5e5e5]">
      <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-[60px] py-6">
        <nav class="flex flex-wrap items-center gap-1 text-sm text-[#898989] mb-4">
          <a href="/" class="hover:text-[#FFAE01] transition-colors">Главная</a>
          <svg class="w-3.5 h-3.5 text-[#d0d0d0]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          <span class="text-slate-900 font-medium">Гарантии</span>
        </nav>
        <h1 class="text-2xl lg:text-[32px] font-bold text-slate-900">Гарантии</h1>
        <p class="mt-2 text-[#898989]">Официальная гарантия производителя на все материалы</p>
      </div>
    </div>

    <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-[60px] py-8">

      <!-- Ключевые цифры -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-10">
        {[
          {
            value: '5 лет',
            label: 'На монтажные работы',
            icon: 'M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z M15 12a3 3 0 11-6 0 3 3 0 016 0z',
          },
          {
            value: 'до 50 лет',
            label: 'Гарантия производителя на материалы',
            icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
          },
          {
            value: '14 дней',
            label: 'Возврат неиспользованного товара',
            icon: 'M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15',
          },
        ].map(item => (
          <div class="bg-white rounded-[10px] border border-[#e5e5e5] p-6 text-center">
            <div class="w-12 h-12 mx-auto mb-3 rounded-full bg-[#FFAE01]/10 flex items-center justify-center">
              <svg class="w-6 h-6 text-[#FFAE01]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={item.icon}/>
              </svg>
            </div>
            <p class="text-2xl font-bold text-[#FFAE01] mb-1">{item.value}</p>
            <p class="text-sm text-[#898989]">{item.label}</p>
          </div>
        ))}
      </div>

      <!-- Гарантия на материалы -->
      <h2 class="text-xl font-bold text-slate-900 mb-4">Гарантия на материалы</h2>
      <div class="bg-white border border-[#e5e5e5] rounded-[10px] overflow-hidden mb-8">
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-[#f5f5f5] border-b border-[#e5e5e5]">
              <th class="text-left px-6 py-3.5 font-semibold text-slate-700">Материал</th>
              <th class="text-right px-6 py-3.5 font-semibold text-slate-700">Срок гарантии</th>
            </tr>
          </thead>
          <tbody>
            {[
              ['Металлочерепица', 'от 15 до 50 лет'],
              ['Профнастил', 'от 10 до 25 лет'],
              ['Фальцевая кровля', 'от 25 до 50 лет'],
              ['Гибкая черепица', 'от 25 до 50 лет'],
              ['Виниловый сайдинг', 'от 15 до 25 лет'],
              ['Металлический сайдинг', 'от 20 до 40 лет'],
              ['Водосточные системы', 'от 10 до 25 лет'],
            ].map(([mat, term], i) => (
              <tr class={i % 2 === 0 ? 'bg-white' : 'bg-[#fafafa]'}>
                <td class="px-6 py-3.5 text-slate-700 border-b border-[#f0f0f0]">{mat}</td>
                <td class="px-6 py-3.5 text-right font-semibold text-slate-900 border-b border-[#f0f0f0]">{term}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <!-- Условия -->
      <h2 class="text-xl font-bold text-slate-900 mb-4">Условия гарантии</h2>
      <div class="bg-white rounded-[10px] border border-[#e5e5e5] p-6 mb-10">
        <ul class="space-y-3">
          {[
            'Гарантия действует при соблюдении правил монтажа и эксплуатации',
            'Сохраняйте товарные чеки и договор на монтаж',
            'Гарантийный случай рассматривается в течение 10 рабочих дней',
            'Бесплатный выезд инженера для оценки гарантийного случая',
            'Устранение недостатков или замена материала за наш счёт',
          ].map(item => (
            <li class="flex items-start gap-2.5 text-sm text-slate-700">
              <svg class="w-4 h-4 mt-0.5 text-[#FFAE01] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              {item}
            </li>
          ))}
        </ul>
      </div>

      <!-- CTA -->
      <div class="bg-slate-900 text-white rounded-[10px] p-8 flex flex-col sm:flex-row items-center justify-between gap-6">
        <div>
          <h2 class="text-xl font-bold mb-2">Возник гарантийный случай?</h2>
          <p class="text-[#898989] text-sm">Позвоните — решим в течение 10 рабочих дней</p>
        </div>
        <a
          href="tel:88003339495"
          class="shrink-0 bg-[#FFAE01] hover:bg-[#e09d00] text-black font-semibold px-8 py-3 rounded-[5px] transition-colors whitespace-nowrap"
        >
          Позвонить
        </a>
      </div>

    </div>
  </div>
</BaseLayout>
