---
/**
 * Страница «Гарантии» — /garantii
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Гарантии на товары и монтаж — У-Стройка"
  description="Гарантия на строительные материалы от 5 до 50 лет. Гарантия на монтажные работы — 5 лет. Возврат и обмен товара. У-Стройка, Москва."
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

    <nav class="flex items-center gap-1.5 text-sm text-slate-500 mb-6">
      <a href="/" class="hover:text-brand">Главная</a>
      <svg class="w-3.5 h-3.5 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
      </svg>
      <span class="text-slate-900 font-medium">Гарантии</span>
    </nav>

    <h1 class="text-3xl font-bold text-slate-900 mb-8">Гарантии</h1>

    <!-- Ключевые гарантии -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-10">
      {[
        { value: '5 лет', label: 'На монтажные работы', icon: '🔧' },
        { value: 'до 50 лет', label: 'Гарантия производителя на материалы', icon: '🏠' },
        { value: '14 дней', label: 'Возврат неиспользованного товара', icon: '↩️' },
      ].map(item => (
        <div class="bg-white rounded-2xl border border-slate-200 p-6 text-center">
          <div class="text-3xl mb-3">{item.icon}</div>
          <p class="text-2xl font-bold text-brand">{item.value}</p>
          <p class="text-sm text-slate-500 mt-1">{item.label}</p>
        </div>
      ))}
    </div>

    <!-- Гарантия на материалы -->
    <h2 class="text-xl font-bold text-slate-900 mb-4">Гарантия на материалы</h2>
    <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden mb-8">
      <table class="w-full text-sm">
        <thead>
          <tr class="bg-slate-50 border-b border-slate-200">
            <th class="text-left px-5 py-3 font-semibold text-slate-700">Материал</th>
            <th class="text-right px-5 py-3 font-semibold text-slate-700">Срок гарантии</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          {[
            ['Металлочерепица', 'от 15 до 50 лет'],
            ['Профнастил', 'от 10 до 25 лет'],
            ['Фальцевая кровля', 'от 25 до 50 лет'],
            ['Гибкая черепица', 'от 25 до 50 лет'],
            ['Виниловый сайдинг', 'от 15 до 25 лет'],
            ['Металлический сайдинг', 'от 20 до 40 лет'],
            ['Водосточные системы', 'от 10 до 25 лет'],
          ].map(([mat, term]) => (
            <tr>
              <td class="px-5 py-3 text-slate-700">{mat}</td>
              <td class="px-5 py-3 text-right font-medium text-slate-900">{term}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- Условия -->
    <h2 class="text-xl font-bold text-slate-900 mb-4">Условия гарантии</h2>
    <div class="bg-slate-50 rounded-2xl p-6 mb-10">
      <ul class="space-y-3 text-sm text-slate-700">
        {[
          'Гарантия действует при соблюдении правил монтажа и эксплуатации',
          'Сохраняйте товарные чеки и договор на монтаж',
          'Гарантийный случай рассматривается в течение 10 рабочих дней',
          'Бесплатный выезд инженера для оценки гарантийного случая',
          'Устранение недостатков или замена материала за наш счёт',
        ].map(item => (
          <li class="flex items-start gap-2.5">
            <svg class="w-4 h-4 mt-0.5 text-brand shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
            </svg>
            {item}
          </li>
        ))}
      </ul>
    </div>

    <div class="bg-slate-900 text-white rounded-2xl p-8 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div>
        <p class="font-bold text-xl">Возник гарантийный случай?</p>
        <p class="text-slate-400 mt-1">Позвоните — решим в течение 10 рабочих дней</p>
      </div>
      <a href="tel:88003339495" class="shrink-0 bg-brand hover:bg-brand-hover text-white font-semibold px-8 py-3 rounded-xl transition-colors">
        Позвонить
      </a>
    </div>

  </div>
</BaseLayout>
