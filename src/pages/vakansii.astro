---
/**
 * Страница «Вакансии» — /vakansii
 */
import BaseLayout from '../layouts/BaseLayout.astro';

const vacancies = [
  {
    title: 'Кровельщик',
    salary: 'от 80 000 ₽',
    type: 'Полная занятость',
    description: 'Монтаж металлочерепицы, профнастила, мягкой кровли. Опыт от 1 года.',
  },
  {
    title: 'Монтажник фасадных систем',
    salary: 'от 75 000 ₽',
    type: 'Полная занятость',
    description: 'Монтаж виниловый и металлического сайдинга, фасадных панелей. Опыт приветствуется.',
  },
  {
    title: 'Менеджер по продажам',
    salary: 'от 60 000 ₽ + %',
    type: 'Полная занятость',
    description: 'Консультации клиентов, подготовка коммерческих предложений, работа с базой CRM.',
  },
];
---

<BaseLayout
  title="Вакансии — У-Стройка"
  description="Открытые вакансии в компании У-Стройка: кровельщики, монтажники, менеджеры по продажам. Москва и МО. Звоните: 8-800-333-94-95."
>
  <div class="bg-[#f5f5f5] min-h-screen">

    <!-- Шапка -->
    <div class="bg-white border-b border-[#e5e5e5]">
      <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-[60px] py-6">
        <nav class="flex flex-wrap items-center gap-1 text-sm text-[#898989] mb-4">
          <a href="/" class="hover:text-[#FFAE01] transition-colors">Главная</a>
          <svg class="w-3.5 h-3.5 text-[#d0d0d0]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          <span class="text-slate-900 font-medium">Вакансии</span>
        </nav>
        <h1 class="text-2xl lg:text-[32px] font-bold text-slate-900">Вакансии</h1>
        <p class="mt-2 text-[#898989]">Приглашаем в команду специалистов по кровле и фасадам</p>
      </div>
    </div>

    <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-[60px] py-8">

      <div class="space-y-4 mb-10">
        {vacancies.map((v) => (
          <div class="bg-white rounded-[10px] border border-[#e5e5e5] p-6 hover:border-[#FFAE01] transition-colors">
            <div class="flex flex-wrap items-start justify-between gap-3 mb-4">
              <div>
                <h2 class="text-lg font-bold text-slate-900">{v.title}</h2>
                <p class="mt-1 text-sm text-[#898989]">{v.description}</p>
              </div>
              <div class="shrink-0 text-right">
                <p class="text-lg font-bold text-[#FFAE01]">{v.salary}</p>
                <p class="text-xs text-[#898989]">{v.type}</p>
              </div>
            </div>
            <a
              href="tel:88003339495"
              class="inline-flex items-center gap-2 bg-[#FFAE01] hover:bg-[#e09d00] text-black font-semibold text-sm px-5 py-2.5 rounded-[5px] transition-colors"
            >
              Откликнуться
            </a>
          </div>
        ))}
      </div>

      <!-- CTA -->
      <div class="bg-slate-900 text-white rounded-[10px] p-8 text-center">
        <h2 class="font-bold text-xl mb-2">Не нашли подходящую вакансию?</h2>
        <p class="text-[#898989] text-sm mb-6">Отправьте резюме — мы свяжемся, когда откроется подходящая позиция</p>
        <a
          href="tel:88003339495"
          class="inline-flex items-center gap-2 bg-[#FFAE01] hover:bg-[#e09d00] text-black font-semibold px-8 py-3 rounded-[5px] transition-colors"
        >
          Позвонить
        </a>
      </div>

    </div>
  </div>
</BaseLayout>
