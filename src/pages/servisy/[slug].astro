---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdvantagesBlock from '../../components/AdvantagesBlock.astro';
import { calculators } from '../../data/calculators';

export function getStaticPaths() {
  return calculators.map((c) => ({ params: { slug: c.slug }, props: { calc: c } }));
}

const { calc } = Astro.props;
const areaLabel =
  calc.kind === 'vodostok' ? 'Периметр кровли, м.п.'
  : calc.kind === 'fasad' ? 'Площадь фасада, м²'
  : 'Площадь кровли, м²';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: calc.title,
  applicationCategory: 'BusinessApplication',
  url: `https://ystroika.ru/servisy/${calc.slug}/`,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'RUB' },
};
---

<BaseLayout title={`${calc.title} — У-Стройка`} description={`${calc.short} Онлайн-расчёт за 1 день. Звоните: 8-800-333-94-95.`}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <!-- Крошки + заголовок -->
  <section class="bg-white px-4 sm:px-8 lg:px-[60px]" style="padding-top:60px;padding-bottom:30px;">
    <nav class="text-[14px] text-[#898989] mb-[20px]">
      <a href="/" class="hover:text-[#FFAE01]">Главная</a> <span class="mx-[8px]">/</span>
      <a href="/servisy" class="hover:text-[#FFAE01]">Сервисы</a> <span class="mx-[8px]">/</span>
      <span class="text-[#333333]">{calc.title}</span>
    </nav>
    <div class="flex items-end gap-[25px]">
      <h1 class="font-[Montserrat] font-semibold text-[28px] lg:text-[42px] text-[#333333] leading-[1.22] flex-shrink-0">
        {calc.title}
      </h1>
      <div class="flex-1 bg-[#E9E9E9]" style="height:1.5px;margin-bottom:14px;"></div>
    </div>
  </section>

  <!-- Калькулятор: форма слева + инфо справа -->
  <section class="bg-white px-4 sm:px-8 lg:px-[60px]" style="padding-bottom:60px;">
    <p class="text-[#333333] text-[18px] leading-[1.4] mb-[30px]" style="max-width:760px;">{calc.short}</p>

    <div class="flex flex-col lg:flex-row gap-[20px] items-stretch">
      <!-- Форма -->
      <form class="flex-1 bg-[#F5F5F5] rounded-[5px] flex flex-col gap-[18px]" style="padding:35px;max-width:760px;">
        <h2 class="font-[Montserrat] font-semibold text-[#333333] text-[22px]">Параметры объекта</h2>

        <label class="flex flex-col gap-[6px]">
          <span class="text-[#898989] text-[13px]">{areaLabel}</span>
          <input type="number" name="area" min="1" step="0.1" required placeholder="Например, 120"
                 class="h-[50px] px-4 bg-white rounded-[5px] text-[16px] text-[#333333] border border-[#E9E9E9] focus:outline-none focus:ring-2 focus:ring-[#FFAE01]" />
        </label>

        <label class="flex flex-col gap-[6px]">
          <span class="text-[#898989] text-[13px]">Тип объекта</span>
          <select name="object_type" class="h-[50px] px-4 bg-white rounded-[5px] text-[16px] text-[#333333] border border-[#E9E9E9] focus:outline-none focus:ring-2 focus:ring-[#FFAE01]">
            <option>Частный дом</option>
            <option>Дача</option>
            <option>Коммерческий объект</option>
            <option>Другое</option>
          </select>
        </label>

        <label class="flex flex-col gap-[6px]">
          <span class="text-[#898989] text-[13px]">Когда планируете работы</span>
          <select name="timing" class="h-[50px] px-4 bg-white rounded-[5px] text-[16px] text-[#333333] border border-[#E9E9E9] focus:outline-none focus:ring-2 focus:ring-[#FFAE01]">
            <option>В ближайший месяц</option>
            <option>В этом сезоне</option>
            <option>Пока просто считаю</option>
          </select>
        </label>

        <div class="h-px bg-[#E9E9E9] my-1"></div>

        <label class="flex flex-col gap-[6px]">
          <span class="text-[#898989] text-[13px]">Ваше имя *</span>
          <input type="text" name="name" required placeholder="Имя"
                 class="h-[50px] px-4 bg-white rounded-[5px] text-[16px] text-[#333333] border border-[#E9E9E9] focus:outline-none focus:ring-2 focus:ring-[#FFAE01]" />
        </label>
        <label class="flex flex-col gap-[6px]">
          <span class="text-[#898989] text-[13px]">Телефон *</span>
          <input type="tel" name="phone" required placeholder="+7 (___) ___-__-__"
                 class="h-[50px] px-4 bg-white rounded-[5px] text-[16px] text-[#333333] border border-[#E9E9E9] focus:outline-none focus:ring-2 focus:ring-[#FFAE01]" />
        </label>
        <label class="flex items-start gap-[10px] text-[#898989] text-[13px] leading-[1.4] cursor-pointer">
          <input type="checkbox" required class="mt-[2px] accent-[#FFAE01] w-[16px] h-[16px] flex-shrink-0" />
          <span>Согласен с&nbsp;политикой конфиденциальности и&nbsp;обработкой персональных данных</span>
        </label>

        <button type="submit" class="bg-[#FFAE01] hover:bg-[#e09d00] text-[#333333] font-semibold text-[18px] rounded-[5px] transition-colors" style="height:50px;">
          Получить расчёт
        </button>
      </form>

      <!-- Инфо -->
      <div class="lg:w-[420px] flex-shrink-0 bg-[#333333] rounded-[5px] flex flex-col gap-[20px]" style="padding:35px;">
        <h2 class="font-[Montserrat] font-semibold text-white text-[22px]">Как мы считаем</h2>
        <ul class="flex flex-col gap-[14px]">
          {[
            'Учитываем геометрию кровли/фасада и все доборные элементы',
            'Подбираем материалы под бюджет — с гарантией лучшей цены',
            'Готовим смету за 1 день, выезд замерщика бесплатно',
            'Менеджер на связи в мессенджерах до позднего вечера',
          ].map((t) => (
            <li class="flex items-start gap-[10px] text-[#E9E9E9] text-[15px] leading-[1.4]">
              <span class="inline-flex items-center justify-center w-[20px] h-[20px] rounded-full bg-[#FFAE01] flex-shrink-0 mt-[1px]">
                <svg width="11" height="11" fill="none" stroke="#333333" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              </span>
              {t}
            </li>
          ))}
        </ul>
        <div class="h-px bg-[#464646]"></div>
        <div class="flex flex-col gap-1">
          <span class="text-[#898989] text-[13px]">Или позвоните:</span>
          <a href="tel:88003339495" class="text-[#FFAE01] font-bold text-[22px] hover:opacity-80 transition-opacity">8-800-333-94-95</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Преимущества -->
  <section class="bg-[#F5F5F5] px-4 sm:px-8 lg:px-[60px]">
    <AdvantagesBlock />
  </section>
</BaseLayout>
