---
/**
 * Страница «Карта сайта» — /karta-sayta
 * Figma node: 453:14455
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { categories } from '../data/categories';

const mainLinks = [
  { title: 'Главная', url: '/' },
  { title: 'О компании', url: '/o-kompanii' },
  { title: 'Контакты', url: '/kontakty' },
  { title: 'Бренды', url: '/brendy' },
  { title: 'Новости', url: '/novosti' },
  { title: 'Блог', url: '/blog' },
  { title: 'Проекты', url: '/proekty' },
  { title: 'Отзывы', url: '/otzyvy' },
];

const catalogLinks = categories.map(cat => ({
  title: cat.title,
  url: `/catalog/${cat.slug}`,
  subcategories: (cat.subcategories ?? []).map(sub => ({
    title: sub.title,
    url: `/catalog/${cat.slug}/${sub.slug}`,
  })),
}));

const serviceLinks = [
  { title: 'Доставка', url: '/dostavka' },
  { title: 'Оплата', url: '/oplata' },
  { title: 'Гарантии', url: '/garantii' },
  { title: 'Обмен и возврат', url: '/vozvrat-obmen' },
  { title: 'Спецпредложения', url: '/spetspredlozheniya' },
  { title: 'Спец условия для строителей', url: '/spets-usloviya' },
  { title: 'Расчёт материалов', url: '/raschet' },
  { title: 'Услуги', url: '/uslugi' },
  { title: 'Вакансии', url: '/vakansii' },
];

const infoLinks = [
  { title: 'Сертификаты', url: '/sertifikaty' },
  { title: 'Вопросы и ответы', url: '/voprosy-otvety' },
  { title: 'Реквизиты', url: '/rekvizity' },
  { title: 'Политика конфиденциальности', url: '/politika-konfidentsialnosti' },
  { title: 'Карта сайта', url: '/karta-sayta' },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Главная",     "item": "https://y-stroika.ru/" },
    { "@type": "ListItem", "position": 2, "name": "Карта сайта", "item": "https://y-stroika.ru/karta-sayta/" },
  ]
};
---

<BaseLayout
  title="Карта сайта — У-Стройка"
  description="Карта сайта У-Стройка: все разделы, каталог кровельных и фасадных материалов, услуги, информационные страницы."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <div class="bg-[#f5f5f5] min-h-screen">

    <!-- Шапка -->
    <div class="bg-white border-b border-[#e5e5e5]">
      <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-[60px] py-6">
        <nav class="flex flex-wrap items-center gap-1 text-sm text-[#898989] mb-4">
          <a href="/" class="hover:text-[#FFAE01] transition-colors">Главная</a>
          <svg class="w-3.5 h-3.5 text-[#d0d0d0]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          <span class="text-slate-900 font-medium">Карта сайта</span>
        </nav>
        <h1 class="text-2xl lg:text-[32px] font-bold text-slate-900">Карта сайта</h1>
        <p class="mt-2 text-[#898989]">Все разделы и страницы сайта</p>
      </div>
    </div>

    <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-[60px] py-8">

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">

        <!-- Основные страницы -->
        <div class="bg-white rounded-[10px] border border-[#e5e5e5] p-6">
          <h2 class="font-bold text-slate-900 text-lg mb-4 flex items-center gap-2">
            <span class="w-1 h-5 bg-[#FFAE01] rounded-full inline-block"></span>
            Компания
          </h2>
          <ul class="space-y-2">
            {mainLinks.map(link => (
              <li>
                <a
                  href={link.url}
                  class="text-sm text-slate-700 hover:text-[#FFAE01] transition-colors flex items-center gap-2"
                >
                  <svg class="w-3 h-3 text-[#d0d0d0] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                  </svg>
                  {link.title}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <!-- Покупателям -->
        <div class="bg-white rounded-[10px] border border-[#e5e5e5] p-6">
          <h2 class="font-bold text-slate-900 text-lg mb-4 flex items-center gap-2">
            <span class="w-1 h-5 bg-[#FFAE01] rounded-full inline-block"></span>
            Покупателям
          </h2>
          <ul class="space-y-2">
            {serviceLinks.map(link => (
              <li>
                <a
                  href={link.url}
                  class="text-sm text-slate-700 hover:text-[#FFAE01] transition-colors flex items-center gap-2"
                >
                  <svg class="w-3 h-3 text-[#d0d0d0] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                  </svg>
                  {link.title}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <!-- Информация -->
        <div class="bg-white rounded-[10px] border border-[#e5e5e5] p-6">
          <h2 class="font-bold text-slate-900 text-lg mb-4 flex items-center gap-2">
            <span class="w-1 h-5 bg-[#FFAE01] rounded-full inline-block"></span>
            Информация
          </h2>
          <ul class="space-y-2">
            {infoLinks.map(link => (
              <li>
                <a
                  href={link.url}
                  class="text-sm text-slate-700 hover:text-[#FFAE01] transition-colors flex items-center gap-2"
                >
                  <svg class="w-3 h-3 text-[#d0d0d0] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                  </svg>
                  {link.title}
                </a>
              </li>
            ))}
          </ul>
        </div>

      </div>

      <!-- Каталог -->
      <div class="bg-white rounded-[10px] border border-[#e5e5e5] p-6 mb-6">
        <h2 class="font-bold text-slate-900 text-lg mb-6 flex items-center gap-2">
          <span class="w-1 h-5 bg-[#FFAE01] rounded-full inline-block"></span>
          Каталог товаров
          <a href="/catalog" class="ml-auto text-sm font-normal text-[#FFAE01] hover:opacity-80 transition-opacity flex items-center gap-1">
            Весь каталог
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </a>
        </h2>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {catalogLinks.map(cat => (
            <div>
              <a
                href={cat.url}
                class="font-semibold text-slate-900 hover:text-[#FFAE01] transition-colors text-sm mb-3 block"
              >
                {cat.title}
              </a>
              {cat.subcategories.length > 0 && (
                <ul class="space-y-1.5">
                  {cat.subcategories.map(sub => (
                    <li>
                      <a
                        href={sub.url}
                        class="text-xs text-[#898989] hover:text-[#FFAE01] transition-colors flex items-center gap-1.5"
                      >
                        <span class="w-1 h-1 rounded-full bg-[#d0d0d0] shrink-0 inline-block"></span>
                        {sub.title}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          ))}
        </div>
      </div>

    </div>
  </div>
</BaseLayout>
