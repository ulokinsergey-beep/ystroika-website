---
/**
 * Страница «Услуги» — /uslugi
 * Контент: src/content/services/ (из Bitrix IBLOCK 29)
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allServices = await getCollection('services', ({ data }) => data.published !== false);
const services = allServices.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  'name': 'Монтажные услуги — У-Стройка',
  'url': 'https://y-stroika.ru/uslugi/',
  'provider': { '@type': 'Organization', 'name': 'У-Стройка', 'url': 'https://y-stroika.ru' },
};
---

<BaseLayout
  title="Монтажные услуги кровли, фасада и водосточных систем — У-Стройка"
  description="Профессиональный монтаж кровельного покрытия, водосточных систем, фасадов. Бесплатный выезд замерщика, гарантия на работы. Звоните: 8-800-333-94-95."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <div class="bg-[#f5f5f5] min-h-screen">

    <!-- Шапка -->
    <div class="bg-white border-b border-[#e5e5e5]">
      <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-[60px] py-6">
        <nav class="flex flex-wrap items-center gap-1 text-sm text-[#898989] mb-4">
          <a href="/" class="hover:text-[#FFAE01] transition-colors">Главная</a>
          <svg class="w-3.5 h-3.5 text-[#d0d0d0]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          <span class="text-slate-900 font-medium">Услуги</span>
        </nav>
        <h1 class="text-2xl lg:text-[32px] font-bold text-slate-900">Наши услуги</h1>
        <p class="mt-2 text-[#898989]">Монтаж кровли, фасада и водосточных систем в Москве и МО</p>
      </div>
    </div>

    <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-[60px] py-8">

      <!-- Сетка услуг -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 mb-10">
        {services.map((service) => (
          <a
            href={`/uslugi/${service.id.replace(/\.mdx?$/, '')}`}
            class="group bg-white rounded-[10px] border border-[#e5e5e5] hover:border-[#FFAE01] hover:shadow-sm transition-all p-6 flex flex-col"
          >
            <div class="w-11 h-11 bg-[#FFAE01]/10 rounded-[8px] flex items-center justify-center mb-4">
              <svg class="w-5 h-5 text-[#FFAE01]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
              </svg>
            </div>

            <h2 class="font-bold text-slate-900 group-hover:text-[#FFAE01] transition-colors leading-snug mb-2">
              {service.data.title}
            </h2>

            {service.data.shortDescription && (
              <p class="text-sm text-[#898989] flex-1 line-clamp-3 leading-relaxed mb-4">
                {service.data.shortDescription}
              </p>
            )}

            <div class="flex items-center justify-between mt-auto pt-4 border-t border-[#f0f0f0]">
              {service.data.priceFrom && (
                <span class="text-sm font-semibold text-[#FFAE01]">{service.data.priceFrom}</span>
              )}
              <span class="ml-auto text-sm font-semibold text-[#FFAE01] flex items-center gap-1">
                Подробнее
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
              </span>
            </div>
          </a>
        ))}
      </div>

      <!-- CTA -->
      <div class="bg-[#333333] text-white rounded-[10px] p-8 flex flex-col sm:flex-row items-center justify-between gap-6">
        <div>
          <h2 class="font-bold text-xl mb-2">Нужна консультация?</h2>
          <p class="text-[#898989] text-sm">Бесплатно выедем для замера и расчёта стоимости работ</p>
        </div>
        <a
          href="tel:88003339495"
          class="shrink-0 bg-[#FFAE01] hover:bg-[#e09d00] text-black font-semibold px-8 py-3 rounded-[5px] transition-colors whitespace-nowrap"
        >
          Позвонить
        </a>
      </div>

    </div>
  </div>
</BaseLayout>
