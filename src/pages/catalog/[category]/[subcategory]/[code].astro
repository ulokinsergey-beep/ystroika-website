<script define:vars={{ displayPrice, isByArea, effectiveWidth, standardLengths }}>

// ── Вспомогательные функции ─────────────────────────────────────────────────
function fmtPrice(n) {
  return n.toLocaleString('ru-RU', { maximumFractionDigits: 2 }) + ' ₽';
}
function fmtArea(n) {
  return n.toFixed(3).replace('.', ',');
}

// ── Инициализация строки длины ──────────────────────────────────────────────
function initRow(row, isFirst) {
  const select = row.querySelector('.length-select');
  const qtyInput = row.querySelector('.qty-input');
  const minusBtn = row.querySelector('.qty-minus');
  const plusBtn = row.querySelector('.qty-plus');
  const rowAreaEl = row.querySelector('.row-area');
  const rowTotalEl = row.querySelector('.row-total');
  const removeBtn = row.querySelector('.remove-row');

  function updateRow() {
    const lengthM = parseFloat(select?.value || '1000') / 1000;
    const qty = Math.max(1, parseInt(qtyInput?.value || '1', 10));
    const area = qty * lengthM * effectiveWidth;
    if (rowAreaEl) rowAreaEl.textContent = fmtArea(area);
    if (rowTotalEl) {
      rowTotalEl.textContent = displayPrice ? fmtPrice(area * displayPrice) : 'по запросу';
    }
  }

  select?.addEventListener('change', updateRow);
  qtyInput?.addEventListener('input', updateRow);
  minusBtn?.addEventListener('click', () => {
    const v = parseInt(qtyInput?.value || '1', 10);
    if (v > 1 && qtyInput) { qtyInput.value = String(v - 1); updateRow(); }
  });
  plusBtn?.addEventListener('click', () => {
    const v = parseInt(qtyInput?.value || '1', 10);
    if (qtyInput) { qtyInput.value = String(v + 1); updateRow(); }
  });
  removeBtn?.addEventListener('click', () => {
    row.remove();
  });

  updateRow();
}

// ── Инициализируем первую строку ────────────────────────────────────────────
if (isByArea) {
  const container = document.getElementById('length-rows');
  const firstRow = container?.querySelector('.length-row');
  if (firstRow) initRow(firstRow, true);

  // ── Кнопка "+" добавить строку ─────────────────────────────────────────
  const addBtn = document.getElementById('add-row-btn');
  addBtn?.addEventListener('click', () => {
    const template = container?.querySelector('.length-row');
    if (!template || !container) return;

    const newRow = template.cloneNode(true);

    // Добавить кнопку удаления строки
    const grid = newRow.querySelector('.grid');
    if (grid && !newRow.querySelector('.remove-row')) {
      const removeBtn = document.createElement('button');
      removeBtn.className = 'remove-row self-end pb-2 text-[#898989] hover:text-white transition-colors text-lg leading-none flex-shrink-0';
      removeBtn.textContent = '×';
      grid.style.gridTemplateColumns = '1fr auto auto auto';
      grid.appendChild(removeBtn);
    }

    // Сбросить значения
    const qtyInput = newRow.querySelector('.qty-input');
    if (qtyInput) qtyInput.value = '1';

    container.appendChild(newRow);
    initRow(newRow, false);
  });
}

// ── Табы ────────────────────────────────────────────────────────────────────
const tabsNav = document.getElementById('tabs-nav');
if (tabsNav) {
  tabsNav.addEventListener('click', (e) => {
    const btn = e.target.closest('[data-tab]');
    if (!btn) return;
    const idx = btn.dataset.tab;
    tabsNav.querySelectorAll('[data-tab]').forEach(b => {
      const active = b.dataset.tab === idx;
      b.classList.toggle('text-[#333333]', active);
      b.classList.toggle('border-[#FFAE01]', active);
      b.classList.toggle('text-[#898989]', !active);
      b.classList.toggle('border-transparent', !active);
    });
    document.querySelectorAll('[data-tab-content]').forEach(c => {
      c.classList.toggle('hidden', c.dataset.tabContent !== idx);
    });
  });
}

// ── Простой счётчик (штучные товары) ────────────────────────────────────────
const minusS = document.getElementById('qty-minus-s');
const plusS = document.getElementById('qty-plus-s');
const qtyS = document.getElementById('qty-simple');
if (minusS && plusS && qtyS) {
  minusS.addEventListener('click', () => {
    const v = parseInt(qtyS.value, 10);
    if (v > 1) qtyS.value = String(v - 1);
  });
  plusS.addEventListener('click', () => {
    qtyS.value = String(parseInt(qtyS.value, 10) + 1);
  });
}
</script>

<!-- Цены/наличие для блока «Вам может понадобиться» -->
<script define:vars={{ relatedKods }}>
  (async function () {
    if (!relatedKods || !relatedKods.length) return;
    const fmt = (n) => n.toLocaleString('ru-RU') + ' ₽';
    function fillCard(card, priceData, stockQty) {
      const skeleton = card.querySelector('.price-skeleton');
      const loaded   = card.querySelector('.price-loaded');
      const noPrice  = card.querySelector('.no-price');
      const origEl   = card.querySelector('.original-price');
      const dispEl   = card.querySelector('.price-display');
      const discBadge= card.querySelector('.discount-badge');
      const stockBadge = card.querySelector('.stock-badge');
      if (skeleton) skeleton.classList.add('hidden');
      if (priceData && (priceData.price > 0 || priceData.discounted_price > 0)) {
        if (loaded) loaded.classList.remove('hidden');
        const hasDiscount = priceData.discounted_price > 0 && priceData.discounted_price < priceData.price;
        if (hasDiscount) {
          if (origEl) { origEl.textContent = fmt(priceData.price); origEl.classList.remove('hidden'); }
          if (dispEl) dispEl.textContent = fmt(priceData.discounted_price);
          if (discBadge) discBadge.classList.remove('hidden');
        } else {
          const price = priceData.discounted_price > 0 ? priceData.discounted_price : priceData.price;
          if (dispEl) dispEl.textContent = fmt(price);
        }
      } else if (noPrice) {
        noPrice.classList.remove('hidden');
      }
      if (stockQty > 0 && stockBadge) {
        stockBadge.classList.remove('hidden');
        stockBadge.classList.add('inline-flex');
      }
    }
    try {
      const [pricesRes, stockRes] = await Promise.allSettled([
        fetch('/api/catalog/prices', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ kods: relatedKods }) }).then(r => r.ok ? r.json() : { prices: {} }),
        fetch('/api/catalog/stock',  { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ kods: relatedKods }) }).then(r => r.ok ? r.json() : { stock: {} }),
      ]);
      const prices = pricesRes.status === 'fulfilled' ? (pricesRes.value?.prices ?? {}) : {};
      const stock  = stockRes.status === 'fulfilled'  ? (stockRes.value?.stock  ?? {}) : {};
      document.querySelectorAll('[data-product-kod]').forEach(card => {
        const kod = card.getAttribute('data-product-kod');
        if (kod && relatedKods.includes(kod)) fillCard(card, prices[kod], stock[kod]);
      });
    } catch (e) {}
  })();
</script>
