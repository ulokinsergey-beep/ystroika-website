---
export const prerender = false;

import { readFileSync, existsSync } from 'node:fs';
import { resolve } from 'node:path';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { categories } from '../../../../data/categories';
import { fetchPrices, fetchStock } from '../../../../lib/kroval';
import { snapshotItemByVendor, snapshotItemsFor, humanUnit, SPEC_LABELS, PACK_LABELS } from '../../../../lib/snapshot';
import ProductCard from '../../../../components/catalog/ProductCard.astro';
import AdvantagesBlock from '../../../../components/AdvantagesBlock.astro';

const { category: categorySlug, subcategory: subcategorySlug, code } = Astro.params;

const category = categories.find(c => c.slug === categorySlug);
const subcategory = category?.subcategories?.find(s => s.slug === subcategorySlug);

if (!category || !subcategory) {
  return new Response(null, { status: 404 });
}

let product: any = null;
let relatedProducts: any[] = [];

// ─── ИСТОЧНИК 1 (авторитетный): СНИМОК. Сайт читает только снимок — цена/фото/ТХ оттуда.
let snapItem = snapshotItemByVendor(code!) ?? null;
if (snapItem && snapItem.category === `${categorySlug}/${subcategorySlug}`) {
  product = {
    kod: snapItem.vendor,
    name: snapItem.name ?? snapItem.vendor,
    artikul: snapItem.vendor,
    unit: humanUnit(snapItem.unit),
    brand: snapItem.brand ?? '',
    image: snapItem.images[0] ?? null,
    description: snapItem.description ?? null,
  };
  relatedProducts = snapshotItemsFor(categorySlug!, subcategorySlug!)
    .filter(i => i.vendor !== code)
    .slice(0, 4)
    .map(i => ({
      kod: i.vendor, name: i.name ?? i.vendor, artikul: i.vendor,
      unit: humanUnit(i.unit), brand: i.brand ?? '',
      image: i.images[0] ?? null, price: i.price, serverPriced: true,
    }));
} else {
  snapItem = null;
  // ─── ИСТОЧНИК 2 (запасной): старый локальный файл + живой API — для товаров, ещё не в снимке.
  const dataPath = resolve('src/data/catalog', categorySlug!, `${subcategorySlug}.json`);
  if (existsSync(dataPath)) {
    try {
      const data = JSON.parse(readFileSync(dataPath, 'utf-8'));
      const list = data.products ?? [];
      product = list.find((p: any) => p.kod === code);
      relatedProducts = list.filter((p: any) => p.kod !== code).slice(0, 4);
    } catch {}
  }
}

if (!product) {
  return new Response(null, { status: 404 });
}

const relatedKods = relatedProducts.map((p: any) => p.kod).filter(Boolean);

let priceData: { price: number; discounted_price: number } | null = null;
let stockData: Record<string, number> = {};

if (snapItem) {
  // Döcke: цена из снимка (РРЦ→округление); null = «по запросу». Остатки не тянем.
  if (snapItem.price && snapItem.price > 0) {
    priceData = { price: snapItem.price, discounted_price: 0 };
  }
} else {
  try {
    const [prices, stocks] = await Promise.allSettled([
      fetchPrices([product.kod]),
      fetchStock([product.kod]),
    ]);
    if (prices.status === 'fulfilled' && prices.value.length > 0) {
      priceData = prices.value[0];
    }
    if (stocks.status === 'fulfilled') {
      stockData = stocks.value;
    }
  } catch {}
}

const basePrice = priceData?.price ?? null;
const discountedPrice = (priceData?.discounted_price ?? 0) > 0 ? priceData!.discounted_price : null;
const hasDiscount = !!(discountedPrice && basePrice && discountedPrice < basePrice);
const displayPrice = hasDiscount ? discountedPrice! : basePrice;
const discountPercent = hasDiscount ? Math.round((1 - discountedPrice! / basePrice!) * 100) : 0;

const stockQty = product.kod ? (stockData[product.kod] ?? null) : null;
const inStock = stockQty !== null ? stockQty > 0 : null;

// ─── Характеристики из снимка (Döcke): только реальные поля поставщика ─────
const snapSpecs: Record<string, string> = (snapItem?.specs as Record<string, string>) ?? {};
function specRow(k: string, map: Record<string, { label: string; unit?: string }>) {
  const v = snapSpecs[k];
  if (!v) return null;
  const m = map[k];
  if (!m) return null;
  return { label: m.label, value: m.unit ? `${v} ${m.unit}` : String(v) };
}
const snapSpecRows: { label: string; value: string }[] = [];
const snapPackRows: { label: string; value: string }[] = [];
if (snapItem) {
  const hasDims = snapSpecs.length && snapSpecs.width;
  if (hasDims) snapSpecRows.push({ label: 'Рабочие размеры', value: `${snapSpecs.length}×${snapSpecs.width} мм` });
  for (const k of ['thickness', 'area', 'material', 'series', 'foundation', 'topping', 'bitumen_type', 'm2_roll_area', 'country_of_origin', 'warranty']) {
    const r = specRow(k, SPEC_LABELS);
    if (r) snapSpecRows.push(r);
  }
  if (!hasDims) for (const k of ['length', 'width']) { const r = specRow(k, SPEC_LABELS); if (r) snapSpecRows.push(r); }
  if (snapItem.collection) snapSpecRows.push({ label: 'Коллекция', value: snapItem.collection });
  if (snapItem.color) snapSpecRows.push({ label: 'Цвет', value: snapItem.color });
  for (const k of Object.keys(PACK_LABELS)) { const r = specRow(k, PACK_LABELS); if (r) snapPackRows.push(r); }
}
// короткая форма гарантии для мини-панели («50 лет» из длинного текста)
const warrantyShort = snapSpecs.warranty ? (snapSpecs.warranty.match(/^\d+\s*(?:лет|год[а]?)/)?.[0] ?? null) : null;

// Парсим характеристики из названия
const widthMatch = product.name?.match(/\(ширина\s+([\d.,]+)м?\)/i);
const effectiveWidth: number = widthMatch ? parseFloat(widthMatch[1].replace(',', '.')) : 1.19;

const thicknessMatch = product.name?.match(/\b0[,.](\d{1,2})\b/);
const thickness = thicknessMatch ? `0,${thicknessMatch[1]}` : null;

const coatings = ['Satin', 'PE', 'Pural', 'Drap', 'Matt', 'PURMAN', 'Colorcoat'];
const coatingFound = product.name
  ? coatings.find((c: string) => product.name.toLowerCase().includes(c.toLowerCase()))
  : null;

const ralMatch = product.name?.match(/RAL\s*(\d{4})/i);
const colorRal = ralMatch ? `RAL ${ralMatch[1]}` : null;

const isByArea = product.unit === 'м2' && product.areaEnabled;
const isByLength = product.unit === 'м' && product.lengthEnabled;

// Стандартные длины листа в мм (как в Figma — 470мм первым)
const standardLengths = [
  { mm: 470, label: '470 мм' },
  { mm: 500, label: '500 мм' },
  { mm: 1000, label: '1000 мм' },
  { mm: 1500, label: '1500 мм' },
  { mm: 2000, label: '2000 мм' },
  { mm: 2500, label: '2500 мм' },
  { mm: 3000, label: '3000 мм' },
  { mm: 3500, label: '3500 мм' },
  { mm: 4000, label: '4000 мм' },
  { mm: 4500, label: '4500 мм' },
  { mm: 5000, label: '5000 мм' },
  { mm: 5500, label: '5500 мм' },
  { mm: 6000, label: '6000 мм' },
];

const canonicalURL = `https://ystroika.ru/catalog/${categorySlug}/${subcategorySlug}/${encodeURIComponent(code!)}/`;

// Product + (Offer только при реальной цене — не выдумываем price/availability, см. docs/seo/07) + BreadcrumbList
const hasRealPrice = typeof displayPrice === 'number' && displayPrice > 0;
const productImg = product.image && product.image.startsWith('/') ? `https://ystroika.ru${product.image}` : (product.image || undefined);
const productLd: any = {
  '@type': 'Product',
  'name': product.name,
  'sku': product.kod,
  'mpn': product.artikul || undefined,
  'image': productImg,
  'description': `${product.name} — купить в Москве и МО.${product.brand ? ' Производитель: ' + product.brand + '.' : ''}`,
  'brand': product.brand ? { '@type': 'Brand', 'name': product.brand } : undefined,
};
if (hasRealPrice) {
  productLd.offers = {
    '@type': 'Offer',
    'url': canonicalURL,
    'priceCurrency': 'RUB',
    'price': String(displayPrice),
    'seller': { '@type': 'Organization', 'name': 'У-Стройка', 'url': 'https://ystroika.ru' },
    // availability не указываем: остатки не отслеживаем (не выдумываем наличие)
  };
}
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    productLd,
    {
      '@type': 'BreadcrumbList',
      'itemListElement': [
        { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://ystroika.ru/' },
        { '@type': 'ListItem', position: 2, name: 'Каталог', item: 'https://ystroika.ru/catalog/' },
        { '@type': 'ListItem', position: 3, name: category.title, item: `https://ystroika.ru/catalog/${categorySlug}/` },
        { '@type': 'ListItem', position: 4, name: subcategory.title, item: `https://ystroika.ru/catalog/${categorySlug}/${subcategorySlug}/` },
        { '@type': 'ListItem', position: 5, name: product.name, item: canonicalURL },
      ],
    },
  ],
};
---

<BaseLayout
  title={`${product.name} — купить в Москве`}
  description={`${product.name}. Код ${product.kod}.${product.brand ? ' Производитель: ' + product.brand + '.' : ''} Купить в Москве и МО с доставкой за 1 день. Звоните: 8-800-333-94-95.`}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <!-- Белый фон как в Figma -->
  <div class="bg-white min-h-screen">
    <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-[60px] py-6">

      <!-- Хлебные крошки с точками-разделителями (как в Figma) -->
      <nav class="flex flex-wrap items-center gap-0 text-sm text-[#898989] mb-4">
        <a href="/" class="hover:text-[#FFAE01] transition-colors">Главная</a>
        <span class="mx-2 w-1 h-1 rounded-full bg-[#898989] shrink-0 inline-block"></span>
        <a href="/catalog" class="hover:text-[#FFAE01] transition-colors">Каталог</a>
        <span class="mx-2 w-1 h-1 rounded-full bg-[#898989] shrink-0 inline-block"></span>
        <a href={`/catalog/${categorySlug}`} class="hover:text-[#FFAE01] transition-colors">{category.title}</a>
        <span class="mx-2 w-1 h-1 rounded-full bg-[#898989] shrink-0 inline-block"></span>
        <a href={`/catalog/${categorySlug}/${subcategorySlug}`} class="hover:text-[#FFAE01] transition-colors">{subcategory.title}</a>
        {product.brand && (
          <>
            <span class="mx-2 w-1 h-1 rounded-full bg-[#898989] shrink-0 inline-block"></span>
            <span class="text-[#333333]">{product.brand}</span>
          </>
        )}
      </nav>

      <!-- Заголовок товара (Montserrat SemiBold 30px, как в Figma) -->
      <h1 style="font-family: var(--font-heading);" class="text-[26px] lg:text-[30px] font-semibold text-[#333333] leading-snug mb-4">
        {product.name}
      </h1>

      <!-- Разделительная линия (как в Figma) -->
      <hr class="border-[#E9E9E9] mb-4" />

      <!-- Инфо-строка: рейтинг + действия | статус + код + цена -->
      <div class="flex flex-wrap items-center justify-between gap-3 mb-6">
        <!-- Левая часть: рейтинг и действия -->
        <div class="flex flex-wrap items-center gap-4 text-sm text-[#898989]">
          <div class="flex items-center gap-1.5">
            <div class="flex items-center gap-0.5">
              {[1,2,3,4,5].map((i) => (
                <svg class="w-3.5 h-3.5 text-[#FFAE01]" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                </svg>
              ))}
            </div>
            <span class="text-[#333333] font-semibold text-sm">5.0</span>
            <span class="text-[#898989]">0 отзывов</span>
          </div>
          <button class="flex items-center gap-1.5 hover:text-[#333333] transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/>
            </svg>
            Поделиться
          </button>
          <button class="flex items-center gap-1.5 hover:text-[#333333] transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
            </svg>
            В избранное
          </button>
          <button class="flex items-center gap-1.5 hover:text-[#333333] transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
            </svg>
            Сравнить
          </button>
        </div>
        <!-- Правая часть: наличие + код + цена -->
        <div class="flex flex-wrap items-center gap-4 text-sm">
          <div class={`flex items-center gap-1.5 font-medium ${inStock === false ? 'text-amber-600' : 'text-green-600'}`}>
            <span class={`w-2 h-2 rounded-full ${inStock === false ? 'bg-amber-500' : 'bg-green-500'}`}></span>
            {inStock === false ? 'Уточните наличие' : 'В наличии'}
          </div>
          {product.kod && (
            <span class="text-[#898989]">Код товара: <span class="text-[#333333]">{product.kod}</span></span>
          )}
          {basePrice && (
            <div class="flex items-center gap-2">
              {hasDiscount && (
                <>
                  <span class="text-[#898989] line-through text-sm">{basePrice.toLocaleString('ru-RU')} ₽/шт</span>
                  <span class="bg-red-500 text-white text-xs font-bold px-1.5 py-0.5 rounded">-{discountPercent}%</span>
                </>
              )}
              <span class="text-[18px] font-bold text-[#333333]">{displayPrice!.toLocaleString('ru-RU')} ₽</span>
            </div>
          )}
          {!basePrice && <span class="text-[#898989]">Цена по запросу</span>}
        </div>
      </div>

      <!-- Основная двухколоночная сетка: галерея (лево) + правая колонка -->
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_400px] items-start gap-5 mb-6">

        <!-- Галерея -->
        <div class="flex gap-3">
          <!-- Вертикальный ряд превью -->
          <div class="flex flex-col gap-2 shrink-0">
            {[1,2,3,4,5].map((i) => (
              <div class={`w-[68px] h-[68px] rounded-[5px] border-2 cursor-pointer transition-colors ${i === 1 ? 'border-[#FFAE01]' : 'border-[#E9E9E9] hover:border-[#FFAE01]'} bg-[#f5f5f5] flex items-center justify-center`}>
                <svg class="w-6 h-6 text-[#d0d0d0]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="0.75" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                </svg>
              </div>
            ))}
          </div>
          <!-- Основное фото (реальное из снимка, иначе заглушка) -->
          <div class="relative flex-1 min-h-[340px] lg:min-h-[400px] bg-[#f5f5f5] rounded-[5px] flex items-center justify-center overflow-hidden">
            {hasDiscount && (
              <div class="absolute top-3 left-3 bg-red-500 text-white text-xs font-bold px-3 py-1 rounded-[3px] z-10">
                Скидка
              </div>
            )}
            {product.image ? (
              <img src={product.image} alt={product.name} class="absolute inset-0 w-full h-full object-contain p-6" />
            ) : (
              <svg class="w-20 h-20 text-[#d0d0d0]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="0.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
              </svg>
            )}
          </div>
        </div>

        <!-- Правая колонка: панель + аккордеоны + мини-характеристики (как в Figma) -->
        <div class="flex flex-col gap-3">

        <!-- Панель покупки (тёмная, как в Figma) -->
        <div class="relative bg-[#333333] rounded-[5px] p-5 text-white">

          <!-- "%" значок — поверх панели сверху-справа (как в Figma) -->
          <div class="absolute -top-3 -right-3 w-10 h-10 bg-[#FFAE01] rounded-full flex items-center justify-center shadow-md z-10">
            <span class="text-[#333333] font-bold text-sm">%</span>
          </div>

          <!-- Строки выбора длины листа -->
          {isByArea && (
            <div id="length-rows" class="flex flex-col gap-3 mb-3">
              <!-- Первая строка (шаблон) -->
              <div class="length-row">
                <div class="grid grid-cols-[1fr_auto_auto] gap-2 items-end">
                  <div>
                    <label class="text-[10px] text-[#898989] mb-1 block uppercase tracking-wide">Выберите длину листа</label>
                    <select class="length-select w-full bg-[#464646] border border-[#565656] text-white rounded-[3px] px-2 py-2 text-sm focus:outline-none focus:border-[#FFAE01] cursor-pointer">
                      {standardLengths.map(l => (
                        <option value={l.mm}>{l.label}</option>
                      ))}
                    </select>
                  </div>
                  <div>
                    <label class="text-[10px] text-[#898989] mb-1 block uppercase tracking-wide">Количество листов</label>
                    <div class="flex items-stretch h-9">
                      <button class="qty-minus w-8 bg-[#464646] hover:bg-[#565656] border border-r-0 border-[#565656] rounded-l-[3px] flex items-center justify-center text-white transition-colors text-lg leading-none">−</button>
                      <input type="number" value="1" min="1" class="qty-input w-10 h-full bg-[#464646] border-y border-[#565656] text-white text-center text-sm focus:outline-none [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none" />
                      <button class="qty-plus w-8 bg-[#464646] hover:bg-[#565656] border border-l-0 border-[#565656] rounded-r-[3px] flex items-center justify-center text-white transition-colors text-lg leading-none">+</button>
                    </div>
                  </div>
                  <div class="min-w-[90px]">
                    <label class="text-[10px] text-[#898989] mb-1 block uppercase tracking-wide">Итого за <span class="row-area">0,00</span> м²</label>
                    <div class="h-9 flex items-center">
                      <span class="row-total text-white font-bold text-sm">—</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          )}

          <!-- Простой счётчик для штучных товаров -->
          {!isByArea && !isByLength && (
            <div class="mb-4">
              <label class="text-[10px] text-[#898989] mb-1 block uppercase tracking-wide">Количество, {product.unit}</label>
              <div class="flex items-stretch h-9 w-36">
                <button id="qty-minus-s" class="w-9 bg-[#464646] hover:bg-[#565656] border border-r-0 border-[#565656] rounded-l-[3px] flex items-center justify-center text-white transition-colors text-lg">−</button>
                <input id="qty-simple" type="number" value="1" min="1" class="w-14 h-full bg-[#464646] border-y border-[#565656] text-white text-center text-sm focus:outline-none [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none" />
                <button id="qty-plus-s" class="w-9 bg-[#464646] hover:bg-[#565656] border border-l-0 border-[#565656] rounded-r-[3px] flex items-center justify-center text-white transition-colors text-lg">+</button>
              </div>
            </div>
          )}

          <!-- Ввод длины для погонных товаров -->
          {isByLength && (
            <div class="mb-4">
              <label class="text-[10px] text-[#898989] mb-1 block uppercase tracking-wide">Длина, м</label>
              <input type="number" value="1" min="0.1" step="0.1" class="w-full bg-[#464646] border border-[#565656] text-white rounded-[3px] px-3 py-2 text-sm focus:outline-none focus:border-[#FFAE01]" />
            </div>
          )}

          <!-- Ссылки: добавить строку + калькулятор -->
          {isByArea && (
            <div class="flex items-center justify-between mb-4 gap-2">
              <button id="add-row-btn" class="flex items-center gap-1 text-xs text-[#898989] hover:text-white transition-colors">
                <span class="text-base leading-none">+</span>
                Добавить лист другой длины
              </button>
              <a href="/raschet" class="flex items-center gap-1 text-xs text-[#FFAE01] hover:opacity-80 transition-opacity whitespace-nowrap">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
                Рассчитать в калькуляторе кровли
              </a>
            </div>
          )}

          <!-- Кнопки действий -->
          <div class="flex gap-2">
            <button data-add-cart data-kod={product.kod} data-name={product.name} data-url={Astro.url.pathname} data-unit={product.unit}
              class="flex-1 bg-[#FFAE01] hover:bg-[#e09d00] text-black font-semibold py-3 rounded-[3px] transition-colors text-sm">
              Добавить в корзину
            </button>
