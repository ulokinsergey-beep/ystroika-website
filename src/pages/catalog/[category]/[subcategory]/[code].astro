---
export const prerender = false;

import { readFileSync, existsSync } from 'node:fs';
import { resolve } from 'node:path';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { categories } from '../../../../data/categories';
import { fetchPrices, fetchStock } from '../../../../lib/kroval';

const { category: categorySlug, subcategory: subcategorySlug, code } = Astro.params;

const category = categories.find(c => c.slug === categorySlug);
const subcategory = category?.subcategories?.find(s => s.slug === subcategorySlug);

if (!category || !subcategory) {
  return new Response(null, { status: 404 });
}

const dataPath = resolve('src/data/catalog', categorySlug!, `${subcategorySlug}.json`);
let product: any = null;

if (existsSync(dataPath)) {
  try {
    const raw = readFileSync(dataPath, 'utf-8');
    const data = JSON.parse(raw);
    product = (data.products ?? []).find((p: any) => p.kod === code);
  } catch {}
}

if (!product) {
  return new Response(null, { status: 404 });
}

let priceData: { price: number; discounted_price: number } | null = null;
let stockData: Record<string, number> = {};

try {
  const [prices, stocks] = await Promise.allSettled([
    fetchPrices([product.kod]),
    fetchStock([product.kod]),
  ]);
  if (prices.status === 'fulfilled' && prices.value.length > 0) {
    priceData = prices.value[0];
  }
  if (stocks.status === 'fulfilled') {
    stockData = stocks.value;
  }
} catch {}

const basePrice = priceData?.price ?? null;
const discountedPrice = (priceData?.discounted_price ?? 0) > 0 ? priceData!.discounted_price : null;
const hasDiscount = !!(discountedPrice && basePrice && discountedPrice < basePrice);
const displayPrice = hasDiscount ? discountedPrice! : basePrice;
const discountPercent = hasDiscount ? Math.round((1 - discountedPrice! / basePrice!) * 100) : 0;

const stockQty = product.kod ? (stockData[product.kod] ?? null) : null;
const inStock = stockQty !== null ? stockQty > 0 : null;

// Parse characteristics from product name
const widthMatch = product.name?.match(/\(ширина\s+([\d.,]+)м?\)/i);
const effectiveWidth: number = widthMatch
  ? parseFloat(widthMatch[1].replace(',', '.'))
  : 1.19;

const thicknessMatch = product.name?.match(/\b0[,.](\d{2})\b/);
const thickness = thicknessMatch ? `0,${thicknessMatch[1]} мм` : null;

const coatings = ['Satin', 'PE', 'Pural', 'Drap', 'Matt', 'PURMAN', 'Colorcoat'];
const coatingFound = product.name
  ? coatings.find((c: string) => product.name.toLowerCase().includes(c.toLowerCase()))
  : null;

const ralMatch = product.name?.match(/RAL\s*(\d{4})/i);
const colorRal = ralMatch ? `RAL ${ralMatch[1]}` : null;

const isByArea = product.unit === 'м2' && product.areaEnabled;
const isByLength = product.unit === 'м' && product.lengthEnabled;

const standardLengths = [0.5, 1.0, 1.5, 2.0, 2.5, 3.0, 3.5, 4.0, 4.5, 5.0, 5.5, 6.0];

const canonicalURL = `https://ystroika.ru/catalog/${categorySlug}/${subcategorySlug}/${encodeURIComponent(code!)}/`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  'name': product.name,
  'sku': product.kod,
  'mpn': product.artikul || undefined,
  'description': `${product.name} — купить в Москве и МО. Артикул: ${product.kod}.${product.brand ? ' Производитель: ' + product.brand + '.' : ''}`,
  'brand': product.brand ? { '@type': 'Brand', 'name': product.brand } : undefined,
  'offers': {
    '@type': 'Offer',
    'url': canonicalURL,
    'priceCurrency': 'RUB',
    'price': displayPrice ?? undefined,
    'availability': inStock === false
      ? 'https://schema.org/OutOfStock'
      : 'https://schema.org/InStock',
    'seller': { '@type': 'Organization', 'name': 'У-Стройка', 'url': 'https://ystroika.ru' },
  },
};
---

<BaseLayout
  title={`${product.name} — купить в Москве`}
  description={`${product.name}. Артикул ${product.kod}.${product.brand ? ' Производитель: ' + product.brand + '.' : ''} Купить в Москве и МО с доставкой за 1 день. Звоните: 8-800-333-94-95.`}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <div class="bg-[#f5f5f5] min-h-screen">

    <!-- Breadcrumb header -->
    <div class="bg-white border-b border-[#e5e5e5]">
      <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-[60px] py-4">
        <nav class="flex flex-wrap items-center gap-1 text-sm text-[#898989]">
          <a href="/" class="hover:text-[#FFAE01] transition-colors">Главная</a>
          <svg class="w-3.5 h-3.5 text-[#d0d0d0]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          <a href="/catalog" class="hover:text-[#FFAE01] transition-colors">Каталог</a>
          <svg class="w-3.5 h-3.5 text-[#d0d0d0]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          <a href={`/catalog/${categorySlug}`} class="hover:text-[#FFAE01] transition-colors">{category.title}</a>
          <svg class="w-3.5 h-3.5 text-[#d0d0d0]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          <a href={`/catalog/${categorySlug}/${subcategorySlug}`} class="hover:text-[#FFAE01] transition-colors">{subcategory.title}</a>
          <svg class="w-3.5 h-3.5 text-[#d0d0d0]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          <span class="text-slate-900 font-medium truncate max-w-[240px]">{product.name}</span>
        </nav>
      </div>
    </div>

    <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-[60px] py-6">

      <!-- Gallery + Purchase panel -->
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_380px] gap-5 mb-5">

        <!-- Gallery -->
        <div class="bg-white rounded-[10px] border border-[#e5e5e5] p-4 flex gap-3 min-h-[420px]">
          <!-- Thumbnails column -->
          <div class="flex flex-col gap-2 shrink-0">
            {[1,2,3,4,5].map((i) => (
              <div class={`w-[68px] h-[68px] rounded-[5px] border-2 ${i === 1 ? 'border-[#FFAE01]' : 'border-[#e5e5e5]'} bg-[#f5f5f5] flex items-center justify-center cursor-pointer hover:border-[#FFAE01] transition-colors`}>
                <svg class="w-6 h-6 text-[#d0d0d0]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="0.75" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                </svg>
              </div>
            ))}
          </div>
          <!-- Main image -->
          <div class="relative flex-1 bg-[#f5f5f5] rounded-[5px] flex items-center justify-center">
            {hasDiscount && (
              <div class="absolute top-3 left-3 bg-red-500 text-white text-xs font-bold px-2 py-1 rounded-[5px] z-10">
                -{discountPercent}%
              </div>
            )}
            <svg class="w-20 h-20 text-[#d0d0d0]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="0.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
          </div>
        </div>

        <!-- Purchase panel (dark) -->
        <div class="bg-[#333333] rounded-[10px] p-6 flex flex-col text-white">

          {product.brand && (
            <span class="text-[10px] font-bold text-[#FFAE01] uppercase tracking-widest mb-2">{product.brand}</span>
          )}

          <h1 class="text-base font-bold text-white leading-snug mb-3">{product.name}</h1>

          <!-- Rating row -->
          <div class="flex items-center justify-between mb-3">
            <div class="flex items-center gap-0.5">
              {[1,2,3,4,5].map(() => (
                <svg class="w-3 h-3 text-[#FFAE01]" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                </svg>
              ))}
              <span class="text-[11px] text-[#898989] ml-1.5">0 отзывов</span>
            </div>
            <div class="flex items-center gap-3 text-[#898989]">
              <button class="hover:text-white transition-colors" title="В избранное">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                </svg>
              </button>
              <button class="hover:text-white transition-colors" title="Сравнить">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
                </svg>
              </button>
            </div>
          </div>

          <!-- Stock + code -->
          <div class="flex items-center justify-between mb-4 pb-4 border-b border-[#464646]">
            <div class={`flex items-center gap-1.5 text-xs font-semibold ${inStock === false ? 'text-amber-400' : 'text-green-400'}`}>
              <span class={`w-1.5 h-1.5 rounded-full ${inStock === false ? 'bg-amber-400' : 'bg-green-400'}`}></span>
              {inStock === false ? 'Уточните наличие' : 'В наличии'}
            </div>
            <span class="text-[11px] text-[#898989]">Код: <span class="text-[#d0d0d0]">{product.kod}</span></span>
          </div>

          <!-- Price -->
          <div class="mb-5">
            {displayPrice ? (
              <div class="flex items-baseline gap-2">
                {hasDiscount && (
                  <span class="text-sm text-[#898989] line-through">{basePrice!.toLocaleString('ru-RU')} ₽</span>
                )}
                <span class="text-2xl font-bold text-[#FFAE01]">{displayPrice.toLocaleString('ru-RU')} ₽</span>
                <span class="text-sm text-[#898989]">за {product.unit}</span>
              </div>
            ) : (
              <span class="text-sm text-[#898989]">Цена по запросу</span>
            )}
          </div>

          <!-- Area calculator for м2 products -->
          {isByArea && (
            <div class="flex flex-col gap-3 mb-5">
              <div>
                <label class="text-[11px] text-[#898989] mb-1.5 block">Выберите длину листа</label>
                <select
                  id="sheet-length"
                  class="w-full bg-[#464646] border border-[#565656] text-white rounded-[5px] px-3 py-2.5 text-sm focus:outline-none focus:border-[#FFAE01] cursor-pointer"
                >
                  {standardLengths.map(l => (
                    <option value={l}>{l.toFixed(1).replace('.', ',')} м</option>
                  ))}
                </select>
              </div>
              <div>
                <label class="text-[11px] text-[#898989] mb-1.5 block">Количество листов</label>
                <div class="flex items-stretch">
                  <button id="qty-minus" class="w-10 bg-[#464646] hover:bg-[#565656] border border-r-0 border-[#565656] rounded-l-[5px] flex items-center justify-center text-white transition-colors">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4"/>
                    </svg>
                  </button>
                  <input
                    id="sheet-qty"
                    type="number"
                    value="1"
                    min="1"
                    class="w-16 h-10 bg-[#464646] border-y border-[#565656] text-white text-center text-sm focus:outline-none focus:border-[#FFAE01] [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none"
                  />
                  <button id="qty-plus" class="w-10 bg-[#464646] hover:bg-[#565656] border border-l-0 border-[#565656] rounded-r-[5px] flex items-center justify-center text-white transition-colors">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                    </svg>
                  </button>
                </div>
              </div>
              <div class="bg-[#464646] rounded-[5px] px-4 py-3 flex items-center justify-between">
                <span class="text-xs text-[#898989]">Итого за <span id="total-area">0,00</span> м²</span>
                <span class="text-base font-bold text-white" id="total-price">—</span>
              </div>
              <button class="text-xs text-[#FFAE01] hover:opacity-80 text-left transition-opacity">
                + Добавить лист другой длины
              </button>
            </div>
          )}

          <!-- Linear length input -->
          {isByLength && (
            <div class="mb-5">
              <label class="text-[11px] text-[#898989] mb-1.5 block">Длина, м</label>
              <input
                id="linear-length"
                type="number"
                value="1"
                min="0.1"
                step="0.1"
                class="w-full bg-[#464646] border border-[#565656] text-white rounded-[5px] px-3 py-2.5 text-sm focus:outline-none focus:border-[#FFAE01]"
              />
            </div>
          )}

          <!-- Simple quantity for piece products -->
          {!isByArea && !isByLength && (
            <div class="mb-5">
              <label class="text-[11px] text-[#898989] mb-1.5 block">Количество, {product.unit}</label>
              <div class="flex items-stretch">
                <button id="qty-minus-s" class="w-10 bg-[#464646] hover:bg-[#565656] border border-r-0 border-[#565656] rounded-l-[5px] flex items-center justify-center text-white transition-colors">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4"/>
                  </svg>
                </button>
                <input id="qty-simple" type="number" value="1" min="1"
                  class="w-16 h-10 bg-[#464646] border-y border-[#565656] text-white text-center text-sm focus:outline-none [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none"
                />
                <button id="qty-plus-s" class="w-10 bg-[#464646] hover:bg-[#565656] border border-l-0 border-[#565656] rounded-r-[5px] flex items-center justify-center text-white transition-colors">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                  </svg>
                </button>
              </div>
            </div>
          )}

          <!-- Action buttons -->
          <div class="flex flex-col gap-2 mt-auto">
            <button class="w-full bg-[#FFAE01] hover:bg-[#e09d00] text-black font-semibold px-6 py-3 rounded-[5px] transition-colors text-sm">
              Добавить в корзину
            </button>
            <a
              href="tel:88003339495"
              class="w-full inline-flex items-center justify-center gap-2 border border-[#565656] hover:border-white text-white font-semibold px-6 py-3 rounded-[5px] transition-colors text-sm"
            >
              <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
              Получить консультацию
            </a>
          </div>

          <!-- Delivery + Payment accordions -->
          <div class="mt-5 pt-4 border-t border-[#464646] flex flex-col gap-2">
            <details class="group">
              <summary class="flex items-center justify-between cursor-pointer text-sm text-[#d0d0d0] hover:text-white transition-colors list-none py-1">
                <div class="flex items-center gap-2">
                  <svg class="w-4 h-4 text-[#FFAE01] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"/>
                  </svg>
                  Информация о доставке
                </div>
                <svg class="w-4 h-4 transition-transform group-open:rotate-180 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
              </summary>
              <div class="mt-2 text-xs text-[#898989] leading-relaxed pl-6">
                Доставка по Москве и МО от 1 дня. Самовывоз со склада. Уточнить сроки и стоимость — по телефону.
              </div>
            </details>
            <details class="group">
              <summary class="flex items-center justify-between cursor-pointer text-sm text-[#d0d0d0] hover:text-white transition-colors list-none py-1">
                <div class="flex items-center gap-2">
                  <svg class="w-4 h-4 text-[#FFAE01] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/>
                  </svg>
                  Варианты оплаты
                </div>
                <svg class="w-4 h-4 transition-transform group-open:rotate-180 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
              </summary>
              <div class="mt-2 text-xs text-[#898989] leading-relaxed pl-6">
                Наличные, безналичный расчёт, банковская карта. Для юридических лиц — по счёту.
              </div>
            </details>
          </div>

        </div>
      </div>

      <!-- Specs grid -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-5">
        {colorRal ? (
          <div class="bg-white rounded-[10px] border border-[#e5e5e5] p-4">
            <div class="text-xs text-[#898989] mb-1">Цвет</div>
            <div class="font-semibold text-slate-900 text-sm">{colorRal}</div>
          </div>
        ) : (
          <div class="bg-white rounded-[10px] border border-[#e5e5e5] p-4">
            <div class="text-xs text-[#898989] mb-1">Единица</div>
            <div class="font-semibold text-slate-900 text-sm">{product.unit}</div>
          </div>
        )}
        <div class="bg-white rounded-[10px] border border-[#e5e5e5] p-4">
          <div class="text-xs text-[#898989] mb-1">Покрытие</div>
          <div class="font-semibold text-slate-900 text-sm">{coatingFound ?? '—'}</div>
        </div>
        <div class="bg-white rounded-[10px] border border-[#e5e5e5] p-4">
          <div class="text-xs text-[#898989] mb-1">Толщина</div>
          <div class="font-semibold text-slate-900 text-sm">{thickness ?? '—'}</div>
        </div>
        <div class="bg-white rounded-[10px] border border-[#e5e5e5] p-4">
          <div class="text-xs text-[#898989] mb-1">Гарантия</div>
          <div class="font-semibold text-slate-900 text-sm">до 50 лет</div>
        </div>
      </div>

      <!-- Tabs + sidebar -->
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_280px] gap-5">

        <!-- Tabs -->
        <div class="bg-white rounded-[10px] border border-[#e5e5e5]">
          <div class="flex border-b border-[#e5e5e5]" id="tabs-nav">
            {['Описание', 'Характеристики', 'Отзывы'].map((tab, i) => (
              <button
                data-tab={String(i)}
                class={`px-5 py-3.5 text-sm font-semibold transition-colors border-b-2 -mb-px ${i === 0 ? 'text-slate-900 border-[#FFAE01]' : 'text-[#898989] border-transparent hover:text-slate-900'}`}
              >
                {tab}
              </button>
            ))}
          </div>

          <!-- Description tab -->
          <div data-tab-content="0" class="p-6">
            <div class="prose prose-sm prose-slate max-w-none">
              <p>
                <strong>{product.name}</strong> — профессиональный кровельный материал{product.brand ? ` производства ${product.brand}` : ''}.
                {isByArea && ` Эффективная ширина листа — ${effectiveWidth} м.`}
                {coatingFound && ` Покрытие: ${coatingFound}.`}
                {thickness && ` Толщина металла: ${thickness}.`}
              </p>
              <p>Подходит для жилых домов, дач, коттеджей, хозяйственных построек. Монтируется поверх обрешётки.</p>
              {isByArea && (
                <p>Продаётся в квадратных метрах. Воспользуйтесь калькулятором выше или свяжитесь с нашими специалистами для расчёта.</p>
              )}
            </div>
            {isByArea && (
              <div class="mt-5">
                <a href="/raschet" class="inline-flex items-center gap-2 text-sm font-semibold text-[#FFAE01] hover:opacity-80 transition-opacity">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 11h.01M12 11h.01M15 11h.01M4 19h16a2 2 0 002-2V7a2 2 0 00-2-2H4a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                  </svg>
                  Рассчитать в калькуляторе кровли
                </a>
              </div>
            )}
          </div>

          <!-- Characteristics tab -->
          <div data-tab-content="1" class="p-6 hidden">
            <table class="w-full text-sm">
              <tbody>
                <tr class="border-b border-[#f5f5f5]">
                  <td class="py-2.5 pr-4 text-[#898989] w-1/2">Код товара</td>
                  <td class="py-2.5 font-medium text-slate-900 font-mono text-xs">{product.kod}</td>
                </tr>
                {product.artikul && (
                  <tr class="border-b border-[#f5f5f5]">
                    <td class="py-2.5 pr-4 text-[#898989]">Артикул</td>
                    <td class="py-2.5 font-medium text-slate-900">{product.artikul}</td>
                  </tr>
                )}
                {product.brand && (
                  <tr class="border-b border-[#f5f5f5]">
                    <td class="py-2.5 pr-4 text-[#898989]">Производитель</td>
                    <td class="py-2.5 font-medium text-slate-900">{product.brand}</td>
                  </tr>
                )}
                <tr class="border-b border-[#f5f5f5]">
                  <td class="py-2.5 pr-4 text-[#898989]">Единица измерения</td>
                  <td class="py-2.5 font-medium text-slate-900">{product.unit}</td>
                </tr>
                {coatingFound && (
                  <tr class="border-b border-[#f5f5f5]">
                    <td class="py-2.5 pr-4 text-[#898989]">Покрытие</td>
                    <td class="py-2.5 font-medium text-slate-900">{coatingFound}</td>
                  </tr>
                )}
                {thickness && (
                  <tr class="border-b border-[#f5f5f5]">
                    <td class="py-2.5 pr-4 text-[#898989]">Толщина металла</td>
                    <td class="py-2.5 font-medium text-slate-900">{thickness}</td>
                  </tr>
                )}
                {isByArea && (
                  <tr class="border-b border-[#f5f5f5]">
                    <td class="py-2.5 pr-4 text-[#898989]">Ширина листа (эфф.)</td>
                    <td class="py-2.5 font-medium text-slate-900">{effectiveWidth} м</td>
                  </tr>
                )}
                {colorRal && (
                  <tr class="border-b border-[#f5f5f5]">
                    <td class="py-2.5 pr-4 text-[#898989]">Цвет</td>
                    <td class="py-2.5 font-medium text-slate-900">{colorRal}</td>
                  </tr>
                )}
              </tbody>
            </table>
          </div>

          <!-- Reviews tab -->
          <div data-tab-content="2" class="p-6 hidden">
            <p class="text-sm text-[#898989]">Отзывов пока нет. Будьте первым!</p>
          </div>
        </div>

        <!-- Sidebar -->
        <div class="flex flex-col gap-4">
          <div class="bg-white rounded-[10px] border border-[#e5e5e5] p-5">
            <h3 class="text-sm font-bold text-slate-900 mb-2">Фотокаталог</h3>
            <p class="text-xs text-[#898989] mb-3">Скачайте PDF-каталог с цветами и образцами покрытий</p>
            <button class="w-full inline-flex items-center justify-center gap-2 border border-[#e5e5e5] hover:border-[#FFAE01] text-slate-700 hover:text-[#FFAE01] font-semibold px-4 py-2.5 rounded-[5px] transition-colors text-sm">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
              </svg>
              Скачать каталог
            </button>
          </div>

          <div class="bg-white rounded-[10px] border border-[#e5e5e5] p-5">
            <h3 class="text-sm font-bold text-slate-900 mb-3">Документы</h3>
            <ul class="flex flex-col gap-2.5">
              {['Сертификат соответствия', 'Инструкция по монтажу', 'Гарантийный талон'].map(doc => (
                <li>
                  <button class="flex items-center gap-2 text-xs text-[#898989] hover:text-[#FFAE01] transition-colors">
                    <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                    </svg>
                    {doc}
                  </button>
                </li>
              ))}
            </ul>
          </div>

          <a href={`/catalog/${categorySlug}/${subcategorySlug}`} class="inline-flex items-center gap-2 text-sm font-semibold text-[#FFAE01] hover:opacity-80 transition-opacity">
            <svg class="w-4 h-4 rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
            Назад в «{subcategory.title}»
          </a>
        </div>
      </div>

    </div>
  </div>
</BaseLayout>

<script define:vars={{ displayPrice, isByArea, effectiveWidth }}>
// Tabs
const tabsNav = document.getElementById('tabs-nav');
if (tabsNav) {
  tabsNav.addEventListener('click', (e) => {
    const btn = e.target.closest('[data-tab]');
    if (!btn) return;
    const idx = btn.dataset.tab;
    tabsNav.querySelectorAll('[data-tab]').forEach(b => {
      const active = b.dataset.tab === idx;
      b.classList.toggle('text-slate-900', active);
      b.classList.toggle('border-[#FFAE01]', active);
      b.classList.toggle('text-[#898989]', !active);
      b.classList.toggle('border-transparent', !active);
    });
    document.querySelectorAll('[data-tab-content]').forEach(c => {
      c.classList.toggle('hidden', c.dataset.tabContent !== idx);
    });
  });
}

// Area calculator
if (isByArea) {
  const lengthSel = document.getElementById('sheet-length');
  const qtyInput = document.getElementById('sheet-qty');
  const minusBtn = document.getElementById('qty-minus');
  const plusBtn = document.getElementById('qty-plus');
  const totalAreaEl = document.getElementById('total-area');
  const totalPriceEl = document.getElementById('total-price');

  function updateCalc() {
    const length = parseFloat(lengthSel?.value || '1');
    const qty = Math.max(1, parseInt(qtyInput?.value || '1', 10));
    const area = qty * length * effectiveWidth;
    if (totalAreaEl) totalAreaEl.textContent = area.toFixed(2).replace('.', ',');
    if (totalPriceEl) {
      if (displayPrice) {
        const total = area * displayPrice;
        totalPriceEl.textContent = total.toLocaleString('ru-RU', { maximumFractionDigits: 0 }) + ' ₽';
      } else {
        totalPriceEl.textContent = 'по запросу';
      }
    }
  }

  lengthSel?.addEventListener('change', updateCalc);
  qtyInput?.addEventListener('input', updateCalc);
  minusBtn?.addEventListener('click', () => {
    const v = parseInt(qtyInput?.value || '1', 10);
    if (v > 1 && qtyInput) { qtyInput.value = String(v - 1); updateCalc(); }
  });
  plusBtn?.addEventListener('click', () => {
    const v = parseInt(qtyInput?.value || '1', 10);
    if (qtyInput) { qtyInput.value = String(v + 1); updateCalc(); }
  });

  updateCalc();
}

// Simple quantity stepper
const minusS = document.getElementById('qty-minus-s');
const plusS = document.getElementById('qty-plus-s');
const qtyS = document.getElementById('qty-simple');
if (minusS && plusS && qtyS) {
  minusS.addEventListener('click', () => {
    const v = parseInt(qtyS.value, 10);
    if (v > 1) qtyS.value = String(v - 1);
  });
  plusS.addEventListener('click', () => {
    qtyS.value = String(parseInt(qtyS.value, 10) + 1);
  });
}
</script>
