---
/**
 * Карточка товара — СТАТИЧЕСКАЯ (Timeweb MVP).
 * getStaticPaths только по курируемому demo-набору (≤150 карточек), цена из снимка.
 * Полные карточки всех 31.8k товаров со SSR — позже на Cloudflare.
 */
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { categories } from '../../../../data/categories';
import { humanUnit, SPEC_LABELS, PACK_LABELS } from '../../../../lib/snapshot';
import type { SnapshotItem } from '../../../../lib/snapshot';
import { demoItems, demoItemsFor, toCard } from '../../../../lib/demo';
import ProductCard from '../../../../components/catalog/ProductCard.astro';
import AdvantagesBlock from '../../../../components/AdvantagesBlock.astro';

export function getStaticPaths() {
  const paths: any[] = [];
  for (const item of demoItems) {
    const parts = (item.category || '').split('/');
    if (parts.length !== 2 || !item.vendor) continue;
    const [catSlug, subSlug] = parts;
    const category = categories.find(c => c.slug === catSlug);
    const subcategory = category?.subcategories?.find(s => s.slug === subSlug);
    if (!category || !subcategory) continue;
    paths.push({
      params: { category: catSlug, subcategory: subSlug, code: item.vendor },
      props: { item, category, subcategory },
    });
  }
  return paths;
}

const { item, category, subcategory } = Astro.props as { item: SnapshotItem; category: any; subcategory: any };
const categorySlug = category.slug;
const subcategorySlug = subcategory.slug;
const code = item.vendor;
const snapItem = item;

const product: any = {
  kod: snapItem.vendor,
  name: snapItem.name ?? snapItem.vendor,
  artikul: snapItem.vendor,
  unit: humanUnit(snapItem.unit),
  brand: snapItem.brand ?? '',
  image: snapItem.images?.[0] ?? null,
  description: snapItem.description ?? null,
};

const relatedProducts = demoItemsFor(categorySlug, subcategorySlug)
  .filter(i => i.vendor !== code)
  .slice(0, 4)
  .map(toCard);

// Цена из снимка (РРЦ→округление); null = «по запросу». Остатки не показываем.
const basePrice = (snapItem.price && snapItem.price > 0) ? snapItem.price : null;
const hasDiscount = false;
const discountPercent = 0;
const displayPrice = basePrice;
const inStock: boolean | null = null;

// Характеристики из снимка
const snapSpecs: Record<string, string> = (snapItem?.specs as Record<string, string>) ?? {};
function specRow(k: string, map: Record<string, { label: string; unit?: string }>) {
  const v = snapSpecs[k];
  if (!v) return null;
  const m = map[k];
  if (!m) return null;
  return { label: m.label, value: m.unit ? `${v} ${m.unit}` : String(v) };
}
const snapSpecRows: { label: string; value: string }[] = [];
const snapPackRows: { label: string; value: string }[] = [];
{
  const hasDims = snapSpecs.length && snapSpecs.width;
  if (hasDims) snapSpecRows.push({ label: 'Рабочие размеры', value: `${snapSpecs.length}×${snapSpecs.width} мм` });
  for (const k of ['thickness', 'area', 'material', 'series', 'foundation', 'topping', 'bitumen_type', 'm2_roll_area', 'country_of_origin', 'warranty']) {
    const r = specRow(k, SPEC_LABELS);
    if (r) snapSpecRows.push(r);
  }
  if (!hasDims) for (const k of ['length', 'width']) { const r = specRow(k, SPEC_LABELS); if (r) snapSpecRows.push(r); }
  if (snapItem.collection) snapSpecRows.push({ label: 'Коллекция', value: snapItem.collection });
  if (snapItem.color) snapSpecRows.push({ label: 'Цвет', value: snapItem.color });
  for (const k of Object.keys(PACK_LABELS)) { const r = specRow(k, PACK_LABELS); if (r) snapPackRows.push(r); }
}
const warrantyShort = snapSpecs.warranty ? (snapSpecs.warranty.match(/^\d+\s*(?:лет|год[а]?)/)?.[0] ?? null) : null;

// Парсинг из названия (для не-снимочных полей)
const coatings = ['Satin', 'PE', 'Pural', 'Drap', 'Matt', 'PURMAN', 'Colorcoat'];
const coatingFound = product.name ? coatings.find((c: string) => product.name.toLowerCase().includes(c.toLowerCase())) : null;
const thicknessMatch = product.name?.match(/\b0[,.](\d{1,2})\b/);
const thickness = thicknessMatch ? `0,${thicknessMatch[1]}` : null;
const ralMatch = product.name?.match(/RAL\s*(\d{4})/i);
const colorRal = ralMatch ? `RAL ${ralMatch[1]}` : null;

const canonicalURL = `https://y-stroika.ru/catalog/${categorySlug}/${subcategorySlug}/${encodeURIComponent(code!)}/`;

const hasRealPrice = typeof displayPrice === 'number' && displayPrice > 0;
const productImg = product.image && product.image.startsWith('/') ? `https://y-stroika.ru${product.image}` : (product.image || undefined);
const productLd: any = {
  '@type': 'Product',
  'name': product.name,
  'sku': product.kod,
  'mpn': product.artikul || undefined,
  'image': productImg,
  'description': `${product.name} — купить в Москве и МО.${product.brand ? ' Производитель: ' + product.brand + '.' : ''}`,
  'brand': product.brand ? { '@type': 'Brand', 'name': product.brand } : undefined,
};
if (hasRealPrice) {
  productLd.offers = {
    '@type': 'Offer',
    'url': canonicalURL,
    'priceCurrency': 'RUB',
    'price': String(displayPrice),
    'seller': { '@type': 'Organization', 'name': 'У-Стройка', 'url': 'https://y-stroika.ru' },
  };
}
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    productLd,
    {
      '@type': 'BreadcrumbList',
      'itemListElement': [
        { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://y-stroika.ru/' },
        { '@type': 'ListItem', position: 2, name: 'Каталог', item: 'https://y-stroika.ru/catalog/' },
        { '@type': 'ListItem', position: 3, name: category.title, item: `https://y-stroika.ru/catalog/${categorySlug}/` },
        { '@type': 'ListItem', position: 4, name: subcategory.title, item: `https://y-stroika.ru/catalog/${categorySlug}/${subcategorySlug}/` },
        { '@type': 'ListItem', position: 5, name: product.name, item: canonicalURL },
      ],
    },
  ],
};
---

<BaseLayout
  title={`${product.name} — купить в Москве`}
  description={`${product.name}. Код ${product.kod}.${product.brand ? ' Производитель: ' + product.brand + '.' : ''} Купить в Москве и МО с доставкой за 1 день. Звоните: 8-800-333-94-95.`}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />
  <link rel="canonical" slot="head" href={canonicalURL} />

  <div class="bg-white min-h-screen">
    <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-[60px] py-6">

      <!-- Хлебные крошки -->
      <nav class="flex flex-wrap items-center gap-0 text-sm text-[#898989] mb-4">
        <a href="/" class="hover:text-[#FFAE01] transition-colors">Главная</a>
        <span class="mx-2 w-1 h-1 rounded-full bg-[#898989] shrink-0 inline-block"></span>
        <a href="/catalog" class="hover:text-[#FFAE01] transition-colors">Каталог</a>
        <span class="mx-2 w-1 h-1 rounded-full bg-[#898989] shrink-0 inline-block"></span>
        <a href={`/catalog/${categorySlug}`} class="hover:text-[#FFAE01] transition-colors">{category.title}</a>
        <span class="mx-2 w-1 h-1 rounded-full bg-[#898989] shrink-0 inline-block"></span>
        <a href={`/catalog/${categorySlug}/${subcategorySlug}`} class="hover:text-[#FFAE01] transition-colors">{subcategory.title}</a>
        {product.brand && (
          <>
            <span class="mx-2 w-1 h-1 rounded-full bg-[#898989] shrink-0 inline-block"></span>
            <span class="text-[#333333]">{product.brand}</span>
          </>
        )}
      </nav>

      <h1 style="font-family: var(--font-heading);" class="text-[26px] lg:text-[30px] font-semibold text-[#333333] leading-snug mb-4">
        {product.name}
      </h1>
      <hr class="border-[#E9E9E9] mb-4" />

      <!-- Инфо-строка -->
      <div class="flex flex-wrap items-center justify-between gap-3 mb-6">
        <div class="flex flex-wrap items-center gap-4 text-sm text-[#898989]">
          <div class="flex items-center gap-1.5">
            <div class="flex items-center gap-0.5">
              {[1,2,3,4,5].map(() => (
                <svg class="w-3.5 h-3.5 text-[#FFAE01]" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                </svg>
              ))}
            </div>
            <span class="text-[#333333] font-semibold text-sm">5.0</span>
            <span class="text-[#898989]">0 отзывов</span>
          </div>
        </div>
        <div class="flex flex-wrap items-center gap-4 text-sm">
          <div class="flex items-center gap-1.5 font-medium text-[#898989]">
            <span class="w-2 h-2 rounded-full bg-[#C0C0C0]"></span>
            Наличие уточняется
          </div>
          {product.kod && (
            <span class="text-[#898989]">Код товара: <span class="text-[#333333]">{product.kod}</span></span>
          )}
          {basePrice ? (
            <div class="flex items-center gap-2">
              <span class="text-[18px] font-bold text-[#333333]">{displayPrice!.toLocaleString('ru-RU')} ₽</span>
            </div>
          ) : (
            <span class="text-[#898989]">Цена по запросу</span>
          )}
        </div>
      </div>

      <!-- Галерея + правая колонка -->
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_400px] items-start gap-5 mb-6">
        <div class="flex gap-3">
          <div class="flex flex-col gap-2 shrink-0">
            {[1,2,3,4,5].map((i) => (
              <div class={`w-[68px] h-[68px] rounded-[5px] border-2 cursor-pointer transition-colors ${i === 1 ? 'border-[#FFAE01]' : 'border-[#E9E9E9] hover:border-[#FFAE01]'} bg-[#f5f5f5] flex items-center justify-center`}>
                <svg class="w-6 h-6 text-[#d0d0d0]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="0.75" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                </svg>
              </div>
            ))}
          </div>
          <div class="relative flex-1 min-h-[340px] lg:min-h-[400px] bg-[#f5f5f5] rounded-[5px] flex items-center justify-center overflow-hidden">
            {product.image ? (
              <img src={product.image} alt={product.name} class="absolute inset-0 w-full h-full object-contain p-6" />
            ) : (
              <svg class="w-20 h-20 text-[#d0d0d0]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="0.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
              </svg>
            )}
          </div>
        </div>

        <div class="flex flex-col gap-3">
          <!-- Панель покупки -->
          <div class="relative bg-[#333333] rounded-[5px] p-5 text-white">
            <div class="mb-4">
              <label class="text-[10px] text-[#898989] mb-1 block uppercase tracking-wide">Количество, {product.unit}</label>
              <div class="flex items-stretch h-9 w-36">
                <button id="qty-minus-s" class="w-9 bg-[#464646] hover:bg-[#565656] border border-r-0 border-[#565656] rounded-l-[3px] flex items-center justify-center text-white transition-colors text-lg">−</button>
                <input id="qty-simple" type="number" value="1" min="1" class="w-14 h-full bg-[#464646] border-y border-[#565656] text-white text-center text-sm focus:outline-none [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none" />
                <button id="qty-plus-s" class="w-9 bg-[#464646] hover:bg-[#565656] border border-l-0 border-[#565656] rounded-r-[3px] flex items-center justify-center text-white transition-colors text-lg">+</button>
              </div>
            </div>
            <div class="flex gap-2">
              <button data-add-cart data-kod={product.kod} data-name={product.name} data-url={canonicalURL} data-unit={product.unit}
                class="flex-1 bg-[#FFAE01] hover:bg-[#e09d00] text-black font-semibold py-3 rounded-[3px] transition-colors text-sm">
                Добавить в корзину
              </button>
              <a href="tel:88003339495" class="flex-1 inline-flex items-center justify-center border border-[#565656] hover:border-white text-white font-semibold py-3 rounded-[3px] transition-colors text-sm whitespace-nowrap">
                Консультация
              </a>
            </div>
          </div>

          <!-- Аккордеоны -->
          <div class="border border-[#E9E9E9] rounded-[5px] divide-y divide-[#E9E9E9]">
            <details class="group">
              <summary class="flex items-center justify-between px-5 py-3.5 cursor-pointer list-none text-sm text-[#333333] hover:bg-[#f9f9f9] transition-colors">
                Информация о доставке
                <svg class="w-4 h-4 text-[#898989] transition-transform group-open:rotate-180 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
              </summary>
              <div class="px-5 pb-4 text-sm text-[#898989] leading-relaxed">
                Доставка по Москве и МО от 1 дня. Самовывоз со склада. Уточнить сроки и стоимость — по телефону.
              </div>
            </details>
            <details class="group">
              <summary class="flex items-center justify-between px-5 py-3.5 cursor-pointer list-none text-sm text-[#333333] hover:bg-[#f9f9f9] transition-colors">
                Варианты оплаты
                <svg class="w-4 h-4 text-[#898989] transition-transform group-open:rotate-180 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
              </summary>
              <div class="px-5 pb-4 text-sm text-[#898989] leading-relaxed">
                Наличные, безналичный расчёт, банковская карта. Для юридических лиц — по счёту.
              </div>
            </details>
          </div>

          <!-- Мини-характеристики -->
          <div class="grid grid-cols-2 border border-[#E9E9E9] rounded-[5px]">
            <div class="px-4 py-3 border-r border-b border-[#E9E9E9]">
              <div class="text-xs text-[#898989] mb-1">Цвет</div>
              <div class="font-semibold text-[#333333] text-sm">{snapItem?.color ?? colorRal ?? '—'}</div>
            </div>
            <div class="px-4 py-3 border-b border-[#E9E9E9]">
              <div class="text-xs text-[#898989] mb-1">Серия</div>
              <div class="font-semibold text-[#333333] text-sm">{snapSpecs.series ?? '—'}</div>
            </div>
            <div class="px-4 py-3 border-r border-[#E9E9E9]">
              <div class="text-xs text-[#898989] mb-1">Толщина</div>
              <div class="font-semibold text-[#333333] text-sm">{snapSpecs.thickness ? `${snapSpecs.thickness} мм` : (thickness ? `${thickness} мм` : '—')}</div>
            </div>
            <div class="px-4 py-3">
              <div class="text-xs text-[#898989] mb-1">Гарантия</div>
              <div class="font-semibold text-[#333333] text-sm">{warrantyShort ?? '—'}</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Табы -->
      <div class="border border-[#E9E9E9] rounded-[5px] mb-6">
        <div class="flex border-b border-[#E9E9E9]" id="tabs-nav">
          {['Описание', 'Характеристики', 'Отзывы'].map((tab, i) => (
            <button data-tab={String(i)}
              class={`px-5 py-3.5 text-sm font-semibold transition-colors border-b-2 -mb-px ${i === 0 ? 'text-[#333333] border-[#FFAE01]' : 'text-[#898989] border-transparent hover:text-[#333333]'}`}>
              {tab}
            </button>
          ))}
        </div>

        <div data-tab-content="0" class="p-6">
          <div class="prose prose-sm max-w-none text-[#333333]">
            {snapItem?.description ? (
              <p><strong>{product.name}</strong> — {snapItem.description}</p>
            ) : (
              <>
                <p><strong>{product.name}</strong> — кровельный/фасадный материал{product.brand ? ` производства ${product.brand}` : ''}.{coatingFound ? ` Покрытие: ${coatingFound}.` : ''}{thickness ? ` Толщина металла: ${thickness} мм.` : ''}</p>
                <p>Подходит для жилых домов, дач, коттеджей, хозяйственных построек.</p>
              </>
            )}
          </div>
        </div>

        <div data-tab-content="1" class="p-6 hidden">
          <table class="w-full text-sm">
            <tbody>
              <tr class="border-b border-[#f5f5f5]">
                <td class="py-2.5 pr-4 text-[#898989] w-1/2">Код товара</td>
                <td class="py-2.5 font-medium text-[#333333] font-mono text-xs">{product.kod}</td>
              </tr>
              {product.brand && (
                <tr class="border-b border-[#f5f5f5]">
                  <td class="py-2.5 pr-4 text-[#898989]">Производитель</td>
                  <td class="py-2.5 font-medium text-[#333333]">{product.brand}</td>
                </tr>
              )}
              <tr class="border-b border-[#f5f5f5]">
                <td class="py-2.5 pr-4 text-[#898989]">Единица измерения</td>
                <td class="py-2.5 font-medium text-[#333333]">{product.unit}</td>
              </tr>
              {snapSpecRows.map(r => (
                <tr class="border-b border-[#f5f5f5]">
                  <td class="py-2.5 pr-4 text-[#898989]">{r.label}</td>
                  <td class="py-2.5 font-medium text-[#333333]">{r.value}</td>
                </tr>
              ))}
            </tbody>
          </table>

          {snapPackRows.length > 0 && (
            <>
              <h3 class="font-bold text-[#333333] text-base mt-6 mb-2">Информация об упаковке</h3>
              <table class="w-full text-sm">
                <tbody>
                  {snapPackRows.map(r => (
                    <tr class="border-b border-[#f5f5f5]">
                      <td class="py-2.5 pr-4 text-[#898989] w-1/2">{r.label}</td>
                      <td class="py-2.5 font-medium text-[#333333]">{r.value}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </>
          )}
        </div>

        <div data-tab-content="2" class="p-6 hidden">
          <p class="text-sm text-[#898989]">Отзывов пока нет. Будьте первым!</p>
        </div>
      </div>

      <!-- Вам может понадобиться -->
      {relatedProducts.length > 0 && (
        <section class="mt-10 mb-8">
          <div class="flex items-end gap-[25px] mb-6">
            <h2 class="font-[Montserrat] font-semibold text-[22px] lg:text-[28px] text-[#333333] leading-snug flex-shrink-0">
              Вам может понадобиться
            </h2>
            <div class="flex-1 h-px bg-[#E9E9E9] mb-2"></div>
          </div>
          <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3">
            {relatedProducts.map((p: any) => (
              <ProductCard
                kod={p.kod}
                name={p.name}
                artikul={p.artikul}
                unit={p.unit}
                brand={p.brand}
                categorySlug={categorySlug}
                subcategorySlug={subcategorySlug}
                image={p.image ?? null}
                price={p.price}
                serverPriced={true}
              />
            ))}
          </div>
        </section>
      )}

      <AdvantagesBlock />

      <a href={`/catalog/${categorySlug}/${subcategorySlug}`} class="inline-flex items-center gap-2 text-sm font-semibold text-[#FFAE01] hover:opacity-80 transition-opacity mt-8">
        <svg class="w-4 h-4 rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
        Назад в «{subcategory.title}»
      </a>

    </div>
  </div>
</BaseLayout>

<script>
  // Табы
  const tabsNav = document.getElementById('tabs-nav');
  if (tabsNav) {
    tabsNav.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('[data-tab]') as HTMLElement | null;
      if (!btn) return;
      const idx = btn.dataset.tab;
      tabsNav.querySelectorAll('[data-tab]').forEach(b => {
        const el = b as HTMLElement;
        const active = el.dataset.tab === idx;
        el.classList.toggle('text-[#333333]', active);
        el.classList.toggle('border-[#FFAE01]', active);
        el.classList.toggle('text-[#898989]', !active);
        el.classList.toggle('border-transparent', !active);
      });
      document.querySelectorAll('[data-tab-content]').forEach(c => {
        const el = c as HTMLElement;
        el.classList.toggle('hidden', el.dataset.tabContent !== idx);
      });
    });
  }
  // Простой счётчик
  const minusS = document.getElementById('qty-minus-s');
  const plusS = document.getElementById('qty-plus-s');
  const qtyS = document.getElementById('qty-simple') as HTMLInputElement | null;
  if (minusS && plusS && qtyS) {
    minusS.addEventListener('click', () => {
      const v = parseInt(qtyS.value, 10);
      if (v > 1) qtyS.value = String(v - 1);
    });
    plusS.addEventListener('click', () => {
      qtyS.value = String(parseInt(qtyS.value, 10) + 1);
    });
  }
</script>
