---
/**
 * Страница подкатегории каталога — SSR, пагинация 60 товаров/страница.
 * Данные: src/data/catalog/[category]/[subcategory].json (из process-catalog.mjs)
 * Цены + наличие: клиентский JS через /api/catalog/prices и /api/catalog/stock
 * Фильтр: ?brand=GrandLine (URL-параметр, SEO-friendly)
 */
export const prerender = false;

import { readFileSync, existsSync } from 'node:fs';
import { resolve } from 'node:path';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProductCard from '../../../components/catalog/ProductCard.astro';
import { categories } from '../../../data/categories';

const { category: categorySlug, subcategory: subcategorySlug } = Astro.params;

// Найти категорию и подкатегорию в нашем маппинге
const category = categories.find(c => c.slug === categorySlug);
const subcategory = category?.subcategories?.find(s => s.slug === subcategorySlug);

if (!category || !subcategory) {
  return new Response(null, { status: 404 });
}

// ─── Вспомогательная: извлечь бренд из товара ──────────────────────────────
function getBrand(p: any): string {
  if (p.brand && p.brand.trim()) return p.brand.trim();
  if (p.priceGroup) {
    const parts = (p.priceGroup as string).split('/').map((s: string) => s.trim());
    if (parts.length >= 3) return parts[2];
    if (parts.length === 2) return parts[1];
  }
  return '';
}

// ─── Загрузить данные о товарах из pre-generated JSON ───────────────────────
let allProducts: any[] = [];

const dataPath = resolve('src/data/catalog', categorySlug!, `${subcategorySlug}.json`);
if (existsSync(dataPath)) {
  try {
    const raw = readFileSync(dataPath, 'utf-8');
    const data = JSON.parse(raw);
    allProducts = data.products ?? [];
  } catch {}
}

// ─── Уникальные бренды (по убыванию количества товаров) ─────────────────────
// Служебные группы КА, которые не являются брендами
const SKIP_BRANDS = new Set([
  '-', '--', '...', 'Вся кровля', 'Вся продукция',
  'Упаковка', 'Доставка товара, Услуги', 'Аренда, хранение',
  'Бонус(ПАПКА)', 'Распродажи',
]);

const brandCountMap: Record<string, number> = {};
for (const p of allProducts) {
  const b = getBrand(p);
  if (!b) continue;
  // Пропускаем названия с нечитаемой кодировкой (непечатные символы)
  if (/[\x00-\x1f\x7f\uDC00-\uDFFF�]/.test(b)) continue;
  // Пропускаем служебные группы
  if (SKIP_BRANDS.has(b)) continue;
  // Пропускаем слишком общие пути из priceGroup
  if (b.includes(',') && b.length > 40) continue;
  brandCountMap[b] = (brandCountMap[b] ?? 0) + 1;
}
const availableBrands = Object.entries(brandCountMap)
  .filter(([, count]) => count >= 5)  // Не показываем бренды с < 5 товарами
  .sort((a, b) => b[1] - a[1])
  .map(([name, count]) => ({ name, count }));

// ─── Активный фильтр бренда ─────────────────────────────────────────────────
const selectedBrand = Astro.url.searchParams.get('brand') ?? '';

// ─── Применить фильтр ───────────────────────────────────────────────────────
const products = selectedBrand
  ? allProducts.filter((p: any) => getBrand(p) === selectedBrand)
  : allProducts;

const totalCount = products.length;

// ─── Пагинация ──────────────────────────────────────────────────────────────
const PAGE_SIZE = 60;
const page = Math.max(1, parseInt(Astro.url.searchParams.get('page') ?? '1'));
const totalPages = Math.ceil(totalCount / PAGE_SIZE);
const pageProducts = products.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE);
const kodsBatch = pageProducts.map((p: any) => p.kod).filter(Boolean);

// ─── Функция построения URL с сохранением/сменой параметров ─────────────────
function buildUrl(params: Record<string, string | null>) {
  const base = `/catalog/${categorySlug}/${subcategorySlug}`;
  const sp = new URLSearchParams();
  // Текущие params
  if (selectedBrand) sp.set('brand', selectedBrand);
  sp.set('page', String(page));
  // Overrides
  for (const [k, v] of Object.entries(params)) {
    if (v === null) sp.delete(k);
    else sp.set(k, v);
  }
  // Убираем page=1 из URL (не нужен)
  if (sp.get('page') === '1') sp.delete('page');
  const qs = sp.toString();
  return qs ? `${base}?${qs}` : base;
}

const canonicalURL = new URL(
  `/catalog/${categorySlug}/${subcategorySlug}/`,
  'https://ystroika.ru'
).href;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Главная", "item": "https://ystroika.ru/" },
        { "@type": "ListItem", "position": 2, "name": "Каталог", "item": "https://ystroika.ru/catalog/" },
        { "@type": "ListItem", "position": 3, "name": category.title, "item": `https://ystroika.ru/catalog/${categorySlug}/` },
        { "@type": "ListItem", "position": 4, "name": subcategory.title, "item": canonicalURL }
      ]
    },
    {
      "@type": "CollectionPage",
      "@id": canonicalURL,
      "name": `${subcategory.title} — купить в Москве · У-Стройка`,
      "description": `${subcategory.title} в Москве и МО. ${totalCount > 0 ? totalCount + ' позиций' : ''}. Широкий ассортимент, доставка 1 день, гарантия лучшей цены.`,
      "url": canonicalURL,
      "numberOfItems": totalCount,
    },
    ...(pageProducts.slice(0, 10).map((p: any, i: number) => ({
      "@type": "ListItem",
      "position": (page - 1) * PAGE_SIZE + i + 1,
      "item": {
        "@type": "Product",
        "name": p.name,
        "sku": p.kod,
        "brand": p.brand ? { "@type": "Brand", "name": p.brand } : undefined,
        "offers": {
          "@type": "Offer",
          "priceCurrency": "RUB",
          "availability": "https://schema.org/InStock",
          "seller": { "@type": "Organization", "name": "У-Стройка" }
        }
      }
    })))
  ]
};
---

<BaseLayout
  title={`${subcategory.title} — купить в Москве`}
  description={`${subcategory.title} — купить в Москве и МО по выгодным ценам. ${subcategory.brands?.length ? `Бренды: ${subcategory.brands.join(', ')}.` : ''} ${totalCount} позиций. Доставка 1 день. Звоните: 8-800-333-94-95.`}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <div class="bg-slate-50 min-h-screen">

    <!-- Шапка страницы -->
    <div class="bg-white border-b border-slate-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-5">
        <!-- Breadcrumb -->
        <nav class="flex flex-wrap items-center gap-1.5 text-sm text-slate-500 mb-3">
          <a href="/" class="hover:text-brand transition-colors">Главная</a>
          <svg class="w-3.5 h-3.5 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
          <a href="/catalog" class="hover:text-brand transition-colors">Каталог</a>
          <svg class="w-3.5 h-3.5 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
          <a href={`/catalog/${categorySlug}`} class="hover:text-brand transition-colors">{category.title}</a>
          <svg class="w-3.5 h-3.5 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
          <span class="text-slate-900 font-medium">{subcategory.title}</span>
        </nav>

        <div class="flex flex-wrap items-start justify-between gap-4">
          <div>
            <h1 class="text-2xl lg:text-3xl font-bold text-slate-900">{subcategory.title}</h1>
            <p class="mt-1 text-slate-500 text-sm">
              {category.title}
              {selectedBrand && (
                <> · <span class="font-medium text-brand">{selectedBrand}</span></>
              )}
              {' '}· {totalCount > 0 ? `${totalCount.toLocaleString('ru-RU')} позиций` : 'нет данных'} · Москва и МО
            </p>
          </div>
        </div>

        <!-- ─── Фильтр по бренду ─────────────────────────────────────────────── -->
        {availableBrands.length > 1 && (
          <div class="mt-4 -mx-4 sm:-mx-6 lg:-mx-8 px-4 sm:px-6 lg:px-8 pb-4 overflow-x-auto">
            <div class="flex items-center gap-2 min-w-max">
              <!-- Кнопка "Все бренды" -->
              <a
                href={buildUrl({ brand: null, page: '1' })}
                class={`inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg text-sm font-medium transition-colors whitespace-nowrap ${
                  !selectedBrand
                    ? 'bg-brand text-white'
                    : 'bg-slate-100 text-slate-600 hover:bg-slate-200'
                }`}
              >
                Все бренды
                <span class={`text-xs ${!selectedBrand ? 'text-white/70' : 'text-slate-400'}`}>
                  {allProducts.length.toLocaleString('ru-RU')}
                </span>
              </a>

              <!-- Кнопка каждого бренда -->
              {availableBrands.slice(0, 20).map(b => (
                <a
                  href={buildUrl({ brand: b.name, page: '1' })}
                  class={`inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg text-sm font-medium transition-colors whitespace-nowrap ${
                    selectedBrand === b.name
                      ? 'bg-brand text-white'
                      : 'bg-white border border-slate-200 text-slate-700 hover:border-brand hover:text-brand'
                  }`}
                >
                  {b.name}
                  <span class={`text-xs ${selectedBrand === b.name ? 'text-white/70' : 'text-slate-400'}`}>
                    {b.count.toLocaleString('ru-RU')}
                  </span>
                </a>
              ))}

              {/* Если брендов > 20, показываем сколько скрыто */}
              {availableBrands.length > 20 && (
                <span class="text-xs text-slate-400 pl-1">
                  +{availableBrands.length - 20} ещё
                </span>
              )}
            </div>
          </div>
        )}
      </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

      {totalCount === 0 ? (
        <!-- Нет данных -->
        <div class="bg-white border border-dashed border-slate-300 rounded-2xl p-12 text-center">
          <p class="text-slate-500 font-semibold text-lg">Товары загружаются</p>
          <p class="mt-2 text-slate-400 text-sm max-w-sm mx-auto">
            Ассортимент появится в ближайшее время. Для уточнения — позвоните нам.
          </p>
          <a href="tel:88003339495" class="mt-6 inline-flex items-center gap-2 bg-brand text-white font-semibold px-6 py-3 rounded-xl transition-colors">
            Позвонить
          </a>
        </div>
      ) : (
        <>
          <!-- Верхняя панель: счёт + пагинация -->
          <div class="flex items-center justify-between mb-5 flex-wrap gap-3">
            <p class="text-sm text-slate-500">
              {selectedBrand
                ? <>Бренд: <strong class="text-slate-700">{selectedBrand}</strong> · {totalCount.toLocaleString('ru-RU')} позиций</>
                : <>Показано {((page-1)*PAGE_SIZE+1).toLocaleString('ru-RU')}–{Math.min(page*PAGE_SIZE, totalCount).toLocaleString('ru-RU')} из {totalCount.toLocaleString('ru-RU')}</>
              }
            </p>
            {totalPages > 1 && (
              <div class="flex items-center gap-1">
                {page > 1 && (
                  <a
                    href={buildUrl({ page: String(page - 1) })}
                    class="px-3 py-1.5 text-sm border border-slate-200 rounded-lg hover:border-brand hover:text-brand transition-colors"
                  >
                    ← Назад
                  </a>
                )}
                <span class="px-3 py-1.5 text-sm font-medium text-brand bg-brand/10 rounded-lg">
                  {page} / {totalPages}
                </span>
                {page < totalPages && (
                  <a
                    href={buildUrl({ page: String(page + 1) })}
                    class="px-3 py-1.5 text-sm border border-slate-200 rounded-lg hover:border-brand hover:text-brand transition-colors"
                  >
                    Вперёд →
                  </a>
                )}
              </div>
            )}
          </div>

          <!-- Сетка товаров -->
          <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-3 lg:gap-4" id="products-grid">
            {pageProducts.map((p: any) => (
              <ProductCard
                kod={p.kod}
                name={p.name}
                artikul={p.artikul}
                unit={p.unit}
                brand={p.brand}
                priceGroup={p.priceGroup}
                categorySlug={categorySlug!}
                subcategorySlug={subcategorySlug!}
              />
            ))}
          </div>

          <!-- Нижняя пагинация -->
          {totalPages > 1 && (
            <div class="flex items-center justify-center gap-2 mt-10">
              {page > 1 && (
                <a href={buildUrl({ page: String(page - 1) })} class="px-4 py-2 text-sm border border-slate-200 rounded-xl hover:border-brand hover:text-brand transition-colors">
                  ← Назад
                </a>
              )}
              {Array.from({ length: Math.min(7, totalPages) }, (_, i) => {
                const p2 = Math.max(1, page - 3) + i;
                if (p2 > totalPages) return null;
                return (
                  <a
                    href={buildUrl({ page: String(p2) })}
                    class={`px-3.5 py-2 text-sm rounded-xl transition-colors ${p2 === page ? 'bg-brand text-white font-semibold' : 'border border-slate-200 hover:border-brand hover:text-brand'}`}
                  >
                    {p2}
                  </a>
                );
              })}
              {page < totalPages && (
                <a href={buildUrl({ page: String(page + 1) })} class="px-4 py-2 text-sm border border-slate-200 rounded-xl hover:border-brand hover:text-brand transition-colors">
                  Вперёд →
                </a>
              )}
            </div>
          )}

          <!-- Другие разделы -->
          {category.subcategories && category.subcategories.filter(s => s.slug !== subcategorySlug).length > 0 && (
            <div class="mt-12">
              <h2 class="text-lg font-semibold text-slate-900 mb-4">Другие разделы в «{category.title}»</h2>
              <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3">
                {category.subcategories.filter(s => s.slug !== subcategorySlug).map(s => (
                  <a
                    href={`/catalog/${categorySlug}/${s.slug}`}
                    class="group flex items-center justify-between bg-white border border-slate-200 rounded-xl px-4 py-3 hover:border-brand hover:shadow-sm transition-all"
                  >
                    <span class="text-sm font-medium text-slate-700 group-hover:text-brand">{s.title}</span>
                    <svg class="w-4 h-4 text-slate-400 group-hover:text-brand flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                    </svg>
                  </a>
                ))}
              </div>
            </div>
          )}
        </>
      )}

      <!-- CTA -->
      <div class="mt-12 bg-slate-900 text-white rounded-2xl p-8 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          <p class="font-bold text-lg">Нужна консультация по {subcategory.title.toLowerCase()}?</p>
          <p class="text-slate-400 text-sm mt-1">Поможем подобрать под ваш проект и бюджет, рассчитаем количество</p>
        </div>
        <a href="tel:88003339495" class="shrink-0 bg-brand hover:bg-brand-hover text-white font-semibold px-6 py-3 rounded-xl transition-colors">
          Позвонить
        </a>
      </div>

    </div>
  </div>

  <!-- Скрипт: подгружаем цены и наличие после рендера -->
  <script define:vars={{ kodsBatch }}>
    function fmt(n) {
      return n.toLocaleString('ru-RU') + ' ₽';
    }

    function fillCard(card, priceData, stockQty) {
      const skeleton  = card.querySelector('.price-skeleton');
      const loaded    = card.querySelector('.price-loaded');
      const noPrice   = card.querySelector('.no-price');
      const origEl    = card.querySelector('.original-price');
      const dispEl    = card.querySelector('.price-display');
      const discBadge = card.querySelector('.discount-badge');
      const stockBadge= card.querySelector('.stock-badge');

      // ── Цены ───────────────────────────────────────────────
      if (skeleton) skeleton.classList.add('hidden');

      if (priceData && (priceData.price > 0 || priceData.discounted_price > 0)) {
        if (loaded) loaded.classList.remove('hidden');

        const hasDiscount = priceData.discounted_price > 0 && priceData.discounted_price < priceData.price;

        if (hasDiscount) {
          // Зачёркнутая старая цена
          if (origEl) {
            origEl.textContent = fmt(priceData.price);
            origEl.classList.remove('hidden');
          }
          // Цена со скидкой — выделяем оранжевым
          if (dispEl) {
            dispEl.textContent = fmt(priceData.discounted_price);
            dispEl.classList.add('text-brand');
            dispEl.classList.remove('text-slate-900');
          }
          // Бейдж "АКЦИЯ"
          if (discBadge) discBadge.classList.remove('hidden');
        } else {
          // Только базовая цена
          const price = priceData.discounted_price > 0 ? priceData.discounted_price : priceData.price;
          if (dispEl) dispEl.textContent = fmt(price);
        }
      } else {
        // Нет данных о цене
        if (noPrice) noPrice.classList.remove('hidden');
      }

      // ── Наличие ─────────────────────────────────────────────
      if (stockQty !== undefined && stockBadge) {
        stockBadge.classList.remove('hidden');
        if (stockQty > 0) {
          stockBadge.textContent = 'В наличии';
          stockBadge.className = stockBadge.className.replace(/bg-\S+|text-\S+/g, '');
          stockBadge.classList.add(
            'stock-badge', 'absolute', 'top-2', 'right-2',
            'text-[10px]', 'font-semibold', 'px-1.5', 'py-0.5', 'rounded-md',
            'bg-green-100', 'text-green-700'
          );
        } else {
          stockBadge.textContent = 'Под заказ';
          stockBadge.classList.add(
            'stock-badge', 'absolute', 'top-2', 'right-2',
            'text-[10px]', 'font-semibold', 'px-1.5', 'py-0.5', 'rounded-md',
            'bg-slate-100', 'text-slate-500'
          );
        }
      }
    }

    document.addEventListener('DOMContentLoaded', async () => {
      if (!kodsBatch || kodsBatch.length === 0) return;

      // Грузим цены и наличие параллельно
      const [pricesRes, stockRes] = await Promise.allSettled([
        fetch('/api/catalog/prices', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ kods: kodsBatch }),
        }).then(r => r.ok ? r.json() : { prices: {} }),
        fetch('/api/catalog/stock', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ kods: kodsBatch }),
        }).then(r => r.ok ? r.json() : { stock: {} }),
      ]);

      const prices = pricesRes.status === 'fulfilled' ? (pricesRes.value?.prices ?? {}) : {};
      const stock  = stockRes.status === 'fulfilled'  ? (stockRes.value?.stock  ?? {}) : {};

      document.querySelectorAll('[data-product-kod]').forEach(card => {
        const kod = card.getAttribute('data-product-kod');
        if (!kod) return;
        fillCard(card, prices[kod], stock[kod]);
      });
    });
  </script>
</BaseLayout>
