---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryCard from '../../components/catalog/CategoryCard.astro';
import { categories } from '../../data/categories';

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Главная", "item": "https://y-stroika.ru/" },
        { "@type": "ListItem", "position": 2, "name": "Каталог", "item": "https://y-stroika.ru/catalog/" }
      ]
    },
    {
      "@type": "CollectionPage",
      "@id": "https://y-stroika.ru/catalog/",
      "name": "Каталог материалов — У-Стройка",
      "description": "Полный каталог кровельных, фасадных материалов и водостоков в Москве и МО.",
      "url": "https://y-stroika.ru/catalog/",
      "isPartOf": { "@id": "https://y-stroika.ru/#website" },
      "hasPart": categories.map(cat => ({
        "@type": "CollectionPage",
        "name": cat.title,
        "description": cat.description,
        "url": `https://y-stroika.ru/catalog/${cat.slug}/`
      }))
    }
  ]
};
---

<BaseLayout
  title="Каталог кровельных и фасадных материалов"
  description="Полный каталог кровельных, фасадных материалов и водостоков в Москве и МО. Металлочерепица, сайдинг, водосток, утепление. Широкий ассортимент, лучшие цены."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <div class="bg-[#f5f5f5] min-h-screen">
    <!-- Хлебные крошки + заголовок -->
    <div class="bg-white border-b border-[#e5e5e5]">
      <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-[60px] py-6">
        <nav class="flex flex-wrap items-center gap-1 text-sm text-[#898989] mb-4">
          <a href="/" class="hover:text-[#FFAE01] transition-colors">Главная</a>
          <svg class="w-3.5 h-3.5 text-[#d0d0d0]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
          <span class="text-slate-900 font-medium">Каталог</span>
        </nav>
        <h1 class="text-2xl lg:text-[32px] font-bold text-slate-900">Каталог материалов</h1>
        <p class="mt-2 text-[#898989]">
          {categories.length} разделов · Кровля, фасад, водосток и многое другое · Москва и МО
        </p>
      </div>
    </div>

    <!-- Сетка разделов -->
    <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-[60px] py-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {categories.map(cat => (
          <CategoryCard
            slug={cat.slug}
            title={cat.title}
            description={cat.description}
            icon={cat.icon}
            subcategoriesCount={cat.subcategories?.length ?? 0}
          />
        ))}
      </div>

      <!-- CTA -->
      <div class="mt-10 bg-slate-900 text-white rounded-[10px] p-8 flex flex-col sm:flex-row items-center justify-between gap-6">
        <div>
          <p class="font-bold text-xl">Не нашли нужный материал?</p>
          <p class="text-[#898989] text-sm mt-1 max-w-sm">
            Позвоните — менеджер подберёт по вашим характеристикам и бюджету
          </p>
        </div>
        <a
          href="tel:88003339495"
          class="shrink-0 inline-flex items-center gap-2 bg-[#FFAE01] hover:bg-[#e09d00] text-black font-semibold px-6 py-3 rounded-[5px] transition-colors whitespace-nowrap"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          8-800-333-94-95
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
