---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Страница не найдена — У-Стройка"
  description="Страница не существует. Воспользуйтесь каталогом или поиском на сайте У-Стройка."
>
  <div class="min-h-[70vh] flex items-center justify-center bg-[#f5f5f5]">
    <div class="max-w-md mx-auto px-4 text-center">
      <div class="text-8xl font-black text-[#e5e5e5] mb-4 leading-none">404</div>
      <h1 class="text-2xl font-bold text-slate-900 mb-2">Страница не найдена</h1>
      <p class="text-[#898989] mb-8">
        Возможно, страница была перемещена или удалена.
        Воспользуйтесь каталогом или позвоните нам.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a
          href="/catalog"
          class="inline-flex items-center justify-center gap-2 bg-[#FFAE01] hover:bg-[#e09d00] text-black font-semibold px-6 py-3 rounded-[5px] transition-colors"
        >
          Перейти в каталог
        </a>
        <a
          href="/"
          class="inline-flex items-center justify-center gap-2 border border-[#e5e5e5] hover:border-[#FFAE01] text-slate-700 hover:text-[#FFAE01] font-semibold px-6 py-3 rounded-[5px] transition-colors"
        >
          На главную
        </a>
      </div>
      <div class="mt-8 text-sm text-[#898989]">
        Или позвоните нам:
        <a href="tel:88003339495" class="text-[#FFAE01] font-medium hover:opacity-80 ml-1">8-800-333-94-95</a>
      </div>
    </div>
  </div>
</BaseLayout>
