---
/**
 * Страница услуги — /uslugi/[slug] — лендинг 1-в-1 по Figma (401:15673).
 * Контент секций восстановлен из макета. Сервис-специфика — из services collection.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdvantagesBlock from '../../components/AdvantagesBlock.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const services = await getCollection('services', ({ data }) => data.published !== false);
  return services.map((entry) => ({ params: { slug: entry.id.replace(/\.mdx?$/, '') }, props: { entry, services } }));
}

const { entry, services } = Astro.props;
const { Content } = await entry.render();
const service = entry.data;
const serviceSlug = entry.id.replace(/\.mdx?$/, '');
const canonicalURL = `https://y-stroika.ru/uslugi/${serviceSlug}/`;
const price = service.priceFrom || 'по запросу';
const hasBody = !!(entry.body && entry.body.trim());

// --- Per-service данные: всё берём из коллекции (service.*) с разумными фолбэками. ---
// Фолбэки — нейтральные, общие для строительной услуги; реальную специфику задаёт .md.
const heroImage = service.heroImage ?? '/images/uslugi/hero-roofer.png';
const heroTitle = service.heroTitle ?? `${service.title} в&nbsp;Москве «под&nbsp;ключ»`;
const heroFormTitle = service.heroFormTitle ?? 'Получите точный расчёт';
const heroFormText = service.heroFormText ?? 'Получите предварительный расчёт стоимости под ваш объект. Наш специалист свяжется с вами в течение 10 минут';
const heroFormButton = service.heroFormButton ?? 'Получить расчёт';
const bullets = service.heroBullets ?? [
  { bold: 'БЕСПЛАТНО', rest: ' выезд специалиста для уточнения объёма работ' },
  { bold: 'БЕСПЛАТНО', rest: ' составим для Вас смету и подготовим проект' },
  { bold: 'ВЫЕЗД ЗАМЕРЩИКА', rest: ' в день обращения' },
];
const steps = service.steps ?? [
  'Делаем заявку в строительную компанию',
  'Производим оценку сроков и стоимости',
  'Формируем наиболее выгодное предложение',
  'Подписываем договор о работе',
  'Производим необходимые работы',
  'Сдаём точно в срок готовый проект',
];
const workImages = service.workImages ?? ['/images/uslugi/work-1.png', '/images/uslugi/work-2.png', '/images/uslugi/work-3.png', '/images/uslugi/work-4.png'];
const priceTabs = service.priceTabs ?? ['Монтаж', 'Демонтаж'];
// Таблица стоимости 1-в-1 со структурой Figma (401:16262): группы-подзаголовки + работы с «- » и СВОЕЙ ценой.
// Цены реальные/разные по видам работ (Правило 4 — не одно значение во всех строках). Источник — service.priceGroups (.md).
const priceGroups = service.priceGroups ?? [];
const accessories = service.accessories ?? [];
const vliyaetLead = service.vliyaetLead ?? `Стоимость работ «${service.title.toLowerCase()}» всегда рассчитывается индивидуально для каждого заказа.`;
const vliyaetText = service.vliyaetText ?? '';
const vliyaetImage = service.vliyaetImage ?? service.osnovaImage ?? '/images/home/s7-services.png';
const orderCtaButton = service.orderCtaButton ?? 'Заказать';
const newsVideo = [
  { t: 'Почему течёт крыша? / Зачем контробрешётке уплотнитель?',                                  date: '23 марта', video: false, img: '/images/uslugi/video/v1.png' },
  { t: 'Кровля из металлочерепицы / Фасад в виниловом сайдинге / Загородный дом из СИП панелей',   date: '20 марта', video: false, img: '/images/uslugi/video/v2.png' },
  { t: 'Металлический вертикальный сайдинг / Оцинкованный кровельный профнастил',                  date: '16 марта', video: true,  img: '/images/uslugi/video/v3.png' },
  { t: 'Скатная крыша — виды, чем отличаются по конструктивным элементам, форме и параметрам',     date: '16 марта', video: true,  img: '/images/uslugi/video/v4.png' },
];
const reviews = [
  { name: 'Александр Завьялов', date: '20.03.2023', text: 'У-Стройка — компания, готовая решить все задачи по ремонту и строительству крыш. Благодаря готовым решениям мы сэкономили более 10% на стоимости материалов! Используют проверенных поставщиков и качественный монтаж.' },
  { name: 'Вадим',             date: '16.04.2021', text: 'Огромное спасибо за грамотное и профессиональное отношение. Приятное общение, своевременная доставка, итоговая цена порадовала.' },
  { name: 'Ольга',             date: '02.04.2020', text: 'Грамотная и профессиональная работа с клиентом. Хотелось бы, чтобы таких специалистов было больше. Спасибо за индивидуальный подход!' },
];
// Обрезка реального описания услуги до карточки (1-в-1 Figma: ~2-3 строки, без «хвоста»).
const cardDesc = (text) => {
  const t = (text ?? '').replace(/\s+/g, ' ').trim();
  if (t.length <= 165) return t;
  const cut = t.slice(0, 165);
  const lastDot = cut.lastIndexOf('. ');
  if (lastDot > 90) return cut.slice(0, lastDot + 1);
  return cut.slice(0, cut.lastIndexOf(' ')) + '…';
};
const others = services.filter((s) => s.id !== entry.id).slice(0, 7).map((s) => ({
  slug: s.id.replace(/\.mdx?$/, ''),
  title: s.data.title,
  desc: cardDesc(s.data.shortDescription),
}));

const jsonLd = {
  '@context': 'https://schema.org', '@type': 'Service', name: service.title, description: service.shortDescription, url: canonicalURL,
  provider: { '@type': 'Organization', name: 'У-Стройка', url: 'https://y-stroika.ru', telephone: '+78003339495' },
  ...(service.priceFrom ? { offers: { '@type': 'Offer', priceCurrency: 'RUB', description: service.priceFrom } } : {}),
};
---

<BaseLayout title={`${service.title} — У-Стройка`} description={`${service.title}. ${service.shortDescription?.slice(0, 150) ?? ''} Москва и МО. Звоните: 8-800-333-94-95.`}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <!-- Крошки -->
  <section class="bg-white px-4 sm:px-8 lg:px-[60px]" style="padding-top:24px;padding-bottom:20px;">
    <nav class="text-[14px] text-[#898989]">
      <a href="/" class="hover:text-[#FFAE01]">Главная</a> <span class="mx-[8px]">/</span>
      <a href="/uslugi" class="hover:text-[#FFAE01]">Наши услуги</a> <span class="mx-[8px]">/</span>
      <span class="text-[#333333]">{service.title}</span>
    </nav>
  </section>

  <!-- HERO: тёмная карточка (фото) + форма -->
  <section class="bg-white px-4 sm:px-8 lg:px-[60px]" style="padding-bottom:60px;">
    <div class="flex flex-col lg:flex-row gap-[20px] items-stretch">
      <!-- Левый блок: фото-крыша + тёмная info-карточка поверх -->
      <div class="relative flex-1 rounded-[5px] overflow-hidden" style="min-height:620px;">
        <img src={heroImage} alt={service.title} class="absolute inset-0 w-full h-full object-cover object-bottom pointer-events-none -scale-x-100" />
        <div class="relative z-10 inline-flex flex-col gap-[40px] bg-[#333333] rounded-[5px] m-[40px] lg:m-[70px]" style="padding:50px 60px;max-width:612px;">
          <div class="flex flex-col gap-[14px]">
            <h1 class="font-[Montserrat] font-semibold text-white text-[28px] lg:text-[42px] leading-[1.1]" set:html={heroTitle} />
            <div class="inline-flex items-center self-start bg-[#FFAE01] rounded-[5px]" style="padding:6px 13px;">
              <span class="text-[#333333] font-bold text-[28px] lg:text-[42px] leading-none whitespace-nowrap">{price}</span>
            </div>
          </div>
          <ul class="flex flex-col gap-[10px] list-disc pl-[20px] marker:text-white">
            {bullets.map((b) => (
              <li class="text-white text-[16px] lg:text-[18px] leading-[1.3]">
                <span class="font-medium">{b.bold}</span><span class="font-normal">{b.rest}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
      <!-- Форма расчёта (правый блок, как в Figma) -->
      <form id="zayavka" class="lg:w-[564px] flex-shrink-0 bg-[#F5F5F5] rounded-[5px] flex flex-col gap-[20px] justify-center" style="padding:37px 41px;">
        <div class="flex flex-col gap-[20px]">
          <h2 class="font-[Montserrat] font-semibold text-[#333333] text-[24px] leading-[1.3]">{heroFormTitle}</h2>
          <p class="text-[#333333] text-[16px] leading-[1.3]">{heroFormText}</p>
        </div>
        <div class="flex flex-col gap-[15px]">
          <input type="tel" name="phone" required placeholder="+7 (___) ___-__-__" class="h-[50px] px-[22px] bg-white rounded-[5px] text-[16px] text-[#333333] placeholder:text-[#bdbdbd] border border-[#E9E9E9] focus:outline-none focus:ring-2 focus:ring-[#FFAE01]" />
          <input type="number" name="length" placeholder="Длина" class="h-[50px] px-[22px] bg-white rounded-[5px] text-[16px] text-[#333333] placeholder:text-[#bdbdbd] border border-[#E9E9E9] focus:outline-none focus:ring-2 focus:ring-[#FFAE01]" />
          <input type="number" name="width" placeholder="Ширина" class="h-[50px] px-[22px] bg-white rounded-[5px] text-[16px] text-[#333333] placeholder:text-[#bdbdbd] border border-[#E9E9E9] focus:outline-none focus:ring-2 focus:ring-[#FFAE01]" />
          <select name="material" class="h-[50px] px-[22px] bg-white rounded-[5px] text-[16px] text-[#333333] border border-[#E9E9E9] focus:outline-none focus:ring-2 focus:ring-[#FFAE01]">
            <option value="">Материал</option>
            <option>Металлочерепица</option><option>Профнастил</option><option>Мягкая кровля</option><option>Другое</option>
          </select>
        </div>
        <button type="submit" class="bg-[#FFAE01] hover:bg-[#e09d00] text-[#333333] font-semibold text-[18px] rounded-[5px] transition-colors" style="height:50px;">{heroFormButton}</button>
        <label class="flex items-center gap-[10px] text-[#898989] text-[13px] leading-[1.3] cursor-pointer">
          <input type="checkbox" checked class="accent-[#FFAE01] w-[17px] h-[17px] flex-shrink-0" />
          <span>Ознакомился и&nbsp;согласен с&nbsp;<span class="underline">политикой конфиденциальности</span></span>
        </label>
      </form>
    </div>
  </section>

  <!-- Основа (интро + фото) -->
  <section class="bg-white px-4 sm:px-8 lg:px-[60px]" style="padding-bottom:60px;">
    <div class="flex items-end gap-[25px] mb-[30px]">
      <h2 class="font-[Montserrat] font-semibold text-[28px] lg:text-[42px] text-[#333333] leading-[1.1] flex-shrink-0">{service.osnovaTitle ?? 'Подробнее об услуге'}</h2>
      <div class="flex-1 bg-[#E9E9E9]" style="height:1.5px;margin-bottom:14px;"></div>
    </div>
    <div class="flex flex-col lg:flex-row gap-[40px] xl:gap-[91px] items-start">
      <div class="w-full lg:flex-[738_1_0%] text-[#333333] text-[16px] lg:text-[18px] leading-[25px] [&_p]:mb-[10px] [&_strong]:font-semibold">
        {entry.body && entry.body.trim() ? <Content /> : <p>{service.shortDescription}</p>}
      </div>
      <div class="w-full lg:flex-[969_1_0%] rounded-[5px] overflow-hidden bg-[#464646] aspect-[969/431]">
        <img src={service.osnovaImage ?? '/images/home/s7-services.png'} alt={service.title} class="w-full h-full object-cover" />
      </div>
    </div>
  </section>

  <!-- Как происходит работа (6 этапов с коннектором) -->
  <section class="bg-[#F5F5F5] px-4 sm:px-8 lg:px-[60px]" style="padding-top:60px;padding-bottom:60px;">
    <div class="flex items-end gap-[25px] mb-[40px]">
      <h2 class="font-[Montserrat] font-semibold text-[28px] lg:text-[42px] text-[#333333] leading-[1.22] flex-shrink-0">Как происходит работа с&nbsp;нами</h2>
      <div class="flex-1 bg-[#E9E9E9]" style="height:1.5px;margin-bottom:14px;"></div>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-6 gap-[15px]">
      {steps.map((s, i) => (
        <div class="flex flex-col gap-[12px]">
          <div class="inline-flex items-center self-start bg-[#333333] text-white rounded-[5px] relative" style="padding:8px 16px;">
            <span class="text-[14px] font-medium">{i + 1} этап</span>
            <span class="absolute top-1/2 -right-1.5 w-3 h-3 rounded-full bg-[#FFAE01] -translate-y-1/2 hidden lg:block"></span>
          </div>
          <p class="text-[#333333] text-[14px] leading-[1.4]">{s}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Преимущества -->
  <section class="bg-white px-4 sm:px-8 lg:px-[60px]"><AdvantagesBlock /></section>

  <!-- Выполненные работы -->
  <section class="bg-white px-4 sm:px-8 lg:px-[60px]" style="padding-top:40px;padding-bottom:60px;">
    <div class="flex items-end gap-[25px] mb-[40px]">
      <h2 class="font-[Montserrat] font-semibold text-[28px] lg:text-[42px] text-[#333333] leading-[1.22] flex-shrink-0">Выполненные работы</h2>
      <div class="flex-1 bg-[#E9E9E9]" style="height:1.5px;margin-bottom:14px;"></div>
    </div>
    <!-- Коллаж 1-в-1 по Figma: левое большое + центральное большое + правый столбец из двух -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-[20px]" style="grid-auto-rows:265px;">
      <div class="rounded-[5px] overflow-hidden lg:row-span-2" style="height:550px;">
        <img src={workImages[0]} alt={`Выполненная работа — ${service.title.toLowerCase()}`} class="w-full h-full object-cover" />
      </div>
      <div class="rounded-[5px] overflow-hidden lg:row-span-2" style="height:550px;">
        <img src={workImages[1]} alt={`Выполненная работа — ${service.title.toLowerCase()}`} class="w-full h-full object-cover" />
      </div>
      <div class="rounded-[5px] overflow-hidden" style="height:265px;">
        <img src={workImages[2]} alt={`Выполненная работа — ${service.title.toLowerCase()}`} class="w-full h-full object-cover" />
      </div>
      <div class="rounded-[5px] overflow-hidden lg:col-start-3" style="height:265px;">
        <img src={workImages[3]} alt={`Выполненная работа — ${service.title.toLowerCase()}`} class="w-full h-full object-cover" />
      </div>
    </div>
    <div class="flex justify-center mt-[50px]">
      <a href="/proekty" class="inline-flex items-center justify-center bg-[#FFAE01] hover:bg-[#e09d00] text-[#333333] font-semibold text-[18px] rounded-[5px] transition-colors" style="height:50px;width:457px;max-width:100%;">Посмотреть все работы</a>
    </div>
  </section>

  <!-- Закажите прямо сейчас (тёмный баннер + форма, 1-в-1 Figma 401:16138) -->
  <section class="bg-white px-4 sm:px-8 lg:px-[60px]" style="padding-bottom:60px;">
    <!-- Заголовок с разделителем как у других секций -->
    <div class="flex items-end gap-[25px] mb-[40px]">
      <h2 class="font-[Montserrat] font-semibold text-[28px] lg:text-[42px] text-[#333333] leading-[1.1] flex-shrink-0">Закажите {service.title.toLowerCase()} прямо сейчас</h2>
      <div class="flex-1 bg-[#E9E9E9]" style="height:1.5px;margin-bottom:14px;"></div>
    </div>
    <div class="bg-[#333333] rounded-[5px]" style="padding:40px 50px;">
      <div class="flex flex-col lg:flex-row gap-[25px] items-start">
        <p class="font-['Inter'] font-medium text-white text-[18px] leading-[1.3] flex-shrink-0 lg:w-[187px]">Отправьте онлайн-заявку и&nbsp;мы&nbsp;с&nbsp;вами свяжемся в&nbsp;течение 10&nbsp;минут</p>
        <form class="flex-1 w-full flex flex-col gap-[20px]">
          <!-- Ряд 1: имя, телефон, email -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-[20px]">
            <div class="flex flex-col gap-[6px]">
              <label class="font-['Inter'] text-[14px] text-white leading-[18px]">Ваше имя&nbsp;<span class="text-[#FFAE01]">*</span></label>
              <input type="text" name="name" placeholder="Введите имя" class="h-[50px] px-[22px] bg-[#464646] text-white placeholder:text-[#898989] placeholder:opacity-70 rounded-[5px] text-[16px] focus:outline-none focus:ring-2 focus:ring-[#FFAE01]" />
            </div>
            <div class="flex flex-col gap-[6px]">
              <label class="font-['Inter'] text-[14px] text-white leading-[18px]">Ваш телефон&nbsp;<span class="text-[#FFAE01]">*</span></label>
              <input type="tel" name="phone" required placeholder="+7 (___) ___-__-__" class="h-[50px] px-[22px] bg-[#464646] text-white placeholder:text-[#898989] placeholder:opacity-70 rounded-[5px] text-[16px] focus:outline-none focus:ring-2 focus:ring-[#FFAE01]" />
            </div>
            <div class="flex flex-col gap-[6px]">
              <label class="font-['Inter'] text-[14px] text-white leading-[18px]">Электронная почта</label>
              <input type="email" name="email" placeholder="Email" class="h-[50px] px-[22px] bg-[#464646] text-white placeholder:text-[#898989] placeholder:opacity-70 rounded-[5px] text-[16px] focus:outline-none focus:ring-2 focus:ring-[#FFAE01]" />
            </div>
          </div>
          <!-- Ряд 2: текст обращения, прикрепить файл, заказать -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-[20px]">
            <div class="flex flex-col gap-[6px]">
              <label class="font-['Inter'] text-[14px] text-white leading-[18px]">Текст обращения</label>
              <input type="text" name="message" placeholder="Напишите обращение" class="h-[50px] px-[22px] bg-[#464646] text-white placeholder:text-[#898989] placeholder:opacity-70 rounded-[5px] text-[16px] focus:outline-none focus:ring-2 focus:ring-[#FFAE01]" />
            </div>
            <label class="flex items-center justify-center gap-[10px] h-[50px] bg-[#898989] hover:bg-[#9a9a9a] rounded-[5px] cursor-pointer transition-colors self-end">
              <svg class="w-[14px] h-[25px] text-[#333333]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21.44 11.05l-9.19 9.19a6 6 0 01-8.49-8.49l9.19-9.19a4 4 0 015.66 5.66l-9.2 9.19a2 2 0 01-2.83-2.83l8.49-8.48"/></svg>
              <span class="font-['Inter'] font-semibold text-[#333333] text-[18px]">Прикрепить файл</span>
              <input type="file" name="file" class="hidden" />
            </label>
            <button type="submit" class="h-[50px] bg-[#FFAE01] hover:bg-[#e09d00] text-[#333333] font-['Inter'] font-semibold text-[18px] rounded-[5px] transition-colors self-end">{orderCtaButton}</button>
          </div>
          <!-- Согласие -->
          <label class="flex items-center gap-[10px] cursor-pointer">
            <input type="checkbox" checked class="accent-[#FFAE01] w-[17px] h-[17px] flex-shrink-0" />
            <span class="font-['Inter'] text-[#898989] text-[13px] leading-[1.3]">Ознакомился и&nbsp;согласен с&nbsp;<span class="underline">политикой конфиденциальности</span></span>
          </label>
        </form>
      </div>
    </div>
  </section>

  <!-- Стоимость (таблица с табами) -->
  {priceGroups.length > 0 && (
  <section class="bg-[#F5F5F5] px-4 sm:px-8 lg:px-[60px]" style="padding-top:60px;padding-bottom:60px;">
    <div class="flex items-end gap-[25px] mb-[30px]">
      <h2 class="font-[Montserrat] font-semibold text-[28px] lg:text-[42px] text-[#333333] leading-[1.22] flex-shrink-0">Стоимость</h2>
      <div class="flex-1 bg-[#E9E9E9]" style="height:1.5px;margin-bottom:14px;"></div>
    </div>
    <div class="flex gap-[20px] mb-[16px]">
      {priceTabs.map((t, i) => (
        <button class={`rounded-[5px] text-[16px] ${i === 0 ? 'bg-[#FFAE01] text-[#333333] font-medium' : 'bg-white text-[#898989]'}`} style="padding:10px 26px;">{t}</button>
      ))}
    </div>
    <div class="bg-white rounded-[5px] overflow-hidden">
      <div class="flex items-center justify-between bg-[#333333] text-white font-['Inter'] font-semibold text-[18px]" style="padding:30px;">
        <span>Наименование работ</span><span>Цена, ед. измерения</span>
      </div>
      {priceGroups.map((g, gi) => {
        let rowIndex = 0;
        return (<>
          <div class="bg-[#E9E9E9] font-['Inter'] font-semibold text-[18px] text-[#333333]" style="padding:18px 30px;">{g.head}</div>
          {g.rows.map((r) => {
            const zebra = rowIndex++ % 2 === 0 ? 'bg-white' : 'bg-[#F5F5F5]';
            return (
              <div class={`flex items-center justify-between gap-4 ${zebra}`} style="padding:18px 30px;">
                <span class="font-['Inter'] text-[16px] text-[#333333]">{r.name}</span>
                <span class="font-['Inter'] font-semibold text-[18px] text-[#333333] whitespace-nowrap">{r.price}</span>
              </div>
            );
          })}
        </>);
      })}
    </div>
  </section>
  )}

  <!-- Что влияет на стоимость -->
  <section class="bg-white px-4 sm:px-8 lg:px-[60px]" style="padding-top:60px;padding-bottom:60px;">
    <div class="flex items-end gap-[25px] mb-[30px]">
      <h2 class="font-[Montserrat] font-semibold text-[28px] lg:text-[42px] text-[#333333] leading-[1.22] flex-shrink-0">Что влияет на&nbsp;стоимость</h2>
      <div class="flex-1 bg-[#E9E9E9]" style="height:1.5px;margin-bottom:14px;"></div>
    </div>
    <div class="flex flex-col lg:flex-row gap-[40px] xl:gap-[91px] items-center">
      <div class="w-full lg:flex-[738_1_0%] flex flex-col gap-[30px]">
        <div class="text-[#333333] text-[18px] leading-[1.3]">
          <p class="font-semibold mb-[10px]">{vliyaetLead}</p>
          {vliyaetText && <p>{vliyaetText}</p>}
        </div>
        <a href="#zayavka" class="flex items-center justify-center w-full bg-[#FFAE01] hover:bg-[#e09d00] text-[#333333] font-semibold text-[18px] rounded-[5px] transition-colors" style="height:50px;">Рассчитать стоимость</a>
      </div>
      <!-- Декор ₽ ПОД фото (z-order как в Figma 402:17928): ₽ full-opacity рендерится первым, фото-вырез сверху перекрывает его. -->
      <div class="w-full lg:flex-[969_1_0%] relative rounded-[5px] overflow-hidden bg-[#464646] aspect-[969/297]">
        <span class="absolute font-['Inter'] font-bold text-[#FFAE01] leading-none select-none pointer-events-none z-0" style="font-size:300px;left:96px;top:38px;line-height:0.9;">₽</span>
        <img src={vliyaetImage} alt={service.title} class="absolute object-cover pointer-events-none z-10" style="left:2.4%;top:-44.5%;width:98.7%;height:213%;" />
      </div>
    </div>
  </section>

  <!-- Спектр услуг -->
  {others.length > 0 && (
    <section class="bg-[#F5F5F5] px-4 sm:px-8 lg:px-[60px]" style="padding-top:60px;padding-bottom:60px;">
      <div class="flex items-end gap-[25px] mb-[40px]">
        <h2 class="font-[Montserrat] font-semibold text-[28px] lg:text-[42px] text-[#333333] leading-[1.22] flex-shrink-0">Предоставляем весь спектр необходимых услуг</h2>
        <div class="flex-1 bg-[#E9E9E9]" style="height:1.5px;margin-bottom:14px;"></div>
      </div>
      {/* Ряд 1: 4 карточки (434px в Figma). Первая — фото-карточка (как экран 8 Figma): фото-фон + оранжевая шапка, без описания. */}
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-[20px]">
        {others.slice(0, 4).map((o, idx) => (
          idx === 0 ? (
            <a href={`/uslugi/${o.slug}`} class="group relative flex flex-col bg-[#333333] rounded-[5px] overflow-hidden shadow-[0_4px_30px_rgba(0,0,0,0.1)]" style="height:260px;">
              <img src="/images/uslugi/spektr-card-1.png" alt={o.title} class="absolute inset-0 w-full h-full object-cover pointer-events-none" />
              <div class="relative z-10 flex items-center justify-between bg-[#333333] rounded-[5px]" style="margin:30px 27px 0;height:50px;padding:0 20px;">
                <span class="font-['Inter'] font-semibold text-[#FFAE01] text-[18px] leading-tight whitespace-nowrap overflow-hidden text-ellipsis">{o.title}</span>
                <span class="flex items-center justify-center w-[26px] h-[26px] flex-shrink-0 text-[#FFAE01]">
                  <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M7 7h10v10"/></svg>
                </span>
              </div>
            </a>
          ) : (
            <a href={`/uslugi/${o.slug}`} class="group flex flex-col gap-[20px] bg-white rounded-[5px] shadow-[0_4px_30px_rgba(0,0,0,0.1)] overflow-hidden" style="height:260px;padding:30px 35px;">
              <div class="flex items-center justify-between bg-[#333333] rounded-[5px] flex-shrink-0" style="height:50px;padding:0 20px;">
                <span class="font-['Inter'] font-semibold text-white text-[18px] leading-tight whitespace-nowrap overflow-hidden text-ellipsis">{o.title}</span>
                <span class="flex items-center justify-center w-[26px] h-[26px] flex-shrink-0 text-white group-hover:text-[#FFAE01] transition-colors">
                  <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M7 7h10v10"/></svg>
                </span>
              </div>
              <p class="font-['Inter'] text-[#333333] text-[16px] leading-[1.3] overflow-hidden">{o.desc}</p>
            </a>
          )
        ))}
      </div>
      {/* Ряд 2: оставшиеся карточки шире (586px в Figma), тёмная шапка + реальное описание. */}
      {others.length > 4 && (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-[20px] mt-[20px]">
          {others.slice(4).map((o) => (
            <a href={`/uslugi/${o.slug}`} class="group flex flex-col gap-[20px] bg-white rounded-[5px] shadow-[0_4px_30px_rgba(0,0,0,0.1)] overflow-hidden" style="height:260px;padding:30px 35px;">
              <div class="flex items-center justify-between bg-[#333333] rounded-[5px] flex-shrink-0" style="height:50px;padding:0 20px;">
                <span class="font-['Inter'] font-semibold text-white text-[18px] leading-tight whitespace-nowrap overflow-hidden text-ellipsis">{o.title}</span>
                <span class="flex items-center justify-center w-[26px] h-[26px] flex-shrink-0 text-white group-hover:text-[#FFAE01] transition-colors">
                  <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M7 7h10v10"/></svg>
                </span>
              </div>
              <p class="font-['Inter'] text-[#333333] text-[16px] leading-[1.3] overflow-hidden">{o.desc}</p>
            </a>
          ))}
        </div>
      )}
    </section>
  )}

  <!-- Вам может понадобиться (сопутствующие) -->
  {accessories.length > 0 && (
  <section class="bg-white px-4 sm:px-8 lg:px-[60px]" style="padding-top:60px;padding-bottom:60px;">
    <div class="flex items-end gap-[25px] mb-[30px]">
      <h2 class="font-[Montserrat] font-semibold text-[28px] lg:text-[42px] text-[#333333] leading-[1.22] flex-shrink-0">Вам может понадобиться</h2>
      <div class="flex-1 bg-[#E9E9E9]" style="height:1.5px;margin-bottom:14px;"></div>
    </div>
    <div class="flex flex-wrap gap-[10px] mb-5">
      {['Сопутствующие товары', 'Распродажа', 'Хиты', 'Новинки'].map((t, i) => (
        <button class={`rounded-[5px] text-[14px] font-medium ${i === 0 ? 'bg-[#FFAE01] text-[#333333]' : 'bg-[#E9E9E9] text-[#898989]'}`} style="padding:8px 18px;">{t}</button>
      ))}
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-[20px]">
      {accessories.map((a) => (
        <div class="group relative rounded-[5px] bg-white shadow-[0_4px_30px_rgba(0,0,0,0.1)] overflow-hidden flex flex-col">
          {a.old && <span class="absolute top-0 left-0 bg-[#C51212] text-white text-[12px] font-medium z-10 rounded-br-[5px]" style="padding:4px 12px;">Скидка</span>}
          <!-- Фото товара -->
          <div class="bg-[#F5F5F5] border-b-[1.5px] border-[#E9E9E9] flex items-center justify-center overflow-hidden" style="height:200px;">
            <img src={a.img} alt={a.name} class="max-h-[170px] max-w-[80%] object-contain pointer-events-none" />
          </div>
          <div class="flex flex-col flex-1" style="padding:18px 20px 20px;">
            <!-- Оценка + наличие -->
            <div class="flex items-center justify-between mb-[12px]">
              <span class="inline-flex items-center gap-[5px] bg-[#333333] text-white text-[13px] rounded-[5px]" style="padding:2px 7px;"><svg class="w-[14px] h-[14px] fill-[#FFAE01]" viewBox="0 0 20 20"><path d="M9.05 2.93c.3-.92 1.6-.92 1.9 0l1.07 3.29h3.46c.97 0 1.37 1.24.59 1.81l-2.8 2.03 1.07 3.29c.3.92-.76 1.69-1.54 1.12L10 14.43l-2.8 2.03c-.78.57-1.84-.2-1.54-1.12l1.07-3.29-2.8-2.03c-.78-.57-.38-1.81.59-1.81h3.46l1.07-3.29z"/></svg>5.0</span>
              <span class={`flex items-center gap-[5px] text-[13px] ${a.stock === 'in' ? 'text-[#4AC71E]' : 'text-[#C51212]'}`}>
                {a.stock === 'in'
                  ? <svg class="w-[13px] h-[13px]" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                  : <svg class="w-[13px] h-[13px]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path stroke-linecap="round" d="M12 8v5M12 16h.01"/></svg>}
                {a.stock === 'in' ? 'В наличии' : 'Уточните у менеджера'}
              </span>
            </div>
            <!-- Название -->
            <p class="text-[15px] text-[#333333] font-medium leading-[1.3] mb-[15px]" style="min-height:40px;">{a.name}</p>
            <!-- Кол-во -->
            <div class="flex items-center justify-between border-b-[1.5px] border-[#E9E9E9] mt-auto" style="padding-bottom:12px;margin-bottom:14px;">
              <span class="text-[#333333] text-[15px]">Кол-во</span>
              <div class="flex items-center gap-[12px]">
                <span class="flex items-center justify-center bg-[#E9E9E9] rounded-[5px] text-[#333333] text-[18px] font-medium" style="width:32px;height:32px;">−</span>
                <span class="text-[#333333] text-[15px] font-medium min-w-[14px] text-center">{a.qty}</span>
                <span class="flex items-center justify-center bg-[#E9E9E9] rounded-[5px] text-[#333333] text-[18px] font-medium" style="width:32px;height:32px;">+</span>
              </div>
            </div>
            <!-- Цена + иконки -->
            <div class="flex items-end justify-between">
              <div class="flex flex-col">
                {a.old && <span class="text-[12px] text-[#898989] line-through leading-none mb-[2px]">{a.old}</span>}
                <span class="font-bold text-[22px] text-[#333333] leading-none">{a.price}</span>
              </div>
              <div class="flex items-center gap-[12px]">
                <button aria-label="В избранное" class="flex items-center justify-center bg-[#F5F5F5] hover:bg-[#E9E9E9] rounded-full text-[#333333] transition-colors" style="width:38px;height:38px;"><svg class="w-[18px] h-[18px]" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg></button>
                <button aria-label="В корзину" class="flex items-center justify-center bg-[#FFAE01] hover:bg-[#e09d00] rounded-full text-[#333333] transition-colors" style="width:38px;height:38px;"><svg class="w-[18px] h-[18px]" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293A1 1 0 005.414 17H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/></svg></button>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>
  )}

  <!-- Наши специалисты сделают расчёт + форма -->
  <section class="bg-[#F5F5F5] px-4 sm:px-8 lg:px-[60px]" style="padding-top:60px;padding-bottom:60px;">
    <h2 class="font-[Montserrat] font-semibold text-[24px] lg:text-[32px] text-[#333333] leading-[1.3] mb-6" style="max-width:900px;">
      Наши специалисты сделают расчёт оперативно и&nbsp;помогут подобрать материалы по&nbsp;самой выгодной цене!
    </h2>
    <form class="bg-white rounded-[5px] flex flex-col lg:flex-row items-stretch lg:items-center gap-4" style="padding:25px;">
      <span class="text-[#898989] text-[14px] lg:max-w-[180px] flex-shrink-0">Мы работаем для&nbsp;вас с&nbsp;9 до&nbsp;21:00 ежедневно</span>
      <input type="text" name="name" placeholder="Ваше имя *" class="flex-1 h-[50px] px-4 bg-[#F5F5F5] rounded-[5px] text-[16px] border border-[#E9E9E9] focus:outline-none focus:ring-2 focus:ring-[#FFAE01]" />
      <input type="tel" name="phone" required placeholder="Ваш телефон *" class="flex-1 h-[50px] px-4 bg-[#F5F5F5] rounded-[5px] text-[16px] border border-[#E9E9E9] focus:outline-none focus:ring-2 focus:ring-[#FFAE01]" />
      <button type="submit" class="flex-shrink-0 h-[50px] bg-[#FFAE01] hover:bg-[#e09d00] text-[#333333] font-semibold rounded-[5px] transition-colors px-7">Получить помощь специалистов</button>
    </form>
  </section>

  <!-- Отзывы -->
  <section class="bg-white px-4 sm:px-8 lg:px-[60px]" style="padding-top:60px;padding-bottom:60px;">
    <div class="flex items-end gap-[25px] mb-[40px]">
      <h2 class="font-[Montserrat] font-semibold text-[28px] lg:text-[42px] text-[#333333] leading-[1.22] flex-shrink-0" style="max-width:892px;">Посмотрите что говорят наши клиенты</h2>
      <div class="flex-1 bg-[#E9E9E9]" style="height:1.5px;margin-bottom:14px;"></div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-[20px]">
      {reviews.map((r) => (
        <div class="bg-[#F5F5F5] rounded-[5px] flex flex-col gap-[15px]" style="padding:25px;min-height:220px;">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-[12px]">
              <div class="w-[50px] h-[50px] rounded-full bg-[#E9E9E9] flex items-center justify-center text-[#898989] text-[20px] font-semibold flex-shrink-0">{r.name.charAt(0)}</div>
              <div class="flex flex-col"><span class="text-[#333333] text-[16px] font-semibold leading-tight">{r.name}</span><span class="text-[#898989] text-[12px]">{r.date}</span></div>
            </div>
            <div class="flex items-center gap-[2px]">{[1,2,3,4,5].map(() => (<svg width="16" height="16" viewBox="0 0 20 20" fill="#FFAE01"><polygon points="10,1 12.5,7.5 19,7.5 14,12 16,18.5 10,15 4,18.5 6,12 1,7.5 7.5,7.5"/></svg>))}</div>
          </div>
          <p class="text-[#333333] text-[14px] leading-[1.4] flex-1">{r.text}</p>
          <a href="/otzyvy" class="text-[#333333] text-[13px] underline hover:text-[#FFAE01] transition-colors self-start">Читать весь отзыв</a>
        </div>
      ))}
    </div>
  </section>

  <!-- Баннер «лучший поставщик» -->
  <section class="bg-white px-4 sm:px-8 lg:px-[60px]" style="padding-bottom:60px;">
    <!-- Заголовок с разделителем как у других секций -->
    <div class="flex items-end gap-[25px] mb-[40px]">
      <h2 class="font-[Montserrat] font-semibold text-[28px] lg:text-[42px] text-[#333333] leading-[1.3] flex-shrink-0" style="max-width:898px;">У-Стройка&nbsp;— лучший поставщик строительных материалов для&nbsp;кровли</h2>
      <div class="flex-1 bg-[#E9E9E9]" style="height:1.5px;margin-bottom:14px;"></div>
    </div>
    <div class="flex flex-col lg:flex-row gap-[40px] items-stretch">
      <div class="flex-1 flex flex-col gap-[15px]" style="max-width:651px;padding-top:30px;">
        <p class="text-[#333333] text-[20px] lg:text-[24px] font-semibold leading-[1.3]">У-Стройка&nbsp;— это материалы для&nbsp;кровли и&nbsp;фасадов от&nbsp;лучших поставщиков. Работаем для&nbsp;вас на&nbsp;рынке строительных материалов с&nbsp;2014&nbsp;года.</p>
        <p class="text-[#333333] text-[16px] leading-[1.3]">Смело можем сказать, что&nbsp;мы&nbsp;— эксперты данного рынка. Более 30&nbsp;000 позиций кровли и&nbsp;фасада мы&nbsp;собрали для&nbsp;вас в&nbsp;одном месте. Предлагаем продукцию таких брендов, как&nbsp;Grand&nbsp;line, Docke, Металлпрофиль, АльтаПрофиль по&nbsp;лучшим ценам!</p>
        <p class="text-[#333333] text-[16px] leading-[1.3]">Вернём разницу если&nbsp;найдёте дешевле!</p>
        <p class="text-[#333333] text-[16px] leading-[1.3]">Поставляем материал в&nbsp;день готовности, чтобы&nbsp;не&nbsp;останавливалась стройка.</p>
      </div>
      <div class="relative lg:w-[1045px] flex-shrink-0 rounded-[5px] overflow-hidden bg-[#464646]" style="height:360px;">
        <img src="/images/uslugi/supplier-banner.png" alt="" class="absolute pointer-events-none object-cover" style="left:-88px;top:-235px;width:823px;height:1122px;" />
        <p class="absolute font-[Montserrat] font-semibold text-white text-[28px] lg:text-[36px] leading-[1.3] z-10" style="right:35px;top:47px;width:334px;">Широкий ассортимент позиций кровли и&nbsp;фасада</p>
        <div class="absolute flex items-center z-10 bg-[#FFAE01] rounded-[5px]" style="right:60px;top:261px;height:47px;padding:0 9px;">
          <span class="text-[#333333] font-[Montserrat] font-semibold text-[28px] lg:text-[36px] leading-none whitespace-nowrap">более 30&nbsp;000</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Новости и видео -->
  <section class="bg-white px-4 sm:px-8 lg:px-[60px]" style="padding-bottom:60px;">
    <div class="flex items-end gap-[25px] mb-6">
      <h2 class="font-[Montserrat] font-semibold text-[22px] lg:text-[28px] text-[#333333] leading-snug flex-shrink-0">Новости и&nbsp;видео</h2>
      <div class="flex-1 h-px bg-[#E9E9E9] mb-2"></div>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {newsVideo.map((n) => (
        <div class="group cursor-pointer flex flex-col gap-3">
          <div class="relative aspect-video rounded-[5px] overflow-hidden bg-[#333333]">
            <img src={n.img} alt={n.t} class="absolute inset-0 w-full h-full object-cover" />
            {n.video && (
              <div class="absolute inset-0 flex items-center justify-center">
                <span class="w-[54px] h-[54px] rounded-full bg-[#FFAE01]/90 flex items-center justify-center group-hover:bg-[#FFAE01] transition-colors"><svg class="w-5 h-5 text-[#333333] ml-1" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></span>
              </div>
            )}
          </div>
          <p class="text-sm text-[#333333] font-medium leading-snug group-hover:text-[#FFAE01] transition-colors">{n.t}</p>
          <span class="text-[#898989] text-[12px]">{n.date}</span>
        </div>
      ))}
    </div>
    <div class="flex justify-center gap-3 mt-6">
      <a href="/novosti" class="inline-flex items-center justify-center bg-[#FFAE01] hover:bg-[#e09d00] text-[#333333] font-semibold text-sm rounded-[5px] transition-colors" style="height:48px;padding:0 30px;">Читать все новости</a>
      <a href="/novosti" class="inline-flex items-center justify-center border border-[#333333] text-[#333333] hover:bg-[#333333] hover:text-white font-semibold text-sm rounded-[5px] transition-colors" style="height:48px;padding:0 30px;">Смотреть больше видео</a>
    </div>
  </section>
</BaseLayout>
