---
/**
 * Страница услуги — /uslugi/[slug]
 * Контент: src/content/services/ (из Bitrix IBLOCK 29)
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, getEntry } from 'astro:content';

export async function getStaticPaths() {
  const services = await getCollection('services', ({ data }) => data.published !== false);
  return services.map((entry) => ({
    params: { slug: entry.id.replace(/\.mdx?$/, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const service = entry.data;
const serviceSlug = entry.id.replace(/\.mdx?$/, '');
const canonicalURL = `https://ystroika.ru/uslugi/${serviceSlug}/`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  'name': service.title,
  'description': service.shortDescription,
  'url': canonicalURL,
  'provider': {
    '@type': 'Organization',
    'name': 'У-Стройка',
    'url': 'https://ystroika.ru',
    'telephone': '+78003339495',
  },
  ...(service.priceFrom ? { 'offers': {
    '@type': 'Offer',
    'priceCurrency': 'RUB',
    'description': service.priceFrom,
  }} : {}),
};
---

<BaseLayout
  title={`${service.title} — У-Стройка`}
  description={`${service.title}. ${service.shortDescription?.slice(0, 150) ?? ''}. Москва и МО. Звоните: 8-800-333-94-95.`}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

    <!-- Хлебные крошки -->
    <nav class="flex flex-wrap items-center gap-1.5 text-sm text-slate-500 mb-6">
      <a href="/" class="hover:text-brand">Главная</a>
      <svg class="w-3.5 h-3.5 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
      </svg>
      <a href="/uslugi" class="hover:text-brand">Услуги</a>
      <svg class="w-3.5 h-3.5 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
      </svg>
      <span class="text-slate-900 font-medium truncate max-w-xs">{service.title}</span>
    </nav>

    <!-- Заголовок + цена -->
    <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4 mb-8">
      <h1 class="text-3xl font-bold text-slate-900">{service.title}</h1>
      {service.priceFrom && (
        <div class="shrink-0 bg-brand/10 text-brand font-bold text-lg px-5 py-2 rounded-xl whitespace-nowrap">
          {service.priceFrom}
        </div>
      )}
    </div>

    <!-- Короткое описание -->
    {service.shortDescription && (
      <p class="text-lg text-slate-600 mb-8 leading-relaxed">{service.shortDescription}</p>
    )}

    <!-- Основной контент (из markdown) -->
    {entry.body && entry.body.trim() && (
      <div class="prose prose-slate max-w-none mb-10">
        <Content />
      </div>
    )}

    <!-- CTA карточка -->
    <div class="bg-slate-900 text-white rounded-2xl p-8 flex flex-col sm:flex-row items-center gap-6">
      <div class="flex-1">
        <p class="font-bold text-xl">Заказать {service.title.toLowerCase()}</p>
        <p class="text-slate-400 mt-1">Бесплатный выезд замерщика. Расчёт за 1 день.</p>
      </div>
      <div class="flex flex-col sm:flex-row gap-3 shrink-0">
        <a href="tel:88003339495" class="inline-flex items-center justify-center gap-2 bg-brand hover:bg-brand-hover text-white font-semibold px-6 py-3 rounded-xl transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          Позвонить
        </a>
        <a href="/raschet" class="inline-flex items-center justify-center gap-2 border border-slate-600 hover:border-white text-white font-semibold px-6 py-3 rounded-xl transition-colors">
          Получить расчёт
        </a>
      </div>
    </div>

    <!-- Назад к списку -->
    <div class="mt-8 pt-6 border-t border-slate-200">
      <a href="/uslugi" class="inline-flex items-center gap-2 text-sm font-medium text-brand hover:text-brand-hover">
        <svg class="w-4 h-4 rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
        Все услуги
      </a>
    </div>

  </div>
</BaseLayout>
