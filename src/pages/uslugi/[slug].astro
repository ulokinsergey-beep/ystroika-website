---
/**
 * Страница услуги — /uslugi/[slug] — лендинг 1-в-1 по Figma (401:15673 и др.).
 * Секции: hero(+форма) → интро → как работаем → преимущества → выполненные работы →
 * CTA-баннер → стоимость → спектр услуг → отзывы → специалисты → баннер-поставщик → CTA.
 * Маркетинговые секции общие; контент услуги — из services collection.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdvantagesBlock from '../../components/AdvantagesBlock.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const services = await getCollection('services', ({ data }) => data.published !== false);
  return services.map((entry) => ({ params: { slug: entry.id.replace(/\.mdx?$/, '') }, props: { entry, services } }));
}

const { entry, services } = Astro.props;
const { Content } = await entry.render();
const service = entry.data;
const serviceSlug = entry.id.replace(/\.mdx?$/, '');
const canonicalURL = `https://ystroika.ru/uslugi/${serviceSlug}/`;

const others = services
  .filter((s) => s.id !== entry.id)
  .slice(0, 4)
  .map((s) => ({ slug: s.id.replace(/\.mdx?$/, ''), title: s.data.title }));

const steps = [
  { n: '01', title: 'Заявка', text: 'Оставляете заявку — отвечаем в течение 15 минут.' },
  { n: '02', title: 'Замер', text: 'Бесплатный выезд замерщика на объект.' },
  { n: '03', title: 'Расчёт', text: 'Смета с фиксированной ценой за 1 день.' },
  { n: '04', title: 'Работы', text: 'Монтаж по технологии завода с гарантией.' },
];
const reviews = [
  { name: 'Вадим',   text: 'Огромное спасибо за грамотное и профессиональное отношение. Своевременная доставка, итоговая цена порадовала.' },
  { name: 'Валерий', text: 'Благодарность за профессиональную работу! Чёткие ответы, доставка в назначенное время — приятное впечатление.' },
  { name: 'Ольга',   text: 'Грамотная работа с клиентом. Хотелось бы, чтобы таких специалистов было больше. Спасибо за индивидуальный подход!' },
];

const jsonLd = {
  '@context': 'https://schema.org', '@type': 'Service', name: service.title, description: service.shortDescription, url: canonicalURL,
  provider: { '@type': 'Organization', name: 'У-Стройка', url: 'https://ystroika.ru', telephone: '+78003339495' },
  ...(service.priceFrom ? { offers: { '@type': 'Offer', priceCurrency: 'RUB', description: service.priceFrom } } : {}),
};
---

<BaseLayout title={`${service.title} — У-Стройка`} description={`${service.title}. ${service.shortDescription?.slice(0, 150) ?? ''} Москва и МО. Звоните: 8-800-333-94-95.`}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <!-- Крошки -->
  <section class="bg-white px-4 sm:px-8 lg:px-[60px]" style="padding-top:30px;padding-bottom:20px;">
    <nav class="text-[14px] text-[#898989]">
      <a href="/" class="hover:text-[#FFAE01]">Главная</a> <span class="mx-[8px]">/</span>
      <a href="/uslugi" class="hover:text-[#FFAE01]">Услуги</a> <span class="mx-[8px]">/</span>
      <span class="text-[#333333]">{service.title}</span>
    </nav>
  </section>

  <!-- HERO: тёмный баннер + форма -->
  <section class="bg-white px-4 sm:px-8 lg:px-[60px]" style="padding-bottom:60px;">
    <div class="flex flex-col lg:flex-row gap-[20px] items-stretch">
      <div class="relative flex-1 bg-[#333333] rounded-[5px] overflow-hidden flex flex-col justify-center gap-[20px]" style="padding:50px;">
        <span class="absolute font-[Montserrat] font-black text-[#FFAE01]/10 leading-none select-none pointer-events-none" style="font-size:300px;right:-20px;bottom:-90px;">%</span>
        <h1 class="relative z-10 font-[Montserrat] font-semibold text-white text-[28px] lg:text-[40px] leading-[1.25] max-w-[640px]">{service.title}</h1>
        <p class="relative z-10 text-[#E9E9E9] text-[16px] lg:text-[18px] leading-[1.4] max-w-[560px]">{service.shortDescription ?? 'Качественно, в срок, с гарантией. Москва и Московская область.'}</p>
        {service.priceFrom && (
          <div class="relative z-10 inline-flex items-center bg-[#FFAE01] rounded-[5px] self-start" style="padding:10px 20px;">
            <span class="text-[#333333] font-bold text-[20px]">{service.priceFrom}</span>
          </div>
        )}
        <a href="#zayavka" class="relative z-10 inline-flex items-center justify-center bg-[#FFAE01] hover:bg-[#e09d00] text-[#333333] font-semibold text-[18px] rounded-[5px] transition-colors self-start" style="height:50px;padding:0 35px;">Получить расчёт</a>
      </div>
      <!-- Форма -->
      <form id="zayavka" class="lg:w-[420px] flex-shrink-0 bg-[#F5F5F5] rounded-[5px] flex flex-col gap-[15px] justify-center" style="padding:35px;">
        <h2 class="font-[Montserrat] font-semibold text-[#333333] text-[22px] leading-[1.2]">Рассчитать стоимость</h2>
        <p class="text-[#898989] text-[14px]">Ответим за 15 минут, замер бесплатно</p>
        <input type="text" name="name" placeholder="Ваше имя" class="h-[50px] px-4 bg-white rounded-[5px] text-[16px] border border-[#E9E9E9] focus:outline-none focus:ring-2 focus:ring-[#FFAE01]" />
        <input type="tel" name="phone" required placeholder="+7 (___) ___-__-__" class="h-[50px] px-4 bg-white rounded-[5px] text-[16px] border border-[#E9E9E9] focus:outline-none focus:ring-2 focus:ring-[#FFAE01]" />
        <button type="submit" class="bg-[#FFAE01] hover:bg-[#e09d00] text-[#333333] font-semibold text-[18px] rounded-[5px] transition-colors" style="height:50px;">Отправить заявку</button>
        <p class="text-[#898989] text-[12px] leading-[1.4]">Нажимая, вы соглашаетесь с политикой конфиденциальности</p>
      </form>
    </div>
  </section>

  <!-- Описание (из Bitrix) -->
  {entry.body && entry.body.trim() && (
    <section class="bg-white px-4 sm:px-8 lg:px-[60px]" style="padding-bottom:60px;">
      <div class="prose prose-slate max-w-[900px]"><Content /></div>
    </section>
  )}

  <!-- Как мы работаем (тёмные карточки) -->
  <section class="bg-white px-4 sm:px-8 lg:px-[60px]" style="padding-bottom:60px;">
    <div class="flex items-end gap-[25px] mb-[40px]">
      <h2 class="font-[Montserrat] font-semibold text-[28px] lg:text-[42px] text-[#333333] leading-[1.22] flex-shrink-0">Как происходит работа у нас</h2>
      <div class="flex-1 bg-[#E9E9E9]" style="height:1.5px;margin-bottom:14px;"></div>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-[20px]">
      {steps.map((s) => (
        <div class="bg-[#333333] rounded-[5px] flex flex-col gap-[12px]" style="padding:30px;min-height:190px;">
          <span class="font-[Montserrat] font-bold text-[#FFAE01] text-[40px] leading-none">{s.n}</span>
          <span class="font-[Montserrat] font-semibold text-white text-[18px]">{s.title}</span>
          <p class="text-[#E9E9E9] text-[15px] leading-[1.4]">{s.text}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Преимущества -->
  <section class="bg-[#F5F5F5] px-4 sm:px-8 lg:px-[60px]"><AdvantagesBlock /></section>

  <!-- Выполненные работы -->
  <section class="bg-white px-4 sm:px-8 lg:px-[60px]" style="padding-top:60px;padding-bottom:60px;">
    <div class="flex items-end gap-[25px] mb-[40px]">
      <h2 class="font-[Montserrat] font-semibold text-[28px] lg:text-[42px] text-[#333333] leading-[1.22] flex-shrink-0">Выполненные работы</h2>
      <div class="flex-1 bg-[#E9E9E9]" style="height:1.5px;margin-bottom:14px;"></div>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-[20px]">
      {[1,2,3].map(() => (
        <div class="aspect-[4/3] rounded-[5px] bg-gradient-to-br from-[#f0f0f0] to-[#dcdcdc] flex items-center justify-center">
          <svg class="w-12 h-12 text-[#c0c0c0]" fill="none" stroke="currentColor" stroke-width="0.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
        </div>
      ))}
    </div>
    <p class="text-[#898989] text-[13px] mt-3">Фотоотчёты объектов — добавим реальные фото работ.</p>
  </section>

  <!-- CTA-баннер -->
  <section class="bg-white px-4 sm:px-8 lg:px-[60px]" style="padding-bottom:60px;">
    <div class="relative bg-[#333333] rounded-[5px] overflow-hidden flex flex-col lg:flex-row items-center gap-6" style="padding:40px 50px;">
      <span class="absolute font-[Montserrat] font-black text-[#FFAE01]/10 leading-none select-none pointer-events-none" style="font-size:220px;right:0;top:-60px;">%</span>
      <div class="relative z-10 flex-1">
        <h2 class="font-[Montserrat] font-semibold text-white text-[22px] lg:text-[28px] leading-[1.3] mb-2">Закажите {service.title.toLowerCase()} сейчас</h2>
        <p class="text-[#E9E9E9] text-[15px]">Бесплатный замер и расчёт за 1 день. Гарантия лучшей цены.</p>
      </div>
      <div class="relative z-10 flex flex-col sm:flex-row gap-3 shrink-0">
        <a href="tel:88003339495" class="inline-flex items-center justify-center bg-[#FFAE01] hover:bg-[#e09d00] text-[#333333] font-semibold rounded-[5px] transition-colors" style="height:50px;padding:0 30px;">Позвонить</a>
        <a href="#zayavka" class="inline-flex items-center justify-center border border-white/40 hover:border-white text-white font-semibold rounded-[5px] transition-colors" style="height:50px;padding:0 30px;">Оставить заявку</a>
      </div>
    </div>
  </section>

  <!-- Стоимость -->
  <section class="bg-[#F5F5F5] px-4 sm:px-8 lg:px-[60px]" style="padding-top:60px;padding-bottom:60px;">
    <div class="flex items-end gap-[25px] mb-[30px]">
      <h2 class="font-[Montserrat] font-semibold text-[28px] lg:text-[42px] text-[#333333] leading-[1.22] flex-shrink-0">Стоимость</h2>
      <div class="flex-1 bg-[#E9E9E9]" style="height:1.5px;margin-bottom:14px;"></div>
    </div>
    <div class="bg-white rounded-[5px] flex flex-col lg:flex-row items-start lg:items-center justify-between gap-6" style="padding:40px;">
      <div class="max-w-[760px]">
        <p class="text-[#333333] text-[16px] leading-[1.5] mb-3">Стоимость рассчитывается индивидуально: зависит от площади, сложности и объёма работ. При заказе работ в&nbsp;полном объёме материалы — по&nbsp;оптовым ценам.</p>
        {service.priceFrom && <p class="text-[#333333] text-[18px]">Ориентир: <span class="font-bold text-[#FFAE01]">{service.priceFrom}</span></p>}
      </div>
      <a href="#zayavka" class="shrink-0 inline-flex items-center justify-center bg-[#FFAE01] hover:bg-[#e09d00] text-[#333333] font-semibold text-[18px] rounded-[5px] transition-colors" style="height:50px;padding:0 35px;">Узнать точную цену</a>
    </div>
  </section>

  <!-- Спектр услуг -->
  {others.length > 0 && (
    <section class="bg-white px-4 sm:px-8 lg:px-[60px]" style="padding-top:60px;padding-bottom:60px;">
      <div class="flex items-end gap-[25px] mb-[40px]">
        <h2 class="font-[Montserrat] font-semibold text-[28px] lg:text-[42px] text-[#333333] leading-[1.22] flex-shrink-0">Предоставляем весь спектр услуг</h2>
        <div class="flex-1 bg-[#E9E9E9]" style="height:1.5px;margin-bottom:14px;"></div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-[20px]">
        {others.map((o) => (
          <a href={`/uslugi/${o.slug}`} class="group flex flex-col justify-between gap-4 bg-white border border-[#E9E9E9] rounded-[5px] hover:border-[#FFAE01] transition-colors" style="padding:25px;min-height:140px;">
            <span class="font-[Montserrat] font-semibold text-[#333333] text-[18px] leading-snug">{o.title}</span>
            <span class="flex items-center justify-center w-[30px] h-[30px] border border-[#333333] rounded-[5px] group-hover:bg-[#333333] transition-colors self-end">
              <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" class="text-[#333333] group-hover:text-white"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
            </span>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- Отзывы -->
  <section class="bg-[#F5F5F5] px-4 sm:px-8 lg:px-[60px]" style="padding-top:60px;padding-bottom:60px;">
    <div class="flex items-end gap-[25px] mb-[40px]">
      <h2 class="font-[Montserrat] font-semibold text-[28px] lg:text-[42px] text-[#333333] leading-[1.22] flex-shrink-0" style="max-width:892px;">Посмотрите что говорят наши клиенты</h2>
      <div class="flex-1 bg-[#E9E9E9]" style="height:1.5px;margin-bottom:14px;"></div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-[20px]">
      {reviews.map((r) => (
        <div class="bg-white rounded-[5px] flex flex-col gap-[15px]" style="padding:25px;min-height:220px;">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-[12px]">
              <div class="w-[50px] h-[50px] rounded-full bg-[#E9E9E9] flex items-center justify-center text-[#898989] text-[20px] font-semibold flex-shrink-0">{r.name.charAt(0)}</div>
              <span class="text-[#333333] text-[16px] font-semibold">{r.name}</span>
            </div>
            <div class="flex items-center gap-[2px]">{[1,2,3,4,5].map(() => (<svg width="18" height="18" viewBox="0 0 20 20" fill="#FFAE01"><polygon points="10,1 12.5,7.5 19,7.5 14,12 16,18.5 10,15 4,18.5 6,12 1,7.5 7.5,7.5"/></svg>))}</div>
          </div>
          <p class="text-[#333333] text-[14px] leading-[1.4] flex-1">{r.text}</p>
          <a href="/otzyvy" class="text-[#333333] text-[13px] underline hover:text-[#FFAE01] transition-colors self-start">Читать весь отзыв</a>
        </div>
      ))}
    </div>
  </section>

  <!-- Специалисты -->
  <section class="bg-white px-4 sm:px-8 lg:px-[60px]" style="padding-top:60px;padding-bottom:60px;">
    <div class="flex flex-col gap-[40px]">
      <div class="flex flex-col gap-[15px]">
        <h2 class="font-[Montserrat] font-semibold text-[28px] lg:text-[42px] text-[#333333] leading-[1.22]">У&nbsp;нас работают только сертифицированные специалисты с&nbsp;опытом более 8&nbsp;лет</h2>
        <p class="text-[#333333] text-[18px] leading-[1.3]" style="max-width:714px;">Ежегодно проходят обучение от&nbsp;заводов-производителей и&nbsp;прошли аттестацию на&nbsp;знание продукции</p>
      </div>
      <div class="flex flex-col lg:flex-row gap-[20px]" style="min-height:400px;">
        <div class="relative rounded-[5px] overflow-hidden bg-[#E9E9E9]" style="flex:1042 1 0%;min-height:250px;">
          <img src="/images/home/s10-team-main.png" alt="Специалисты компании" class="absolute inset-0 w-full h-full object-cover object-top" />
        </div>
        <div class="flex flex-col gap-[20px]" style="flex:738 1 0%;">
          <div class="relative rounded-[5px] overflow-hidden bg-[#E9E9E9] flex-1" style="min-height:120px;"><img src="/images/home/s10-team-2.png" alt="Команда" class="absolute inset-0 w-full h-full object-cover" /></div>
          <div class="relative rounded-[5px] overflow-hidden bg-[#E9E9E9] flex-1" style="min-height:120px;"><img src="/images/home/s10-team-3.png" alt="Мастера" class="absolute inset-0 w-full h-full object-cover" /></div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA + Все услуги -->
  <section class="bg-white px-4 sm:px-8 lg:px-[60px]" style="padding-bottom:80px;">
    <div class="bg-[#333333] text-white rounded-[5px] p-8 flex flex-col sm:flex-row items-center gap-6">
      <div class="flex-1">
        <h2 class="font-[Montserrat] font-bold text-xl lg:text-2xl mb-2">Заказать «{service.title}»</h2>
        <p class="text-[#898989] text-sm">Бесплатный выезд замерщика. Расчёт за 1 день.</p>
      </div>
      <div class="flex flex-col sm:flex-row gap-3 shrink-0">
        <a href="tel:88003339495" class="inline-flex items-center justify-center bg-[#FFAE01] hover:bg-[#e09d00] text-black font-semibold px-6 py-3 rounded-[5px] transition-colors whitespace-nowrap">Позвонить</a>
        <a href="#zayavka" class="inline-flex items-center justify-center border border-[#464646] hover:border-white text-white font-semibold px-6 py-3 rounded-[5px] transition-colors whitespace-nowrap">Оставить заявку</a>
      </div>
    </div>
    <a href="/uslugi" class="inline-flex items-center gap-2 text-sm font-semibold text-[#FFAE01] hover:opacity-80 transition-opacity mt-6">
      <svg class="w-4 h-4 rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      Все услуги
    </a>
  </section>
</BaseLayout>
