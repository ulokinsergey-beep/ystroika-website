---
/**
 * Страница услуги — /uslugi/[slug]
 * Контент: src/content/services/ (из Bitrix IBLOCK 29)
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const services = await getCollection('services', ({ data }) => data.published !== false);
  return services.map((entry) => ({
    params: { slug: entry.id.replace(/\.mdx?$/, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const service = entry.data;
const serviceSlug = entry.id.replace(/\.mdx?$/, '');
const canonicalURL = `https://ystroika.ru/uslugi/${serviceSlug}/`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  'name': service.title,
  'description': service.shortDescription,
  'url': canonicalURL,
  'provider': {
    '@type': 'Organization',
    'name': 'У-Стройка',
    'url': 'https://ystroika.ru',
    'telephone': '+78003339495',
  },
  ...(service.priceFrom ? { 'offers': {
    '@type': 'Offer',
    'priceCurrency': 'RUB',
    'description': service.priceFrom,
  }} : {}),
};
---

<BaseLayout
  title={`${service.title} — У-Стройка`}
  description={`${service.title}. ${service.shortDescription?.slice(0, 150) ?? ''}. Москва и МО. Звоните: 8-800-333-94-95.`}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <div class="bg-[#f5f5f5] min-h-screen">

    <!-- Шапка -->
    <div class="bg-white border-b border-[#e5e5e5]">
      <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-[60px] py-6">
        <nav class="flex flex-wrap items-center gap-1 text-sm text-[#898989] mb-4">
          <a href="/" class="hover:text-[#FFAE01] transition-colors">Главная</a>
          <svg class="w-3.5 h-3.5 text-[#d0d0d0]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          <a href="/uslugi" class="hover:text-[#FFAE01] transition-colors">Услуги</a>
          <svg class="w-3.5 h-3.5 text-[#d0d0d0]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          <span class="text-slate-900 font-medium truncate max-w-xs">{service.title}</span>
        </nav>
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3">
          <h1 class="text-2xl lg:text-[32px] font-bold text-slate-900">{service.title}</h1>
          {service.priceFrom && (
            <span class="shrink-0 bg-[#FFAE01]/10 text-[#FFAE01] font-bold text-lg px-5 py-2 rounded-[5px] whitespace-nowrap">
              {service.priceFrom}
            </span>
          )}
        </div>
      </div>
    </div>

    <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-[60px] py-8">
      <div class="max-w-3xl">

        {service.shortDescription && (
          <p class="text-lg text-[#898989] mb-6 leading-relaxed">{service.shortDescription}</p>
        )}

        {entry.body && entry.body.trim() && (
          <div class="bg-white rounded-[10px] border border-[#e5e5e5] p-6 lg:p-8 prose prose-slate max-w-none mb-8">
            <Content />
          </div>
        )}

        <!-- CTA -->
        <div class="bg-[#333333] text-white rounded-[10px] p-8 flex flex-col sm:flex-row items-center gap-6 mb-8">
          <div class="flex-1">
            <h2 class="font-bold text-xl mb-2">Заказать {service.title.toLowerCase()}</h2>
            <p class="text-[#898989] text-sm">Бесплатный выезд замерщика. Расчёт за 1 день.</p>
          </div>
          <div class="flex flex-col sm:flex-row gap-3 shrink-0">
            <a
              href="tel:88003339495"
              class="inline-flex items-center justify-center gap-2 bg-[#FFAE01] hover:bg-[#e09d00] text-black font-semibold px-6 py-3 rounded-[5px] transition-colors whitespace-nowrap"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
              Позвонить
            </a>
            <a
              href="/raschet"
              class="inline-flex items-center justify-center gap-2 border border-[#464646] hover:border-white text-white font-semibold px-6 py-3 rounded-[5px] transition-colors whitespace-nowrap"
            >
              Получить расчёт
            </a>
          </div>
        </div>

        <a href="/uslugi" class="inline-flex items-center gap-2 text-sm font-semibold text-[#FFAE01] hover:opacity-80 transition-opacity">
          <svg class="w-4 h-4 rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
          Все услуги
        </a>

      </div>
    </div>
  </div>
</BaseLayout>
