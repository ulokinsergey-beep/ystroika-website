---
/**
 * Страница «Реквизиты» — /rekvizity
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Реквизиты компании — У-Стройка"
  description="Юридические реквизиты ООО «У-Стройка»: ИНН, ОГРН, расчётный счёт, юридический адрес. Москва."
>
  <div class="bg-[#f5f5f5] min-h-screen">

    <!-- Шапка -->
    <div class="bg-white border-b border-[#e5e5e5]">
      <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-[60px] py-6">
        <nav class="flex flex-wrap items-center gap-1 text-sm text-[#898989] mb-4">
          <a href="/" class="hover:text-[#FFAE01] transition-colors">Главная</a>
          <svg class="w-3.5 h-3.5 text-[#d0d0d0]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          <span class="text-slate-900 font-medium">Реквизиты</span>
        </nav>
        <h1 class="text-2xl lg:text-[32px] font-bold text-slate-900">Реквизиты</h1>
        <p class="mt-2 text-[#898989]">Юридические реквизиты компании для документооборота</p>
      </div>
    </div>

    <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-[60px] py-8">

      <div class="bg-white border border-[#e5e5e5] rounded-[10px] overflow-hidden mb-6">
        <table class="w-full text-sm">
          <tbody>
            {[
              ['Полное наименование', 'ООО «У-Стройка»'],
              ['Сокращённое наименование', 'У-Стройка'],
              ['ИНН', '7703457892'],
              ['КПП', '770301001'],
              ['ОГРН', '1177746587432'],
              ['Юридический адрес', 'г. Москва, ул. Примерная, д. 1'],
              ['Фактический адрес', 'г. Москва, ул. Примерная, д. 1'],
              ['Расчётный счёт', '40702810000000000000'],
              ['Банк', 'ПАО Сбербанк'],
              ['БИК', '044525225'],
              ['К/с', '30101810400000000225'],
              ['Телефон', '8-800-333-94-95 (бесплатно)'],
              ['Email', 'info@ystroika.ru'],
            ].map(([label, value], i) => (
              <tr class={i % 2 === 0 ? 'bg-white' : 'bg-[#fafafa]'}>
                <td class="px-6 py-3.5 text-[#898989] text-sm border-b border-[#f0f0f0] w-2/5">{label}</td>
                <td class="px-6 py-3.5 font-medium text-slate-900 text-sm border-b border-[#f0f0f0]">{value}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <p class="text-xs text-[#898989] mb-6">
        Реквизиты носят справочный характер. Для получения актуальных реквизитов на счёт или договор свяжитесь с менеджером.
      </p>

      <a
        href="/kontakty"
        class="inline-flex items-center gap-2 text-sm font-semibold text-[#FFAE01] hover:opacity-80 transition-opacity"
      >
        <svg class="w-4 h-4 rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
        Все контакты
      </a>

    </div>
  </div>
</BaseLayout>
