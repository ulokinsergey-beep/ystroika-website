---
const year = new Date().getFullYear();

// Figma footer menu: 6 columns (146:1252..1257)
const footerMenu = [
  {
    title: 'У-Стройка',
    links: [
      { href: '/o-kompanii', label: 'О компании' },
      { href: '/kontakty', label: 'Контакты' },
      { href: '/blog', label: 'Блог' },
      { href: '/novosti', label: 'Новости' },
      { href: '/proekty', label: 'Проекты' },
      { href: '/vakansii', label: 'Вакансии' },
      { href: '/brendy', label: 'Бренды' },
    ],
  },
  {
    title: 'Продукция',
    links: [
      { href: '/catalog/fasad', label: 'Фасад' },
      { href: '/catalog/krovlya', label: 'Кровля' },
      { href: '/catalog/profnastil', label: 'Профнастил' },
      { href: '/catalog/dobornye-elementy', label: 'Доборные элементы' },
      { href: '/catalog/zabory-ograzhdeniya', label: 'Заборы и ограждения' },
      { href: '/catalog/vodostochnye-sistemy', label: 'Водосточные системы' },
      { href: '/catalog/mansardnye-okna', label: 'Мансардные окна' },
      { href: '/catalog/drugoe', label: 'Другое' },
      { href: '/spetspredlozheniya', label: 'Спецпредложения' },
    ],
  },
  {
    title: 'Наши услуги',
    links: [
      { href: '/uslugi/raschyet-materialov-i-vyzov-zamershchika', label: 'Расчёт материалов и вызов замерщика' },
      { href: '/uslugi/podshiv-svesov-kryshi-doskoy', label: 'Подшив свесов крыши доской' },
      { href: '/uslugi/montazhnye-raboty-po-fasadu', label: 'Монтажные работы по фасаду' },
      { href: '/uslugi/montazh-krovelnogo-pokrytiya', label: 'Монтаж кровельного покрытия' },
      { href: '/uslugi/montazh-vodostochnoy-sistemy', label: 'Монтаж водосточной системы' },
      { href: '/uslugi/montazh-stropilnoy-sistemy', label: 'Монтаж стропильной системы' },
      { href: '/uslugi/besplatnaya-dostavka', label: 'Бесплатная доставка' },
    ],
  },
  {
    title: 'Наши сервисы',
    links: [
      { href: '/servisy/metallocherepitsa', label: 'Расчёт кровли из металлочерепицы' },
      { href: '/servisy/profnastil', label: 'Расчёт кровли из профнастила' },
      { href: '/servisy/faltsevaya-krovlya', label: 'Расчёт фальцевой кровли' },
      { href: '/servisy/vinilovyy-sayding', label: 'Расчёт винилового сайдинга' },
      { href: '/servisy/fasadnye-paneli', label: 'Расчёт фасадных панелей' },
      { href: '/servisy/gibkaya-cherepitsa', label: 'Калькулятор гибкой черепицы' },
      { href: '/servisy/vodostok', label: 'Расчёт водостока' },
    ],
  },
  {
    title: 'Покупателям',
    links: [
      { href: '/dostavka', label: 'Доставка' },
      { href: '/oplata', label: 'Оплата' },
      { href: '/garantii', label: 'Гарантии' },
      { href: '/vozvrat-obmen', label: 'Обмен / возврат' },
      { href: '/politika-konfidentsialnosti', label: 'Политика конфиденциальности' },
      { href: '/spets-usloviya', label: 'Спец условия для строителей' },
    ],
  },
  {
    title: 'Информация',
    links: [
      { href: '/dokumentatsiya', label: 'Документация' },
      { href: '/otzyvy', label: 'Отзывы' },
      { href: '/sertifikaty', label: 'Сертификаты' },
      { href: '/voprosy-otvety', label: 'Вопросы и ответы' },
      { href: '/karta-sayta', label: 'Карта сайта' },
    ],
  },
];
---

<footer class="bg-black text-white">

  <!-- ===== NEWSLETTER (Figma 146:1241: bg=#464646, borderRadius=10px) ===== -->
  <div class="px-4 sm:px-8 lg:px-[60px] pt-[60px] pb-[10px]">
    <div class="bg-[#464646] rounded-[10px] p-8 lg:p-12 flex flex-col lg:flex-row items-start lg:items-center gap-8">
      <div class="flex-1">
        <!-- Figma: "Узнай первым о скидках и акциях" white, style_U8977V -->
        <h2 class="font-[Montserrat] font-semibold text-[22px] lg:text-[26px] text-white leading-[1.3]">
          Узнай первым о скидках и акциях
        </h2>
        <!-- Figma: body text white, style_RCH5MP -->
        <p class="mt-3 text-white text-[13px] leading-[1.6] max-w-[580px] opacity-80">
          2&nbsp;раза в&nbsp;месяц отправляем актуальные остатки и&nbsp;цены на&nbsp;продукцию «У-Стройка».
          Пишем экспертные статьи и&nbsp;делимся ими. Регулярность рассылки — не&nbsp;более
          1&nbsp;письма в&nbsp;неделю. В&nbsp;любой момент вы&nbsp;сможете отписаться.
          Мы не&nbsp;занимаемся спамом — всё строго по&nbsp;делу!
        </p>
      </div>
      <!-- Figma: button fills=Orange, borderRadius=5px, text "Подписаться" fills=Black -->
      <form class="flex flex-col sm:flex-row gap-3 w-full lg:w-auto shrink-0">
        <input
          type="email"
          placeholder="Ваш email"
          class="w-full lg:w-[280px] h-[50px] px-4 bg-[#333333] rounded-[5px] text-white text-[15px] placeholder:text-[#898989] border-0 focus:outline-none focus:ring-2 focus:ring-[#FFAE01]"
        />
        <button
          type="submit"
          class="h-[50px] px-6 bg-[#FFAE01] hover:bg-[#e09d00] text-[#333333] font-semibold text-[15px] rounded-[5px] transition-colors whitespace-nowrap"
        >
          Подписаться
        </button>
      </form>
    </div>
  </div>

  <!-- ===== FOOTER 1 UPPER (Figma 146:1250: logo, contacts, location, links, social) ===== -->
  <div class="px-4 sm:px-8 lg:px-[60px] py-[40px] border-b border-[#333333]">
    <div class="flex flex-wrap gap-x-12 gap-y-6">
      <!-- Logo: white version on black bg -->
      <div class="shrink-0 flex items-center">
        <a href="/" aria-label="У-Стройка — на главную">
          <img src="/images/logo-white.svg" width="153" height="40" alt="У-Стройка" />
        </a>
      </div>

      <!-- Contacts: Figma 146:1248 -->
      <div class="flex flex-col gap-1">
        <!-- Figma: +7 800 333 94 95 white, style_8440Z9 -->
        <a href="tel:+78003339495" class="text-white font-semibold text-[16px] hover:text-[#FFAE01] transition-colors">
          +7 800 333 94 95
        </a>
        <!-- Figma: office@y-stroika.ru white, style_M20Y6B -->
        <a href="mailto:office@y-stroika.ru" class="text-[#898989] text-[14px] hover:text-white transition-colors">
          office@y-stroika.ru
        </a>
      </div>

      <!-- Location: Figma 146:1249 -->
      <div class="flex flex-col gap-1">
        <!-- Figma fills=BG gray (#F5F5F5 on black = #898989 muted) -->
        <p class="text-[#898989] text-[14px]">ул.&nbsp;Советская 1а</p>
        <p class="text-[#898989] text-[14px]">пн-вс с&nbsp;9&nbsp;до&nbsp;18</p>
      </div>

      <!-- Links: Figma 146:1228 -->
      <div class="flex flex-col gap-1">
        <a href="/otzyvy" class="text-white text-[14px] hover:text-[#FFAE01] transition-colors">
          Оставить комментарий
        </a>
        <!-- Figma: "Заказать звонок" fills=Orange -->
        <a href="/zakazat-zvonok" class="text-[#FFAE01] text-[14px] hover:opacity-80 transition-opacity">
          Заказать звонок
        </a>
        <!-- Figma: "Схема проезда" fills=BG gray -->
        <a href="/kontakty#map" class="text-[#898989] text-[14px] hover:text-white transition-colors flex items-center gap-1">
          Схема проезда
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>
  </div>

  <!-- ===== MENU 6 COLUMNS (Figma 146:1258: menu) ===== -->
  <div class="px-4 sm:px-8 lg:px-[60px] py-[50px] border-b border-[#333333]">
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-x-6 gap-y-8">
      {footerMenu.map(col => (
        <div>
          <!-- Figma: column heading white, style_HTZJ3U -->
          <h3 class="text-white font-semibold text-[14px] mb-4">{col.title}</h3>
          <ul class="space-y-[10px]">
            {col.links.map(link => (
              <li>
                <!-- Figma: links fills=Gray -->
                <a href={link.href} class="text-[#898989] text-[13px] hover:text-white transition-colors leading-[1.4] block">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>

  <!-- ===== FOOTER 2 BOTTOM BAR (Figma 146:1292) ===== -->
  <div class="px-4 sm:px-8 lg:px-[60px] py-[20px]">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <!-- Реквизиты: Figma 146:1279 — ИП Улокин С. Ю. + ОГРНИП + Реквизиты -->
      <div class="flex flex-wrap items-center gap-x-6 gap-y-1 text-[#898989] text-[13px]">
        <span>© {year}&nbsp;У-Стройка</span>
        <span>ИП Улокин С. Ю.</span>
        <span>ОГРНИП: 317505300034130</span>
        <a href="/rekvizity" class="hover:text-white transition-colors">Реквизиты</a>
      </div>

      <!-- Buttons: Figma 146:1281 (Скачать каталог и прайс-лист + Калькулятор расчёта) -->
      <div class="flex items-center gap-6">
        <!-- Figma: "Скачать каталог и прайс-лист" fills=Orange -->
        <a href="/prajs-list" class="text-[#FFAE01] text-[13px] hover:opacity-80 transition-opacity flex items-center gap-2">
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 10v6m0 0l-3-3m3 3l3-3M3 17V7a2 2 0 012-2h6l2 2h6a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2z"/>
          </svg>
          Скачать каталог и&nbsp;прайс-лист
        </a>
        <!-- Figma: "Калькулятор расчёта" fills=White -->
        <a href="/servisy" class="text-white text-[13px] hover:opacity-80 transition-opacity flex items-center gap-2">
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>
          </svg>
          Калькулятор расчёта
        </a>
      </div>
    </div>
  </div>

</footer>
