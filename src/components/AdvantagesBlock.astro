---
/**
 * AdvantagesBlock — блок «неоспоримые преимущества» (Figma экран 4 / карточка товара).
 * 6 карточек-преимуществ с иконками + CTA. Переиспользуемый.
 */
const advantages = [
  { title: 'Бесплатная доставка',             text: 'Доставим ваш заказ бесплатно по Москве и московской области',                                  icon: '/images/advantages/dostavka.svg' },
  { title: 'Лучшая цена!',                    text: 'Гарантия лучшей цены! Нашли дешевле — вернём разницу!',                                        icon: '/images/advantages/tsena.svg' },
  { title: 'Клиент всегда прав!',             text: 'Решим любые вопросы оперативно — менеджер поддержки свяжется с вами в течение 30 минут',         icon: '/images/advantages/klient-prav.svg' },
  { title: 'Возврат за наш счёт',             text: 'Приём возврата при браке производителя. Вернём деньги или заменим товар ненадлежащего качества (царапины, сколы)', icon: '/images/advantages/vozvrat.svg' },
  { title: 'Оперативность',                   text: 'Менеджер поддержки на связи до позднего вечера — свяжемся в течение 30 минут',                  icon: '/images/advantages/operativnost.svg' },
  { title: 'Качество, проверенное временем!', text: 'Уже 9 лет работаем — поставляем качественные товары для строительства и ремонта крыши',          icon: '/images/advantages/kachestvo.svg' },
];
---

<section class="py-[40px]">
  <div class="flex flex-col gap-[40px]">
    <!-- Заголовок -->
    <div class="flex items-end gap-[25px]">
      <h2 class="font-[Montserrat] font-semibold text-[22px] lg:text-[32px] text-[#333333] leading-[1.3]" style="max-width:1164px;">
        У-Стройка&nbsp;— это&nbsp;неоспоримые преимущества в&nbsp;работе с&nbsp;нами и&nbsp;только качественные материалы
      </h2>
      <div class="flex-1 bg-[#E9E9E9] hidden lg:block" style="height:1.5px;margin-bottom:14px;"></div>
    </div>

    <div class="flex flex-col items-center gap-[40px]">
      <!-- 6 карточек -->
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-[20px] w-full">
        {advantages.map((adv) => (
          <div class="bg-[#F5F5F5] rounded-[5px] flex flex-col items-center text-center" style="padding:30px 30px 35px;min-height:280px;">
            <img src={adv.icon} alt="" class="pointer-events-none mb-[15px]" style="width:111px;height:88px;margin-top:-15px;" />
            <div class="flex items-center gap-[10px] mb-[8px]">
              <span class="text-[#333333] text-[16px] font-medium leading-[1.3]">{adv.title}</span>
              <span class="inline-flex items-center justify-center bg-[#333333] text-white text-[13px] font-medium rounded-full flex-shrink-0" style="width:15px;height:15px;line-height:1;">i</span>
            </div>
            <p class="text-[#333333] text-[16px] leading-[1.3]" style="max-width:200px;">{adv.text}</p>
          </div>
        ))}
      </div>

      <!-- CTA -->
      <div class="flex flex-col items-center gap-[20px]" style="max-width:605px;">
        <p class="text-[#898989] text-[16px] leading-[1.21] text-center">
          Наш&nbsp;менеджер всегда на&nbsp;связи в&nbsp;мессенджерах. Даже&nbsp;до&nbsp;позднего вечера, даже&nbsp;после продажи. Оставьте заявку — сделаем расчёт за&nbsp;20&nbsp;минут!
        </p>
        <a href="/raschet" class="inline-flex items-center justify-center bg-[#FFAE01] hover:bg-[#e09d00] text-[#333333] font-semibold text-[18px] rounded-[5px] transition-colors" style="width:482px;max-width:100%;height:50px;">
          Рассчитать
        </a>
      </div>
    </div>
  </div>
</section>
