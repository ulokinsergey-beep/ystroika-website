---
/**
 * Карточка товара в листинге подкатегории.
 * Цена подтягивается клиентским JS через API endpoint /api/price/[kod]
 */
export interface Props {
  kod: string;
  name: string;
  artikul?: string;
  unit: string;
  brand?: string;
  categorySlug: string;
  subcategorySlug: string;
}

const { kod, name, artikul, unit, brand, categorySlug, subcategorySlug } = Astro.props;
const productUrl = `/catalog/${categorySlug}/${subcategorySlug}/${encodeURIComponent(kod)}/`;
---

<a
  href={productUrl}
  class="group flex flex-col bg-white border border-slate-200 rounded-xl p-4 hover:border-brand hover:shadow-md transition-all duration-200"
  data-product-kod={kod}
>
  <!-- Изображение-заглушка -->
  <div class="w-full aspect-square bg-slate-100 rounded-lg mb-3 flex items-center justify-center overflow-hidden">
    <svg class="w-12 h-12 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
    </svg>
  </div>

  <!-- Бренд -->
  {brand && (
    <span class="text-xs text-slate-400 font-medium uppercase tracking-wide mb-1">{brand}</span>
  )}

  <!-- Название -->
  <h3 class="text-sm font-medium text-slate-800 group-hover:text-brand transition-colors leading-snug line-clamp-3 flex-1">
    {name}
  </h3>

  <!-- Артикул -->
  {artikul && (
    <p class="text-xs text-slate-400 mt-1.5">Арт. {artikul}</p>
  )}

  <!-- Цена (подгружается JS) -->
  <div class="mt-3 pt-3 border-t border-slate-100">
    <div class="flex items-end justify-between gap-2">
      <div>
        <p
          class="text-lg font-bold text-slate-900 price-value"
          data-kod={kod}
        >
          <span class="inline-block w-16 h-5 bg-slate-100 rounded animate-pulse"></span>
        </p>
        <p class="text-xs text-slate-400">за {unit}</p>
      </div>
      <span class="shrink-0 text-xs font-semibold text-brand bg-brand/10 px-2.5 py-1 rounded-lg group-hover:bg-brand group-hover:text-white transition-colors">
        В корзину
      </span>
    </div>
  </div>
</a>
