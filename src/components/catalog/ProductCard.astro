---
/**
 * Карточка товара в листинге — по Figma (filters-and-cards zoom).
 *
 * Структура:
 *  - Фото (placeholder пока нет реальных фото от API)
 *  - ⭐ 5.0 | Наличие уточняется (единый статус resolveAvailability — реального стока для каталога нет)
 *  - Название товара (2 строки)
 *  - Кол-во счётчик
 *  - Старая цена / Текущая цена
 *  - Кнопки: избранное + корзина
 *
 * Цена подгружается клиентским JS там, где нет серверной цены из снимка.
 * Наличие — статично через resolveAvailability(): данных о складе для каталога нет → «Наличие уточняется».
 */
import { resolveAvailability } from '../../lib/availability.mjs';

export interface Props {
  kod: string;
  name: string;
  artikul?: string;
  unit: string;
  brand?: string;
  priceGroup?: string;
  categorySlug: string;
  subcategorySlug: string;
  /** Серверные данные из снимка (Döcke): рендерятся сразу, клиентский JS их не перетирает */
  image?: string | null;
  price?: number | null;        // null = «по запросу»; undefined = цена грузится клиентским JS
  serverPriced?: boolean;
  /** Статус наличия из данных (если появится). Для каталога данных о складе нет → «Наличие уточняется». */
  stock?: string | number | boolean | null;
}

const { kod, name, artikul, unit, brand, priceGroup, categorySlug, subcategorySlug,
        image = null, price = undefined, serverPriced = false, stock = undefined } = Astro.props;
// Единый статус наличия. Для каталога реального стока нет → «Наличие уточняется».
const avail = resolveAvailability(stock);
const productUrl = `/catalog/${categorySlug}/${subcategorySlug}/${encodeURIComponent(kod)}/`;
const hasServerPrice = serverPriced && typeof price === 'number' && price > 0;
const fmtPrice = hasServerPrice ? price!.toLocaleString('ru-RU') + ' ₽' : '';

const displayBrand = brand || (() => {
  if (!priceGroup) return '';
  const parts = priceGroup.split('/').map(s => s.trim());
  return parts.length >= 3 ? parts[2] : (parts[parts.length - 1] || '');
})();
---

<div
  class="group flex flex-col bg-white border border-[#E9E9E9] rounded-[5px] overflow-hidden hover:shadow-[0_4px_20px_rgba(0,0,0,0.1)] transition-shadow duration-200"
  data-product-kod={kod}
  data-server-priced={serverPriced ? '1' : undefined}
  data-price-value={hasServerPrice ? String(price) : undefined}
>
  <!-- ── Фото ───────────────────────────────────────────── -->
  <a href={productUrl} class="relative block bg-[#F5F5F5] overflow-hidden" style="aspect-ratio:4/3;">

    <!-- "Скидка" бейдж — показывается JS если есть скидка -->
    <span class="discount-badge hidden absolute top-0 left-0 bg-[#E53E3E] text-white text-[11px] font-semibold px-[10px] py-[5px] z-10">
      Скидка
    </span>

    {image ? (
      <img class="product-img absolute inset-0 w-full h-full object-contain p-2" src={image} alt={name} loading="lazy" />
    ) : (
      <>
        <!-- Placeholder фото товара -->
        <div class="product-img-placeholder absolute inset-0 flex items-center justify-center">
          <svg class="w-16 h-16 text-[#D0D0D0]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1"
              d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
          </svg>
        </div>

        <!-- Реальное фото — вставляется JS если есть imageUrl -->
        <img class="product-img hidden absolute inset-0 w-full h-full object-contain p-2" src="" alt={name} loading="lazy" />
      </>
    )}
  </a>

  <!-- ── Контент ─────────────────────────────────────────── -->
  <div class="flex flex-col flex-1 p-[15px]">

    <!-- Рейтинг + наличие -->
    <div class="flex items-center justify-between mb-[10px]">
      <!-- ⭐ 5.0 -->
      <span class="inline-flex items-center gap-[4px] bg-[#333333] text-white text-[11px] font-semibold px-[7px] py-[3px] rounded-[3px]">
        <svg class="w-[11px] h-[11px] fill-[#FFAE01]" viewBox="0 0 20 20">
          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
        </svg>
        5.0
      </span>

      <!-- Наличие: единая логика resolveAvailability(). Для каталога данных о складе нет → «Наличие уточняется». -->
      <span class:list={["stock-badge inline-flex items-center gap-[4px] text-[11px] font-medium", avail.state === 'in' ? 'text-[#38A169]' : 'text-[#898989]']}>
        {avail.state === 'in' ? (
          <svg class="w-[12px] h-[12px]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
          </svg>
        ) : (
          <svg class="w-[12px] h-[12px]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        )}
        {avail.label}
      </span>
    </div>

    <!-- Название -->
    <a href={productUrl} class="block mb-[12px] flex-1">
      <h3 class="text-[13px] text-[#333333] font-medium leading-[1.4] line-clamp-2 group-hover:text-[#FFAE01] transition-colors">
        {name}
      </h3>
    </a>

    <!-- Кол-во счётчик -->
    <div class="flex items-center gap-[8px] mb-[12px]">
      <span class="text-[12px] text-[#898989] shrink-0">Кол-во</span>
      <div class="flex items-center border border-[#E9E9E9] rounded-[3px] overflow-hidden ml-auto">
        <button type="button"
          class="qty-minus w-[28px] h-[28px] flex items-center justify-center text-[#333333] text-[16px] leading-none hover:bg-[#F5F5F5] transition-colors border-r border-[#E9E9E9]"
          onclick="event.preventDefault(); const i=this.nextElementSibling; i.value=Math.max(1,+i.value-1)">
          −
        </button>
        <input type="number" value="1" min="1"
          class="qty-input w-[36px] h-[28px] text-center text-[12px] text-[#333333] font-medium border-none outline-none"
          onclick="event.preventDefault()" />
        <button type="button"
          class="qty-plus w-[28px] h-[28px] flex items-center justify-center text-[#333333] text-[16px] leading-none hover:bg-[#F5F5F5] transition-colors border-l border-[#E9E9E9]"
          onclick="event.preventDefault(); const i=this.previousElementSibling; i.value=+i.value+1">
          +
        </button>
      </div>
    </div>

    <!-- Цены + кнопки -->
    <div class="flex items-end justify-between gap-[8px]">

      <!-- Цены -->
      <div>
        {serverPriced ? (
          hasServerPrice ? (
            <div class="price-loaded">
              <div class="flex items-baseline gap-[3px]">
                <p class="price-display text-[18px] font-bold text-[#333333] leading-none">{fmtPrice}</p>
                <p class="text-[11px] text-[#898989] leading-none">/{unit}</p>
              </div>
            </div>
          ) : (
            <p class="no-price text-[12px] text-[#898989] italic">Цена по запросу</p>
          )
        ) : (
          <>
            <!-- Скелетон (пока JS не загрузил) -->
            <div class="price-skeleton">
              <div class="h-[12px] w-[60px] bg-[#F0F0F0] rounded animate-pulse mb-[4px]"></div>
              <div class="h-[18px] w-[90px] bg-[#F0F0F0] rounded animate-pulse"></div>
            </div>

            <!-- Цена (заполняется JS) -->
            <div class="price-loaded hidden">
              <p class="original-price hidden text-[11px] text-[#898989] line-through leading-none mb-[3px]"></p>
              <div class="flex items-baseline gap-[3px]">
                <p class="price-display text-[18px] font-bold text-[#333333] leading-none"></p>
                <p class="text-[11px] text-[#898989] leading-none">/{unit}</p>
              </div>
            </div>

            <!-- Нет цены -->
            <p class="no-price hidden text-[12px] text-[#898989] italic">Цена по запросу</p>
          </>
        )}
      </div>

      <!-- Кнопки: избранное + корзина -->
      <div class="flex items-center gap-[6px] shrink-0">
        <button
          type="button"
          aria-label="В избранное"
          onclick="event.preventDefault()"
          class="w-[36px] h-[36px] rounded-full border border-[#333333] bg-white flex items-center justify-center hover:bg-[#333333] hover:text-white transition-colors text-[#333333]">
          <svg class="w-[16px] h-[16px]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
              d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
          </svg>
        </button>
        <button
          type="button"
          aria-label="В корзину"
          data-add-cart data-kod={kod} data-name={name} data-url={productUrl} data-unit={unit}
          class="w-[36px] h-[36px] rounded-full bg-[#333333] flex items-center justify-center hover:bg-[#464646] transition-colors text-white">
          <svg class="w-[16px] h-[16px]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
              d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/>
          </svg>
        </button>
      </div>
    </div>

  </div>
</div>
