---
/**
 * Карточка товара в листинге подкатегории.
 *
 * Цена и наличие подгружаются клиентским JS через /api/catalog/prices и /api/catalog/stock.
 * JS заполняет: .price-display, .original-price, .discount-badge, .stock-badge
 */
export interface Props {
  kod: string;
  name: string;
  artikul?: string;
  unit: string;
  brand?: string;
  priceGroup?: string;
  categorySlug: string;
  subcategorySlug: string;
}

const { kod, name, artikul, unit, brand, priceGroup, categorySlug, subcategorySlug } = Astro.props;
const productUrl = `/catalog/${categorySlug}/${subcategorySlug}/${encodeURIComponent(kod)}/`;

// Извлечь бренд из priceGroup если brand пустой
// priceGroup: "Кров.Мат./МЧ/GrandLine/Kvinta Uno PREMIUM" → parts[2] = "GrandLine"
const displayBrand = brand || (() => {
  if (!priceGroup) return '';
  const parts = priceGroup.split('/').map(s => s.trim());
  return parts.length >= 3 ? parts[2] : (parts[parts.length - 1] || '');
})();
---

<a
  href={productUrl}
  class="group flex flex-col bg-white border border-slate-200 rounded-xl overflow-hidden hover:border-brand hover:shadow-md transition-all duration-200"
  data-product-kod={kod}
>
  <!-- Изображение + бейджи -->
  <div class="relative w-full aspect-square bg-gradient-to-br from-slate-50 to-slate-100 flex items-center justify-center flex-shrink-0">

    <!-- Бейдж "Акция" — скрыт, показывается JS если есть скидка -->
    <span
      class="discount-badge absolute top-2 left-2 hidden bg-red-500 text-white text-[10px] font-bold px-1.5 py-0.5 rounded tracking-wide"
    >
      АКЦИЯ
    </span>

    <!-- Бейдж наличия — скрыт, показывается JS -->
    <span
      class="stock-badge absolute top-2 right-2 hidden text-[10px] font-semibold px-1.5 py-0.5 rounded-md"
    ></span>

    <!-- Иконка-заглушка (нет фото от КА) -->
    <svg class="w-14 h-14 text-slate-200 group-hover:text-slate-300 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
    </svg>
  </div>

  <!-- Контент -->
  <div class="flex flex-col flex-1 p-3">

    <!-- Бренд -->
    {displayBrand && (
      <span class="text-[10px] font-semibold text-brand uppercase tracking-wider mb-1 truncate" title={displayBrand}>
        {displayBrand}
      </span>
    )}

    <!-- Название — clamp 3 строки -->
    <h3 class="text-xs font-medium text-slate-800 group-hover:text-brand transition-colors leading-snug line-clamp-3 flex-1">
      {name}
    </h3>

    <!-- Артикул -->
    {artikul && (
      <p class="text-[10px] text-slate-400 mt-1.5 truncate" title={`Арт. ${artikul}`}>
        Арт.&nbsp;{artikul}
      </p>
    )}

    <!-- Блок цены -->
    <div class="mt-2 pt-2 border-t border-slate-100">

      <!-- Скелетон (пока JS не загрузил цену) -->
      <div class="price-skeleton">
        <div class="h-5 w-20 bg-slate-100 rounded-md animate-pulse mb-1"></div>
        <div class="h-3 w-10 bg-slate-100 rounded animate-pulse"></div>
      </div>

      <!-- Цена (заполняется JS, изначально скрыта) -->
      <div class="price-loaded hidden">
        <!-- Зачёркнутая старая цена (JS показывает только при скидке) -->
        <p class="original-price hidden text-[11px] text-slate-400 line-through leading-none mb-0.5"></p>
        <!-- Актуальная цена -->
        <div class="flex items-baseline gap-1">
          <p class="price-display text-base font-bold text-slate-900 leading-none"></p>
          <p class="text-[10px] text-slate-400 leading-none">/ {unit}</p>
        </div>
      </div>

      <!-- "Цена по запросу" (показывается JS если нет данных) -->
      <p class="no-price hidden text-xs text-slate-400 italic">Цена по запросу</p>

      <!-- Кнопка -->
      <div class="mt-2.5">
        <span class="flex items-center justify-center gap-1 w-full text-[11px] font-semibold text-brand bg-brand/5 group-hover:bg-brand group-hover:text-white px-2 py-1.5 rounded-lg transition-colors">
          Подробнее
          <svg class="w-3 h-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/>
          </svg>
        </span>
      </div>
    </div>

  </div>
</a>
