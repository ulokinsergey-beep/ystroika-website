---
interface Props {
  slug: string;
  title: string;
  description: string;
  icon: string;
  subcategoriesCount?: number;
}

const { slug, title, description, icon, subcategoriesCount = 0 } = Astro.props;

// SVG-иконки для каждой категории (вместо emoji)
const iconMap: Record<string, string> = {
  krovlya: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>`,
  fasad: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="3" y1="15" x2="21" y2="15"/><line x1="9" y1="9" x2="9" y2="21"/><line x1="15" y1="9" x2="15" y2="21"/></svg>`,
  vodostok: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v8M12 10c-2.5 0-4 1.5-4 3s1.5 3 4 3 4-1.5 4-3"/><path d="M8 16v2a4 4 0 008 0v-2"/></svg>`,
  ograzhdeniya: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="4" height="10" rx="1"/><rect x="10" y="7" width="4" height="10" rx="1"/><rect x="18" y="7" width="4" height="10" rx="1"/><line x1="6" y1="10" x2="10" y2="10"/><line x1="14" y1="10" x2="18" y2="10"/><line x1="6" y1="14" x2="10" y2="14"/><line x1="14" y1="14" x2="18" y2="14"/></svg>`,
  komplektuyushchie: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z"/></svg>`,
  blagoustrojstvo: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22V12M12 12C12 12 7 9 4 5c3 0 5 1 8 7z"/><path d="M12 12c0 0 5-3 8-7-3 0-5 1-8 7z"/></svg>`,
  uteplenie: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a10 10 0 100 20 10 10 0 000-20z"/><path d="M12 8v8M8 12h8"/></svg>`,
  ventilyatsiya: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 12c2.5-2.5 2.5-6.5 0-9s-6.5-2.5-9 0"/><path d="M12 12c2.5 2.5 6.5 2.5 9 0s2.5-6.5 0-9"/><path d="M12 12c-2.5 2.5-2.5 6.5 0 9s6.5 2.5 9 0"/><path d="M12 12c-2.5-2.5-6.5-2.5-9 0s-2.5 6.5 0 9"/><circle cx="12" cy="12" r="2"/></svg>`,
};

const svgIcon = iconMap[slug] ?? `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/></svg>`;
---

<a
  href={`/catalog/${slug}`}
  class="group flex flex-col bg-white border border-slate-200 rounded-xl overflow-hidden hover:border-brand hover:shadow-lg transition-all duration-200"
>
  <!-- Цветная шапка с иконкой -->
  <div class="bg-slate-50 group-hover:bg-brand/5 px-5 pt-5 pb-4 transition-colors">
    <div class="w-12 h-12 bg-white border border-slate-200 group-hover:border-brand/30 rounded-xl flex items-center justify-center text-slate-600 group-hover:text-brand transition-colors shadow-sm">
      <div class="w-6 h-6" set:html={svgIcon} />
    </div>
  </div>

  <!-- Контент -->
  <div class="px-5 pb-5 flex flex-col flex-1">
    <h3 class="text-base font-semibold text-slate-900 group-hover:text-brand transition-colors mt-1">
      {title}
    </h3>
    <p class="mt-1 text-sm text-slate-500 leading-relaxed flex-1 line-clamp-2">
      {description}
    </p>

    <div class="mt-4 flex items-center justify-between">
      {subcategoriesCount > 0 ? (
        <span class="text-xs text-slate-400">
          {subcategoriesCount} {
            subcategoriesCount === 1 ? 'подраздел' :
            subcategoriesCount < 5 ? 'подраздела' : 'подразделов'
          }
        </span>
      ) : (
        <span class="text-xs text-slate-400">Скоро</span>
      )}
      <div class="flex items-center text-sm font-medium text-brand gap-1 group-hover:gap-2 transition-all">
        Открыть
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </div>
    </div>
  </div>
</a>
