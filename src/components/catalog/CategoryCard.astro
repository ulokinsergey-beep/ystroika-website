---
interface Props {
  slug: string;
  title: string;
  description: string;
  icon: string;
  subcategoriesCount?: number;
}

const { slug, title, description, icon, subcategoriesCount = 0 } = Astro.props;
---

<a
  href={`/catalog/${slug}`}
  class="group flex flex-col bg-white border border-slate-200 rounded-xl p-6 hover:border-orange-400 hover:shadow-md transition-all duration-200"
>
  <div class="text-3xl mb-3">{icon}</div>
  <h3 class="text-lg font-semibold text-slate-900 group-hover:text-orange-500 transition-colors">
    {title}
  </h3>
  <p class="mt-1.5 text-sm text-slate-500 leading-relaxed flex-1">
    {description}
  </p>
  {subcategoriesCount > 0 && (
    <p class="mt-3 text-xs text-slate-400">
      {subcategoriesCount} {subcategoriesCount === 1 ? 'подраздел' : 'подраздела'}
    </p>
  )}
  <div class="mt-4 flex items-center text-sm font-medium text-orange-500 group-hover:gap-2 gap-1 transition-all">
    Смотреть каталог
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
    </svg>
  </div>
</a>
