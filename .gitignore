# KrovAlians sync temp files
data/products/*.tmp

# Большие файлы каталога — не коммитить в Git
# Генерируются через: node scripts/process-catalog.mjs
src/data/kroval-catalog-full.json
# Данные каталога по подкатегориям (~91 МБ) — хранятся локально
# При деплое генерируются из API или копируются на сервер
src/data/catalog/
tmp-figma-audit/

# Large Figma PDF exports — exceed GitHub 100MB limit (хранить локально)
docs/figma-screens/*.pdf
tmp-uslugi-shots/

# Bitrix backup restore working dir (large SQL dump + extracted tar) — local only
tmp-bitrix/

# Catalog sync — секреты и генерируемые снимки
catalog-sync/.env
catalog-sync/snapshots/
.env

# Картинки поставщиков — генерируются sync на сервере
public/images/catalog/docke/

# Снимки каталога/цен (регенерируются scripts/catalog/generate-snapshot.mjs)
src/data/snapshots/
src/data/catalog-images-manifest.json

# КА нормализованный кэш (регенерируется kroval-fetch-cache.mjs)
src/data/catalog/kroval-normalized-cache.json
